<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- The gateway's server side in one program: "relay" (runs at home, reachable on 443) and "connector"
       (runs in each remote network, connects out only), plus the admin commands. Shipped as the
       ghcr.io/langeboi/remoteman-gateway image (deploy/gateway). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>remoteman-gateway</AssemblyName>
    <RootNamespace>RemoteMan.Gateway.Server</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- The admin console's page, script and styles, served from the program itself (no wwwroot to ship). -->
    <EmbeddedResource Include="Admin/web/*" LogicalName="web/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Hosted workspaces: the relay creates and backs up databases on a PostgreSQL server of its own. The table
         definitions are the app's own (one file, linked, so the relay doesn't pull in the app's data layer). -->
    <PackageReference Include="Npgsql" Version="10.0.4" />
    <Compile Include="..\RemoteMan.Data\PostgresSchema.cs" Link="Hosted\PostgresSchema.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RemoteMan.Gateway\RemoteMan.Gateway.csproj" />
  </ItemGroup>
</Project>
