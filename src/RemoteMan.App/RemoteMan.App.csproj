<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>RemoteMan.App</RootNamespace>
    <AssemblyName>RemoteMan</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TieredPGO>true</TieredPGO>
    <!-- Faster cold start: ReadyToRun on publish. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <!-- WPF app that also hosts a WinForms control: keep WinForms out of the global usings. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RemoteMan.Core\RemoteMan.Core.csproj" />
    <ProjectReference Include="..\RemoteMan.Data\RemoteMan.Data.csproj" />
    <ProjectReference Include="..\RemoteMan.Protocols\RemoteMan.Protocols.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\terminal\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- xterm.js (MIT) for the SSH terminal, fetched once into Assets/terminal/vendor. -->
  <PropertyGroup>
    <XtermVendorDir>$(MSBuildProjectDirectory)\Assets\terminal\vendor</XtermVendorDir>
  </PropertyGroup>
  <Target Name="FetchXterm" BeforeTargets="BeforeBuild" Condition="!Exists('$(XtermVendorDir)\xterm.js')">
    <DownloadFile SourceUrl="https://cdn.jsdelivr.net/npm/@xterm/xterm@5.5.0/lib/xterm.js" DestinationFolder="$(XtermVendorDir)" />
    <DownloadFile SourceUrl="https://cdn.jsdelivr.net/npm/@xterm/xterm@5.5.0/css/xterm.css" DestinationFolder="$(XtermVendorDir)" />
    <DownloadFile SourceUrl="https://cdn.jsdelivr.net/npm/@xterm/addon-fit@0.10.0/lib/addon-fit.js" DestinationFolder="$(XtermVendorDir)" />
    <ItemGroup>
      <Content Include="Assets\terminal\vendor\*" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
