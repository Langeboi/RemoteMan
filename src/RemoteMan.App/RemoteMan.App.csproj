<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>RemoteMan.App</RootNamespace>
    <AssemblyName>RemoteMan</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TieredPGO>true</TieredPGO>
    <!-- Faster cold start: ReadyToRun on publish. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Custom Main so Velopack can run before WPF starts (see Program.cs). -->
    <StartupObject>RemoteMan.App.Program</StartupObject>
    <!-- Release builds get the version from the git tag (see .github/workflows/release.yml). -->
    <Version>0.1.0</Version>
    <ApplicationIcon>Assets\remoteman.ico</ApplicationIcon>
  </PropertyGroup>
  <!-- WPF app that also hosts a WinForms control: keep WinForms out of the global usings. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RemoteMan.Core\RemoteMan.Core.csproj" />
    <ProjectReference Include="..\RemoteMan.Data\RemoteMan.Data.csproj" />
    <ProjectReference Include="..\RemoteMan.Protocols\RemoteMan.Protocols.csproj" />
    <ProjectReference Include="..\RemoteMan.Gateway\RemoteMan.Gateway.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.15" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="WpfAnimatedGif" Version="2.0.2" />
    <!-- Reads 2FA setup QR codes from screenshots (Apache-2.0). -->
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\terminal\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The What's new list, written by CI (build/changelog.py) before it builds. Missing in local builds. -->
  <ItemGroup>
    <EmbeddedResource Include="changelog.json" LogicalName="RemoteMan.changelog.json" Condition="Exists('changelog.json')" />
  </ItemGroup>

  <!-- xterm.js (MIT) for the SSH terminal, fetched once into Assets/terminal/vendor. -->
  <PropertyGroup>
    <XtermVendorDir>$(MSBuildProjectDirectory)\Assets\terminal\vendor</XtermVendorDir>
  </PropertyGroup>
  <Target Name="FetchXterm" BeforeTargets="BeforeBuild" Condition="!Exists('$(XtermVendorDir)\xterm.js') Or !Exists('$(XtermVendorDir)\addon-search.js')">
    <DownloadFile SourceUrl="https://cdn.jsdelivr.net/npm/@xterm/xterm@5.5.0/lib/xterm.js" DestinationFolder="$(XtermVendorDir)" />
    <DownloadFile SourceUrl="https://cdn.jsdelivr.net/npm/@xterm/xterm@5.5.0/css/xterm.css" DestinationFolder="$(XtermVendorDir)" />
    <DownloadFile SourceUrl="https://cdn.jsdelivr.net/npm/@xterm/addon-fit@0.10.0/lib/addon-fit.js" DestinationFolder="$(XtermVendorDir)" />
    <DownloadFile SourceUrl="https://cdn.jsdelivr.net/npm/@xterm/addon-search@0.15.0/lib/addon-search.js" DestinationFolder="$(XtermVendorDir)" />
    <ItemGroup>
      <Content Include="Assets\terminal\vendor\*" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
