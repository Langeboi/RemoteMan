<Window x:Class="RemoteMan.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RemoteMan.App.ViewModels"
        xmlns:views="clr-namespace:RemoteMan.App.Views"
        Title="RemoteMan" Width="1440" Height="900" MinWidth="800" MinHeight="500"
        Style="{StaticResource RemoteManWindow}" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <!-- Session views, chosen by type and kept alive while hidden -->
        <DataTemplate DataType="{x:Type vm:SshSessionViewModel}"><views:SshSessionView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RdpSessionViewModel}"><views:RdpSessionView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:WebSessionViewModel}"><views:WebSessionView /></DataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type vm:EntryNode}" ItemsSource="{Binding Children}">
            <DockPanel LastChildFill="True">
                <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding People}" Focusable="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#5A5240" BorderThickness="1" Padding="2,0" Margin="3,0,0,0" ToolTip="{Binding ToolTip}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Initials}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Presence}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Path x:Name="chevron" Width="10" Height="10" Margin="0,0,4,0" Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="1.5"
                      Data="M0,0 L4,4 L8,0" Visibility="Collapsed" VerticalAlignment="Center" />
                <Path x:Name="folder" Width="13" Height="11" Margin="0,0,6,0" Stretch="Uniform" Stroke="#9C9686" StrokeThickness="1.3"
                      Data="M0,1 H5 L6.5,2.5 H13 V11 H0 Z" Visibility="Collapsed" VerticalAlignment="Center" />
                <Border x:Name="tag" Style="{StaticResource KindTag}" Margin="0,0,6,0">
                    <TextBlock Text="{Binding KindTag}" Style="{StaticResource KindTagText}" />
                </Border>
                <TextBlock x:Name="name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" />
            </DockPanel>
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="chevron" Property="Visibility" Value="Visible" />
                    <Setter TargetName="folder" Property="Visibility" Value="Visible" />
                    <Setter TargetName="tag" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="name" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                    <Setter TargetName="chevron" Property="Data" Value="M0,0 L4,4 L0,8" />
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F2" Command="{Binding EditCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding DuplicateCommand}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseSessionCommand}" CommandParameter="{Binding ActiveSession}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- Menu + search strip -->
        <Border DockPanel.Dock="Top" Height="30" Background="{StaticResource Header}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <DockPanel Margin="6,0" LastChildFill="False">
                <TextBlock Text="RemoteMan" FontWeight="SemiBold" Foreground="#E4E6E9" VerticalAlignment="Center" Margin="4,0,10,0" />
                <Menu VerticalAlignment="Center">
                    <MenuItem Header="_File">
                        <MenuItem Header="Data sources…" Click="OnDataSources" />
                        <Separator />
                        <MenuItem Header="E_xit" Click="OnExit" />
                    </MenuItem>
                    <MenuItem Header="_Edit">
                        <MenuItem Header="New RDP entry" Command="{Binding NewEntryCommand}" CommandParameter="Rdp" />
                        <MenuItem Header="New SSH entry" Command="{Binding NewEntryCommand}" CommandParameter="Ssh" />
                        <MenuItem Header="New web entry" Command="{Binding NewEntryCommand}" CommandParameter="Web" />
                        <MenuItem Header="New VNC entry" Command="{Binding NewEntryCommand}" CommandParameter="Vnc" />
                        <MenuItem Header="New credential" Command="{Binding NewEntryCommand}" CommandParameter="Credential" />
                        <MenuItem Header="New folder" Command="{Binding NewEntryCommand}" CommandParameter="Folder" />
                        <Separator />
                        <MenuItem Header="Edit" InputGestureText="F2" Command="{Binding EditCommand}" />
                        <MenuItem Header="Duplicate" InputGestureText="Ctrl+D" Command="{Binding DuplicateCommand}" />
                        <MenuItem Header="Delete" InputGestureText="Del" Command="{Binding DeleteCommand}" />
                    </MenuItem>
                    <MenuItem Header="_Session">
                        <MenuItem Header="Connect" InputGestureText="Enter" Command="{Binding ConnectCommand}" />
                        <MenuItem Header="Close tab" InputGestureText="Ctrl+W" Command="{Binding CloseSessionCommand}" CommandParameter="{Binding ActiveSession}" />
                    </MenuItem>
                </Menu>
                <Border DockPanel.Dock="Right" Width="340" Height="22" VerticalAlignment="Center" Background="{StaticResource Bg}"
                        BorderBrush="{StaticResource InputBorder}" BorderThickness="1">
                    <DockPanel Margin="6,0">
                        <TextBlock DockPanel.Dock="Right" Text="Ctrl+K" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
                        <Grid>
                            <TextBox x:Name="Search" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=120}" BorderThickness="0" Background="Transparent"
                                     AutomationProperties.Name="Find entry or quick connect host" KeyDown="OnSearchKeyDown" />
                            <TextBlock Text="Find entry or quick connect host" Foreground="{StaticResource Faint}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="5,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Height="22" Background="{StaticResource Header}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <DockPanel Margin="8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Width="6" Height="6" Margin="0,0,5,0">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Fill" Value="{StaticResource Warn}" />
                                <Style.Triggers><DataTrigger Binding="{Binding DataSourceOk}" Value="True"><Setter Property="Fill" Value="{StaticResource Ok}" /></DataTrigger></Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>
                    <TextBlock Text="{Binding DataSourceText}" Style="{StaticResource Muted}" FontSize="11" />
                    <TextBlock Text="{Binding OnlineText}" Style="{StaticResource Muted}" FontSize="11" Margin="14,0,0,0" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding ActiveSession.StatusText}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Message}" Foreground="{StaticResource Presence}" FontSize="11" Margin="14,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180" MaxWidth="520" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left column: tree + properties -->
            <Grid Background="{StaticResource Panel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" MinHeight="100" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                    <DockPanel Margin="8,0,2,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" ToolTip="New entry" AutomationProperties.Name="New entry" Click="OnNewMenu">
                            <Path Data="M5,0 V10 M0,5 H10" Stroke="#B8BCC3" StrokeThickness="1.5" />
                        </Button>
                        <TextBlock Text="Navigation" Style="{StaticResource PaneTitle}" />
                    </DockPanel>
                </Border>
                <TreeView x:Name="Tree" Grid.Row="1" ItemsSource="{Binding Roots}" ItemContainerStyle="{StaticResource EntryItem}"
                          Background="Transparent" BorderThickness="0" Padding="0,2"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          SelectedItemChanged="OnTreeSelectionChanged" PreviewMouseLeftButtonDown="OnTreeMouseDown"
                          MouseDoubleClick="OnTreeDoubleClick" KeyDown="OnTreeKeyDown">
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Connect" Command="{Binding ConnectCommand}" />
                            <MenuItem Header="Edit" Command="{Binding EditCommand}" />
                            <MenuItem Header="Duplicate" Command="{Binding DuplicateCommand}" />
                            <Separator />
                            <MenuItem Header="Delete" Command="{Binding DeleteCommand}" />
                        </ContextMenu>
                    </TreeView.ContextMenu>
                </TreeView>
                <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Height="1" />

                <!-- Properties pane -->
                <Border Grid.Row="3" Background="{StaticResource Panel2}" Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <Border Height="24" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1">
                            <TextBlock Text="Properties" Style="{StaticResource PaneTitle}" Margin="8,0" />
                        </Border>
                        <StackPanel Margin="8,6,8,8">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Style="{StaticResource KindTag}" Margin="0,0,6,0"><TextBlock Text="{Binding SelectedKindTag}" Style="{StaticResource KindTagText}" /></Border>
                                <TextBlock Text="{Binding SelectedName}" FontWeight="SemiBold" Foreground="#E4E6E9" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Properties}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,1">
                                            <TextBlock Width="58" Text="{Binding Key}" Style="{StaticResource Muted}" />
                                            <TextBlock x:Name="v" Text="{Binding Value}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" />
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="presence"><Setter TargetName="v" Property="Foreground" Value="{StaticResource Presence}" /></DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch" />

            <!-- Working area -->
            <DockPanel Grid.Column="2" Background="{StaticResource Work}">
                <Border DockPanel.Dock="Top" Height="26" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                    <ListBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding ActiveSession}" ItemContainerStyle="{StaticResource SessionTab}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" MouseDown="OnTabMouseDown">
                                    <Border Style="{StaticResource KindTag}" Margin="0,0,6,0"><TextBlock Text="{Binding KindTag}" Style="{StaticResource KindTagText}" /></Border>
                                    <TextBlock Text="{Binding Title}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource FlatButton}" Padding="6,0" MinHeight="18" Margin="4,0,-6,0" Foreground="{StaticResource Faint}"
                                            Content="×" ToolTip="Close (Ctrl+W)" AutomationProperties.Name="Close tab"
                                            Command="{Binding DataContext.CloseSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <Grid>
                    <TextBlock Text="Double-click an entry to connect" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <ItemsControl ItemsSource="{Binding Sessions}" Focusable="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Grid /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Visibility" Value="{Binding IsActive, Converter={StaticResource BoolVis}}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
