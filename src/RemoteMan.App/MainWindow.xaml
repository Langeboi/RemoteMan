<Window x:Class="RemoteMan.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RemoteMan.App.ViewModels"
        xmlns:views="clr-namespace:RemoteMan.App.Views"
        xmlns:local="clr-namespace:RemoteMan.App"
        xmlns:updates="clr-namespace:RemoteMan.App.Updates"
        Title="RemoteMan" Width="1440" Height="900" MinWidth="900" MinHeight="520"
        Style="{StaticResource RemoteManWindow}" WindowStartupLocation="CenterScreen">

    <!-- Own title bar (no transparency, so RDP/WebView2 keep GPU rendering). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <local:NullToCollapsedConverter x:Key="NullVis" />

        <!-- Session views, chosen by type and kept alive while hidden -->
        <DataTemplate DataType="{x:Type vm:SshSessionViewModel}"><DockPanel><views:ShareBar DockPanel.Dock="Top" DataContext="{Binding Share}" /><views:SshSessionView /></DockPanel></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RdpSessionViewModel}"><DockPanel><views:ShareBar DockPanel.Dock="Top" DataContext="{Binding Share}" /><views:RdpSessionView /></DockPanel></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SharedSessionViewModel}"><DockPanel><views:ShareBar DockPanel.Dock="Top" DataContext="{Binding Share}" /><views:SharedSessionView /></DockPanel></DataTemplate>
        <DataTemplate DataType="{x:Type vm:WebSessionViewModel}"><views:WebSessionView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:FilesSessionViewModel}"><views:FilesSessionView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}"><views:OverviewView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfigBackupsSessionViewModel}"><views:ConfigBackupsView /></DataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type vm:EntryNode}" ItemsSource="{Binding Children}">
            <DockPanel LastChildFill="True">
                <!-- Chevron column: always takes its space so icons line up; only folders show (and click) it -->
                <Border x:Name="chevBox" Width="16" Height="16" Margin="0,0,2,0" Background="Transparent" Visibility="Hidden" VerticalAlignment="Center"
                        MouseLeftButtonDown="OnChevronDown" Cursor="Hand">
                    <Path x:Name="chevron" Width="8" Height="8" Stretch="Uniform" Stroke="{StaticResource Faint}" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="M0,0 L4,4 L8,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <!-- Plain folders are filled in their colour; glyph folders (server, network…) stay outlined -->
                <Path x:Name="folder" Width="16" Height="16" Margin="0,0,7,0" Stretch="None" Stroke="{Binding FolderBrush}" Fill="{Binding FolderFill}" StrokeThickness="1.3"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="{Binding FolderGlyph}" Visibility="Collapsed" VerticalAlignment="Center" />
                <!-- The data source node: database glyph with a green (online) or red (offline) dot -->
                <Grid x:Name="dsIcon" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center" Visibility="Collapsed"
                      ToolTip="{Binding DataContext.DataSourceText, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Path Data="M2.5,3.5 c0,-1.1 2.5,-2 5.5,-2 s5.5,0.9 5.5,2 s-2.5,2 -5.5,2 s-5.5,-0.9 -5.5,-2 z M2.5,3.5 v9 c0,1.1 2.5,2 5.5,2 s5.5,-0.9 5.5,-2 v-9 M2.5,8 c0,1.1 2.5,2 5.5,2 s5.5,-0.9 5.5,-2"
                          Stroke="{StaticResource EntryIcon}" StrokeThickness="1.3" />
                    <Ellipse Width="7" Height="7" Margin="0,0,-3,-3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Stroke="{StaticResource Panel}" StrokeThickness="1">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Bad}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.DataSourceOk, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Ok}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </Grid>
                <!-- Protocol icon with a tiny presence badge on its corner when someone is on the entry -->
                <Grid x:Name="tag" Margin="0,0,7,0" VerticalAlignment="Center">
                    <Path x:Name="kind" Style="{StaticResource KindIcon}" Tag="{Binding KindTag}" />
                    <Image x:Name="custom" Width="16" Height="16" Source="{Binding IconImage}" ToolTip="{Binding KindName}" Visibility="Collapsed"
                           RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" />
                    <Border Width="9" Height="9" CornerRadius="4.5" Margin="0,0,-3,-3" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Background="{Binding Badge.Color}" BorderBrush="{StaticResource Panel}" BorderThickness="1" ToolTip="{Binding Badge.ToolTip}"
                            Visibility="{Binding Badge, Converter={StaticResource NullVis}}">
                        <TextBlock Text="{Binding Badge.Initials}" FontSize="5.5" FontWeight="Bold" Foreground="{StaticResource Bg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <!-- Oxidized: small orange dot when the device's last config backup failed -->
                <Ellipse DockPanel.Dock="Right" Width="7" Height="7" Margin="6,0,0,0" Fill="{StaticResource Warn}" VerticalAlignment="Center"
                         ToolTip="{Binding BackupTip}" Visibility="{Binding BackupFailed, Converter={StaticResource BoolVis}}" />
                <!-- Zabbix: health glyph on entries, count of problem hosts on folders -->
                <Path DockPanel.Dock="Right" Style="{StaticResource HealthGlyph}" Tag="{Binding Health}" Margin="6,0,0,0" ToolTip="{Binding HealthTip}" />
                <Border x:Name="pcount" DockPanel.Dock="Right" MinWidth="16" Height="16" CornerRadius="8" Padding="4,0" Margin="6,0,0,0" Background="{StaticResource Warn}"
                        ToolTip="{Binding HealthTip}" Visibility="{Binding HasProblemCount, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding ProblemCount}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Bg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" />
            </DockPanel>
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="name" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="chevBox" Property="Visibility" Value="Visible" />
                    <Setter TargetName="folder" Property="Visibility" Value="Visible" />
                    <Setter TargetName="tag" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <!-- Change icon: custom glyph or vendor mark replaces the protocol / folder icon (after IsFolder so it wins) -->
                <DataTrigger Binding="{Binding HasCustomIcon}" Value="True">
                    <Setter TargetName="folder" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="tag" Property="Visibility" Value="Visible" />
                    <Setter TargetName="kind" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="custom" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                    <Setter TargetName="chevron" Property="Data" Value="M0,0 L4,4 L0,8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRoot}" Value="True">
                    <Setter TargetName="folder" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="tag" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="dsIcon" Property="Visibility" Value="Visible" />
                    <Setter TargetName="name" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="name" Property="Foreground" Value="#7DB2F0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProblemCountHigh}" Value="True">
                    <Setter TargetName="pcount" Property="Background" Value="{StaticResource Bad}" />
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>

        <!-- One tab in a pane's tab strip -->
        <DataTemplate x:Key="TabHeader">
            <!-- The Dashboard tab is pinned: no menu (OnTabMenuOpening), no close button -->
            <StackPanel Orientation="Horizontal" MouseDown="OnTabMouseDown" Background="Transparent" ContextMenuOpening="OnTabMenuOpening">
                <StackPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Move to other pane" Click="OnMoveTab" />
                        <MenuItem Header="Share this session…" Click="OnShareTab" Visibility="{Binding CanShare, Converter={StaticResource BoolVis}}" />
                        <MenuItem Header="Stop sharing" Click="OnStopShareTab" Visibility="{Binding Share.IsHost, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}" />
                        <Separator />
                        <MenuItem Header="Close" InputGestureText="Ctrl+W" Click="OnCloseTab" />
                    </ContextMenu>
                </StackPanel.ContextMenu>
                <Path Style="{StaticResource KindIcon}" Tag="{Binding KindTag}" Margin="0,0,7,0" />
                <Path Data="M1,6 H5 M5,6 L9,2 M5,6 H10 M5,6 L9,10" Stroke="{StaticResource Warn}" StrokeThickness="1.4" Margin="0,0,6,0" VerticalAlignment="Center"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" ToolTip="Broadcast: what you type in the group goes to this tab too"
                      Visibility="{Binding IsBroadcasting, Converter={StaticResource BoolVis}}" />
                <TextBlock Text="{Binding Title}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <!-- The Overview tab follows the selection: italic, like a preview -->
                                <DataTrigger Binding="{Binding IsPreview}" Value="True"><Setter Property="FontStyle" Value="Italic" /><Setter Property="ToolTip" Value="Overview: follows the entry you click in the tree" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Width="22" Padding="0" MinHeight="22" Margin="6,0,0,0" Foreground="{StaticResource Faint}"
                        ToolTip="Close (Ctrl+W)" AutomationProperties.Name="Close tab"
                        Command="{Binding DataContext.CloseSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPinned}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" />
                </Button>
            </StackPanel>
        </DataTemplate>

        <Style TargetType="ListBox" x:Key="TabStrip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SessionTab}" />
            <Setter Property="ItemTemplate" Value="{StaticResource TabHeader}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></Setter.Value>
            </Setter>
        </Style>

        <!-- Pane frame: accent border on the focused pane in split view -->
        <Style TargetType="Border" x:Key="PaneFrame">
            <Setter Property="Background" Value="{StaticResource Bg}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="focused" />
                        <Condition Binding="{Binding IsSplit}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock" x:Key="EmptyHint">
            <Setter Property="Foreground" Value="{StaticResource Faint}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Grid.Row" Value="1" />
        </Style>

        <Geometry x:Key="Glyph.Search">M10.5,10.5 L14,14 M11.5,6.5 A5,5 0 1 1 1.5,6.5 A5,5 0 1 1 11.5,6.5 Z</Geometry>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F2" Command="{Binding EditCommand}" />
        <KeyBinding Key="Enter" Modifiers="Alt" Command="{Binding EditCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding DuplicateCommand}" />
        <KeyBinding Key="U" Modifiers="Control+Shift" Command="{Binding CopyUserNameCommand}" />
        <KeyBinding Key="P" Modifiers="Control+Shift" Command="{Binding CopyPasswordCommand}" />
        <KeyBinding Key="B" Modifiers="Control+Shift" Command="{Binding CopyBothCommand}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseSessionCommand}" CommandParameter="{Binding ActiveSession}" />
    </Window.InputBindings>

    <!-- Maximized windows overhang the screen by the resize border; pad it back in. -->
    <Border x:Name="Root">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Padding" Value="7" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
    <DockPanel>
        <!-- Title bar: app mark, a few actions, search everywhere, who's online, window buttons -->
        <Border DockPanel.Dock="Top" Height="36" Background="{StaticResource Depth.Header}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Border Width="20" Height="20" CornerRadius="{StaticResource Radius}" Background="{StaticResource Accent}">
                        <TextBlock Text="R" FontWeight="Bold" Foreground="{StaticResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="RemoteMan" FontWeight="SemiBold" Margin="8,0,10,0" VerticalAlignment="Center" />
                    <Border Width="1" Height="20" Background="{StaticResource Border}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource BarButton}" ToolTip="New entry" AutomationProperties.Name="New entry" Click="OnNewMenu">
                        <Path Data="M7,1 V13 M1,7 H13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" />
                    </Button>
                    <Button Style="{StaticResource BarButton}" ToolTip="Edit entry (F2)" AutomationProperties.Name="Edit entry" Command="{Binding EditCommand}">
                        <Path Data="M1,13 H4 L13,4 L10,1 L1,10 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeLineJoin="Round" />
                    </Button>
                    <Button Style="{StaticResource BarButton}" ToolTip="Connect (Enter)" AutomationProperties.Name="Connect" Command="{Binding ConnectCommand}">
                        <Path Data="M2,1 L12,7 L2,13 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource BarButton}" ToolTip="Add to or remove from favorites" AutomationProperties.Name="Toggle favorite" Command="{Binding ToggleFavoriteCommand}">
                        <Path Data="M7,0.8 L8.9,4.8 L13.2,5.3 L10,8.3 L10.9,12.6 L7,10.4 L3.1,12.6 L4,8.3 L0.8,5.3 L5.1,4.8 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeLineJoin="Round" />
                    </Button>
                    <ToggleButton Style="{StaticResource BarToggle}" IsChecked="{Binding IsSplit}" ToolTip="Split view" AutomationProperties.Name="Split view">
                        <Path Data="M1,1 H15 V13 H1 Z M8,1 V13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.4" />
                    </ToggleButton>
                    <Button Style="{StaticResource BarButton}" ToolTip="More" AutomationProperties.Name="More actions" Click="OnMoreMenu">
                        <Path Data="M1,7 H3 M6,7 H8 M11,7 H13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                </StackPanel>

                <Border Grid.Column="2" MaxWidth="440" Height="26" Margin="16,0" VerticalAlignment="Center" Background="{StaticResource Bg}"
                        BorderBrush="{StaticResource InputBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius}" WindowChrome.IsHitTestVisibleInChrome="True">
                    <DockPanel Margin="8,0,6,0">
                        <Path DockPanel.Dock="Left" Data="{StaticResource Glyph.Search}" Stroke="{StaticResource Faint}" StrokeThickness="1.4" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Border DockPanel.Dock="Right" BorderBrush="{StaticResource InputBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="4,0" VerticalAlignment="Center"
                                Background="Transparent" Cursor="Hand" MouseLeftButtonDown="OnSearchEverything"
                                ToolTip="Search everything: names, hosts, tags, custom fields, descriptions (Ctrl K)">
                            <TextBlock Text="Ctrl K" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource Faint}" />
                        </Border>
                        <Grid>
                            <TextBox x:Name="Search" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=120}" BorderThickness="0" Background="Transparent"
                                     AutomationProperties.Name="Search entries or type a host to connect" KeyDown="OnSearchKeyDown" />
                            <TextBlock Text="Filter the tree, or type a host to connect" Foreground="{StaticResource Faint}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="5,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Who's online (shared data sources only). The AI assistant button goes right of this. -->
                <ItemsControl Grid.Column="3" ItemsSource="{Binding OnlineUsers}" Focusable="False" VerticalAlignment="Center" Margin="0,0,8,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="24" Height="24" CornerRadius="12" Background="{Binding Color}" BorderBrush="{StaticResource Header}" BorderThickness="2"
                                    Margin="-5,0,0,0" ToolTip="{Binding ToolTip}" WindowChrome.IsHitTestVisibleInChrome="True" Cursor="Hand" MouseLeftButtonUp="OnAvatarClick">
                                <TextBlock Text="{Binding Initials}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Bg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <!-- Team chat (shared data sources only): just the glyph, with the unread count on its corner -->
                    <ToggleButton x:Name="ChatButton" Style="{StaticResource BarToggle}" Margin="0,0,8,0" IsChecked="{Binding Chat.IsOpen}"
                                  Visibility="{Binding Chat.IsAvailable, Converter={StaticResource BoolVis}}"
                                  ToolTip="Chat (Ctrl+Shift+M)" AutomationProperties.Name="Chat">
                        <Grid Width="22" Height="20">
                            <Path Data="M1.5,2.5 H14.5 V10.5 H6 L3,13.5 V10.5 H1.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  StrokeThickness="1.4" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-5,0" MinWidth="15" Height="15" Padding="3,0" CornerRadius="7.5"
                                    Background="{StaticResource Accent}" BorderBrush="{StaticResource Header}" BorderThickness="1.5"
                                    Visibility="{Binding Chat.HasUnread, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding Chat.UnreadText}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </ToggleButton>
                    <!-- AI assistant: provider name + green dot once signed in (on standby); opens the chat box -->
                    <Button x:Name="AiButton" Height="24" Margin="0,0,10,0" Padding="8,0" Background="Transparent" VerticalAlignment="Center"
                            BorderBrush="{StaticResource InputBorder}" Click="OnAiButton" WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="AI assistant (Ctrl+Shift+A)" AutomationProperties.Name="AI assistant">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="12" Height="12" Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="1.3" Margin="0,0,6,0"
                                  Data="M12,3 L13.8,8.2 L19,10 L13.8,11.8 L12,17 L10.2,11.8 L5,10 L10.2,8.2 Z" />
                            <TextBlock Text="{Binding ButtonLabel}" VerticalAlignment="Center" />
                            <Rectangle Width="6" Height="6" Fill="{StaticResource Ok}" Margin="6,0,0,0" ToolTip="On standby"
                                       Visibility="{Binding IsConnected, Converter={StaticResource BoolVis}}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" ToolTip="Minimize" AutomationProperties.Name="Minimize" Click="OnMinimize">
                        <Path Data="M0,0 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" ToolTip="Maximize" AutomationProperties.Name="Maximize" Click="OnMaximize">
                        <Path x:Name="MaxGlyph" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                    </Button>
                    <Button Style="{StaticResource CloseCaptionButton}" ToolTip="Close" AutomationProperties.Name="Close" Click="OnClose">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Update banner (hidden unless there is an update to show) -->
        <updates:UpdateBanner DockPanel.Dock="Top" />

        <!-- Status bar: quick connect, messages, active session, the Q, users online, version -->
        <Border DockPanel.Dock="Bottom" Height="26" Background="{StaticResource Depth.Header}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Left" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0" Padding="10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Connect" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Grid Width="150">
                            <TextBox x:Name="QuickHostBox" Text="{Binding QuickHost, UpdateSourceTrigger=PropertyChanged}" MinHeight="18" Height="18" Padding="4,0"
                                     FontFamily="{StaticResource MonoFont}" FontSize="11" AutomationProperties.Name="Quick connect host or IP" KeyDown="OnQuickHostKeyDown" />
                            <TextBlock Text="Host or IP address" FontSize="11" Foreground="{StaticResource Faint}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="6,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=QuickHostBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock DockPanel.Dock="Right" Text="{Binding AppVersion}" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="10,0" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding OnlineText}" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" />

                <!-- Zabbix: a small "Z" like the Q. Green when connected, red when unreachable, grey while connecting. Click for details. -->
                <Grid DockPanel.Dock="Right" Visibility="{Binding ZabbixActive, Converter={StaticResource BoolVis}}">
                    <ToggleButton x:Name="ZButton" Style="{StaticResource BarToggle}" Width="30" Height="24" ToolTip="{Binding ZabbixStatusText}" AutomationProperties.Name="{Binding ZabbixStatusText}">
                        <Grid Width="16" Height="16">
                            <Ellipse>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Faint}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ZabbixConnState}" Value="ok"><Setter Property="Fill" Value="{StaticResource Ok}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding ZabbixConnState}" Value="bad"><Setter Property="Fill" Value="{StaticResource Bad}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="Z" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Bg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ToggleButton>
                    <Popup AllowsTransparency="True" IsOpen="{Binding IsChecked, ElementName=ZButton}" StaysOpen="False" Placement="Top" PlacementTarget="{Binding ElementName=ZButton}"
                           HorizontalOffset="-240" VerticalOffset="-4" Closed="OnZPopupClosed">
                        <Border Width="300" Background="{StaticResource ButtonBg}" BorderBrush="{StaticResource ButtonBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Zabbix" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <DockPanel>
                                    <Path Style="{StaticResource HealthGlyph}" Tag="{Binding ZabbixStatusTag}" Margin="0,0,6,0" VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding ZabbixStatusText}" TextWrapping="Wrap" />
                                </DockPanel>
                                <TextBlock Text="{Binding ZabbixRouteText}" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Settings…" Command="{Binding ZabbixSettingsCommand}" Click="OnZPopupButton" />
                                    <Button Content="Import hosts…" Margin="6,0,0,0" Command="{Binding ImportFromZabbixCommand}" Click="OnZPopupButton" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <!-- Shared data source: a small "Q", green when connected, red when offline. Hidden for local. Click for details. -->
                <Grid DockPanel.Dock="Right" Visibility="{Binding IsSharedSource, Converter={StaticResource BoolVis}}">
                    <ToggleButton x:Name="QButton" Style="{StaticResource BarToggle}" Width="30" Height="24" ToolTip="{Binding DataSourceText}" AutomationProperties.Name="{Binding DataSourceText}">
                        <Grid Width="16" Height="16">
                            <Ellipse>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Bad}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataSourceOk}" Value="True"><Setter Property="Fill" Value="{StaticResource Ok}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="Q" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Bg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ToggleButton>
                    <Popup AllowsTransparency="True" IsOpen="{Binding IsChecked, ElementName=QButton}" StaysOpen="False" Placement="Top" PlacementTarget="{Binding ElementName=QButton}"
                           HorizontalOffset="-240" VerticalOffset="-4" Closed="OnQPopupClosed">
                        <Border Width="300" Background="{StaticResource ButtonBg}" BorderBrush="{StaticResource ButtonBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Shared database" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding DataSourceText}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding OnlineText}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0" />
                                <TextBlock Text="When the database is unreachable, RemoteMan works from its local cache and retries every 15 seconds."
                                           Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <TextBlock DockPanel.Dock="Right" Text="{Binding ActiveSession.StatusText}" FontFamily="{StaticResource MonoFont}" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="10,0" />
                <TextBlock Text="{Binding Message}" Foreground="{StaticResource Presence}" FontSize="11" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" MinWidth="180" MaxWidth="520" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Navigation panel: tree (data source as the top node), entry card, then the data source picker and panel tabs -->
            <Grid Background="{StaticResource Panel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="100" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- Title for Favorites, Recent and Credentials (the navigation tree has its data source node instead) -->
                <Border Height="30" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNavPanel}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding PanelTitle}" Margin="12,0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                               Typography.Capitals="AllSmallCaps" />
                </Border>

                <TreeView x:Name="Tree" Grid.Row="2" ItemsSource="{Binding Roots}" ItemContainerStyle="{StaticResource EntryItem}"
                          Background="Transparent" BorderThickness="0" Padding="0,3"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          SelectedItemChanged="OnTreeSelectionChanged" PreviewMouseLeftButtonDown="OnTreeMouseDown" PreviewMouseLeftButtonUp="OnTreeMouseUp"
                          PreviewMouseMove="OnTreeMouseMove" AllowDrop="True" DragOver="OnTreeDragOver" DragLeave="OnTreeDragLeave" Drop="OnTreeDrop"
                          MouseDoubleClick="OnTreeDoubleClick" KeyDown="OnTreeKeyDown" PreviewKeyDown="OnTreePreviewKeyDown"
                          PreviewMouseRightButtonDown="OnTreeRightButtonDown" ContextMenuOpening="OnTreeContextMenuOpening">
                    <!-- Filled per entry when it opens (Views/EntryMenu.cs) -->
                    <TreeView.ContextMenu><ContextMenu /></TreeView.ContextMenu>
                </TreeView>
                <!-- Bottom bar: data source picker, then the panel tabs (navigation, favorites, recent, credentials) -->
                <Border Grid.Row="3" Background="{StaticResource Panel2}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <DockPanel Height="32" Margin="8,0,4,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Width="26" Height="24" Padding="0" ToolTip="Refresh (F5)" AutomationProperties.Name="Refresh" Click="OnPanelRefresh">
                                <Path Data="M13.5,8 A5.5,5.5 0 1 1 11.9,4.1 M13.5,1.8 V4.6 H10.7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Button>
                            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Width="26" Height="24" Padding="0" ToolTip="More" AutomationProperties.Name="Navigation options" Click="OnPanelMore">
                                <Path Data="M3,8 h0.01 M8,8 h0.01 M13,8 h0.01" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Button>
                            <Button Style="{StaticResource FlatButton}" Height="26" Padding="0,0,6,0" HorizontalContentAlignment="Stretch" Click="OnDataSourcePicker"
                                    ToolTip="{Binding DataSourceText}" AutomationProperties.Name="Switch data source">
                                <DockPanel>
                                    <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource EntryIcon}" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Path Data="M2.5,3.5 c0,-1.1 2.5,-2 5.5,-2 s5.5,0.9 5.5,2 s-2.5,2 -5.5,2 s-5.5,-0.9 -5.5,-2 z M2.5,3.5 v9 c0,1.1 2.5,2 5.5,2 s5.5,-0.9 5.5,-2 v-9 M2.5,8 c0,1.1 2.5,2 5.5,2 s5.5,-0.9 5.5,-2"
                                              Stroke="{StaticResource Bg}" StrokeThickness="1.6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path.LayoutTransform><ScaleTransform ScaleX="0.75" ScaleY="0.75" /></Path.LayoutTransform>
                                        </Path>
                                    </Border>
                                    <Path DockPanel.Dock="Right" Data="M0,0 L4,4 L8,0" Stroke="{StaticResource Muted}" StrokeThickness="1.4" VerticalAlignment="Center" Margin="6,0,0,0" />
                                    <TextBlock Text="{Binding DataSourceName}" FontWeight="SemiBold" Foreground="{StaticResource Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Button>
                        </DockPanel>
                        <UniformGrid Rows="1" Height="34" Margin="4,0,4,4">
                            <RadioButton GroupName="Rail" Style="{StaticResource PanelTab}" Tag="nav" IsChecked="True" Checked="OnRailChecked" ToolTip="Navigation" AutomationProperties.Name="Navigation">
                                <Path Data="M1.5,1.5 h5 v3 h-5 z M4,4.5 V12.5 M4,8 h3.5 M4,12.5 h3.5 M9,6.5 h5.5 v3 H9 z M9,11 h5.5 v3 H9 z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3" StrokeLineJoin="Round" />
                            </RadioButton>
                            <RadioButton GroupName="Rail" Style="{StaticResource PanelTab}" Tag="fav" Checked="OnRailChecked" ToolTip="Favorites" AutomationProperties.Name="Favorites">
                                <Path Data="M8,0.8 L10.1,5.2 L14.9,5.8 L11.4,9.1 L12.3,13.9 L8,11.5 L3.7,13.9 L4.6,9.1 L1.1,5.8 L5.9,5.2 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4" StrokeLineJoin="Round" />
                            </RadioButton>
                            <RadioButton GroupName="Rail" Style="{StaticResource PanelTab}" Tag="recent" Checked="OnRailChecked" ToolTip="Recent" AutomationProperties.Name="Recent">
                                <Path Data="M15,8 A7,7 0 1 1 1,8 A7,7 0 1 1 15,8 Z M8,4 V8 L10.5,9.8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4" StrokeLineJoin="Round" />
                            </RadioButton>
                            <RadioButton GroupName="Rail" Style="{StaticResource PanelTab}" Tag="cred" Checked="OnRailChecked" ToolTip="Credentials" AutomationProperties.Name="Credentials">
                                <Path Data="{StaticResource Icon.KEY}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </RadioButton>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch" />

            <!-- Shading: soft shadows under the title bar and along the tree's edge (transparent when Flat). Sessions draw over them. -->
            <Border Grid.ColumnSpan="4" Height="6" VerticalAlignment="Top" Background="{StaticResource Depth.ShadowDown}" IsHitTestVisible="False" Panel.ZIndex="100" />
            <Border Grid.Column="2" Width="6" HorizontalAlignment="Left" Background="{StaticResource Depth.ShadowRight}" IsHitTestVisible="False" Panel.ZIndex="100" />

            <!-- Working area: one or two panes, each with its own tabs -->
            <Grid Grid.Column="2" Background="{StaticResource Work}">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{Binding PaneGapWidth}" />
                        <ColumnDefinition Width="{Binding RightPaneWidth}" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.RowSpan="2" Style="{StaticResource PaneFrame}" Tag="{Binding LeftPaneTag}" />
                    <Border Grid.Column="2" Grid.RowSpan="2" Style="{StaticResource PaneFrame}" Tag="{Binding RightPaneTag}"
                            Visibility="{Binding IsSplit, Converter={StaticResource BoolVis}}" />

                    <Border Margin="1,1,1,0" Background="{StaticResource Depth.Header}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" CornerRadius="{StaticResource TopRadius}">
                        <ListBox Style="{StaticResource TabStrip}" Tag="{Binding LeftPaneTag}" ItemsSource="{Binding LeftSessions}" SelectedItem="{Binding LeftActive}"
                                 PreviewMouseDown="OnLeftPaneMouseDown" AutomationProperties.Name="Left pane tabs" />
                    </Border>
                    <Border Grid.Column="2" Margin="1,1,1,0" Background="{StaticResource Depth.Header}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" CornerRadius="{StaticResource TopRadius}"
                            Visibility="{Binding IsSplit, Converter={StaticResource BoolVis}}">
                        <ListBox Style="{StaticResource TabStrip}" Tag="{Binding RightPaneTag}" ItemsSource="{Binding RightSessions}" SelectedItem="{Binding RightActive}"
                                 PreviewMouseDown="OnRightPaneMouseDown" AutomationProperties.Name="Right pane tabs" />
                    </Border>

                    <TextBlock Text="Click an entry to see its overview.&#x0a;Double-click it to connect.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyHint}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LeftSessions.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="2" Text="Click here, then open an entry,&#x0a;or right-click a tab and move it here.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyHint}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RightSessions.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- Empty right pane: clicking it focuses it -->
                    <Border Grid.Row="1" Grid.Column="2" Background="Transparent" MouseDown="OnRightPaneMouseDown" />
                    <Border Grid.Row="1" Background="Transparent" MouseDown="OnLeftPaneMouseDown" />

                    <!-- All session views live in one panel and only change column, so moving a tab never reconnects it -->
                    <ItemsControl Grid.Row="1" Grid.ColumnSpan="3" ItemsSource="{Binding Sessions}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{Binding PaneGapWidth}" />
                                        <ColumnDefinition Width="{Binding RightPaneWidth}" />
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Grid.Column" Value="{Binding Column}" />
                                <Setter Property="Margin" Value="1,0,1,1" />
                                <Setter Property="Visibility" Value="{Binding IsActive, Converter={StaticResource BoolVis}}" />
                                <EventSetter Event="GotKeyboardFocus" Handler="OnSessionFocus" />
                                <EventSetter Event="PreviewMouseDown" Handler="OnSessionMouseDown" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </Grid>
            </Grid>

            <!-- Team chat: a column of its own right of the sessions, so it never covers an RDP tab -->
            <Border Grid.Column="3" Width="330" BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0"
                    Visibility="{Binding Chat.IsOpen, Converter={StaticResource BoolVis}}">
                <views:ChatPanel x:Name="ChatPanel" DataContext="{Binding Chat}" />
            </Border>

            <!-- Connection notices: bottom-right, above the status bar. A popup, so it also shows over RDP tabs. -->
            <Popup x:Name="NoticePopup" AllowsTransparency="True" Placement="Custom" StaysOpen="True" Focusable="False">
                <StackPanel Width="340">
                <!-- Chat messages for you while the chat is closed (or showing another conversation) -->
                <ItemsControl ItemsSource="{Binding Chat.Toasts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,8,0,0" Background="{StaticResource Panel}" BorderBrush="{StaticResource ButtonBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius}"
                                    Cursor="Hand" MouseLeftButtonUp="OnChatToastClick">
                                <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.45" Color="Black" /></Border.Effect>
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="3" Background="{StaticResource Accent}" CornerRadius="3,0,0,3" />
                                    <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="14" Background="{Binding Color}" VerticalAlignment="Top" Margin="10,9,0,0">
                                        <TextBlock Text="{Binding Initials}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Bg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Margin="10,8,8,8">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="✕" FontSize="10" Padding="4,0" MinHeight="18"
                                                    ToolTip="Dismiss" AutomationProperties.Name="Dismiss message"
                                                    Command="{Binding DataContext.Chat.DismissToastCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                            <TextBlock Text="{Binding Sender}" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Where}" Style="{StaticResource MutedText}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxHeight="54" TextTrimming="CharacterEllipsis" Margin="0,3,0,4" />
                                        <Button Content="Reply" Style="{StaticResource FlatButton}" Foreground="{StaticResource Accent}" Padding="0" HorizontalAlignment="Left"
                                                Command="{Binding DataContext.Chat.OpenToastCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Notices}" Width="340" Margin="0,0,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="card" Margin="0,8,0,0" Background="{StaticResource Panel}" BorderBrush="{StaticResource ButtonBorder}" BorderThickness="1"
                                    CornerRadius="{StaticResource Radius}" MouseEnter="OnNoticeEnter" MouseLeave="OnNoticeLeave">
                                <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.45" Color="Black" /></Border.Effect>
                                <DockPanel>
                                    <Border x:Name="bar" DockPanel.Dock="Left" Width="3" Background="{StaticResource Bad}" CornerRadius="3,0,0,3" />
                                    <StackPanel Margin="10,8,8,8">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="✕" FontSize="10" Padding="4,0" MinHeight="18"
                                                    ToolTip="Dismiss" AutomationProperties.Name="Dismiss notice"
                                                    Command="{Binding DataContext.DismissNoticeCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Age}" Style="{StaticResource MutedText}" FontSize="11" Margin="6,0" VerticalAlignment="Center" />
                                            <Path x:Name="kind" Style="{StaticResource KindIcon}" Tag="{Binding KindTag}" Stroke="{StaticResource Bad}" Margin="0,0,7,0" />
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Problem.Why}" TextWrapping="Wrap" Margin="23,4,0,2" />
                                        <TextBlock Text="{Binding Problem.Hint}" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="23,0,0,4"
                                                   Visibility="{Binding HasHint, Converter={StaticResource BoolVis}}" />
                                        <StackPanel Orientation="Horizontal" Margin="17,2,0,0">
                                            <Button Style="{StaticResource FlatButton}" Content="Retry" Foreground="{StaticResource Accent}" Padding="6,0"
                                                    Visibility="{Binding CanRetry, Converter={StaticResource BoolVis}}"
                                                    Command="{Binding DataContext.RetryNoticeCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource FlatButton}" Content="Edit entry" Foreground="{StaticResource Accent}" Padding="6,0"
                                                    Visibility="{Binding CanEdit, Converter={StaticResource BoolVis}}"
                                                    Command="{Binding DataContext.EditNoticeEntryCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource FlatButton}" Content="Details" Foreground="{StaticResource Accent}" Padding="6,0"
                                                    Visibility="{Binding HasDetails, Converter={StaticResource BoolVis}}"
                                                    Command="{Binding DataContext.NoticeDetailsCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <!-- A notice's own buttons (Join / Not now on a shared-session invite) -->
                                        <ItemsControl ItemsSource="{Binding Actions}" Margin="21,4,0,0" Visibility="{Binding HasActions, Converter={StaticResource BoolVis}}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button x:Name="b" Content="{Binding Label}" Command="{Binding Command}" MinHeight="22" Padding="10,0" Margin="0,0,6,0" />
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Primary}" Value="True"><Setter TargetName="b" Property="Style" Value="{StaticResource PrimaryButton}" /></DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                    <Setter TargetName="bar" Property="Background" Value="{StaticResource Warn}" />
                                    <Setter TargetName="kind" Property="Stroke" Value="{StaticResource Warn}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFaded}" Value="True">
                                    <Setter TargetName="card" Property="Opacity" Value="0.35" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
            </Popup>
        </Grid>
    </DockPanel>
    </Border>
</Window>
