<Window x:Class="RemoteMan.App.Views.ZabbixLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Link to Zabbix host" Width="620" Height="560" MinWidth="460" MinHeight="380"
        Style="{StaticResource RemoteManWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisZ" />
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Height="28" Background="{StaticResource Header}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <TextBlock x:Name="Heading" Margin="10,0" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Header}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="10,8">
            <DockPanel>
                <TextBlock Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Text="The link is saved on the entry, so everyone on this data source sees the same health." />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="OkButton" Content="OK" MinWidth="76" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="OnOk" />
                    <Button Content="Cancel" MinWidth="76" Margin="6,0,0,0" IsCancel="True" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Background="{StaticResource Panel}" Margin="0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Margin="12,10,12,0" Padding="10,8" Background="#1A1E22" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <Button x:Name="UnlinkButton" DockPanel.Dock="Right" Content="Unlink" MinWidth="70" Click="OnUnlink" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="Linked Zabbix host" Style="{StaticResource Muted}" FontSize="11" />
                        <TextBlock x:Name="Current" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid Grid.Row="1" Margin="12,10,12,0">
                <TextBox x:Name="SearchBox" Height="28" Padding="24,0,6,0" VerticalContentAlignment="Center" TextChanged="OnSearch"
                         AutomationProperties.Name="Search Zabbix hosts" />
                <Path Data="M9,5 A4,4 0 1 1 1,5 A4,4 0 1 1 9,5 Z M8,8 L11,11" Stroke="{StaticResource Faint}" StrokeThickness="1.4"
                      Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" />
                <TextBlock x:Name="SearchHint" Text="Search Zabbix hosts by name, IP or group" Foreground="{StaticResource Faint}" Margin="26,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
            <Grid Grid.Row="2" Margin="22,10,22,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="HOST" FontSize="10" FontWeight="SemiBold" Style="{StaticResource Muted}" />
                <TextBlock Grid.Column="2" Text="INTERFACE" FontSize="10" FontWeight="SemiBold" Style="{StaticResource Muted}" />
                <TextBlock Grid.Column="3" Text="GROUP" FontSize="10" FontWeight="SemiBold" Style="{StaticResource Muted}" />
            </Grid>
            <ListBox x:Name="Hosts" Grid.Row="3" Margin="12,0,12,12" Background="{StaticResource Panel2}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                     Foreground="{StaticResource Text}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="OnDoubleClick"
                     AutomationProperties.Name="Zabbix hosts" VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
                            <Path Style="{StaticResource HealthGlyph}" Tag="{Binding Tag}" HorizontalAlignment="Left">
                                <Path.LayoutTransform><ScaleTransform ScaleX="0.8" ScaleY="0.8" /></Path.LayoutTransform>
                            </Path>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Suggestion}" FontSize="10" Foreground="#7FD3C4"
                                           Visibility="{Binding HasSuggestion, Converter={StaticResource BoolVisZ}}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Address}" FontFamily="{StaticResource MonoFont}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{Binding Group}" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</Window>
