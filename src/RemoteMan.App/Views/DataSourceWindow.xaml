<Window x:Class="RemoteMan.App.Views.DataSourceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Data sources" Width="720" Height="480" Style="{StaticResource RemoteManWindow}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Header}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="10,8">
            <DockPanel>
                <TextBlock x:Name="TestResult" Foreground="{StaticResource Presence}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Test" MinWidth="76" Click="OnTest" />
                    <Button Content="Use and close" MinWidth="96" Margin="6,0,0,0" Style="{StaticResource PrimaryButton}" Click="OnUse" />
                    <Button Content="Cancel" MinWidth="76" Margin="6,0,0,0" IsCancel="True" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <DockPanel Background="{StaticResource Panel}">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="6">
                    <Button Content="Add" Click="OnAdd" />
                    <Button Content="Remove" Margin="6,0,0,0" Click="OnRemove" />
                </StackPanel>
                <ListBox x:Name="List" DisplayMemberPath="Name" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}" SelectionChanged="OnSelect" />
            </DockPanel>
            <StackPanel Grid.Column="1" Margin="12,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                    <TextBlock Text="Name" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    <TextBox x:Name="NameBox" Grid.Column="1" Margin="0,2" />
                    <TextBlock Grid.Row="1" Text="Type" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    <ComboBox x:Name="KindBox" Grid.Row="1" Grid.Column="1" Margin="0,2" Width="200" HorizontalAlignment="Left" SelectionChanged="OnKindChanged" />
                    <TextBlock Grid.Row="2" Text="Servers" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                    <TextBox x:Name="ConnBox" Grid.Row="2" Grid.Column="1" Margin="0,2" Height="110" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalContentAlignment="Top" FontFamily="{StaticResource MonoFont}" FontSize="11" />
                    <TextBlock Grid.Row="3" Text="Vault passphrase" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    <PasswordBox x:Name="VaultBox" Grid.Row="3" Grid.Column="1" Margin="0,2" ToolTip="Shared by everyone on this data source; encrypts passwords and keys" />
                </Grid>
                <TextBlock x:Name="Hint" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="120,8,0,0" FontSize="11" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
