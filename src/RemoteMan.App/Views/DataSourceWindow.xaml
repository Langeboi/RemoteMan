<Window x:Class="RemoteMan.App.Views.DataSourceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RemoteMan.App"
        Title="Data sources" Width="860" Height="560" MinWidth="720" MinHeight="460" Style="{StaticResource RemoteManWindow}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <local:NullToCollapsedConverter x:Key="NullVis" />
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Header}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="10,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="Test" MinWidth="76" Click="OnTest" />
                    <Button Content="Use and close" MinWidth="96" Margin="6,0,0,0" Style="{StaticResource PrimaryButton}" Click="OnUse" />
                    <Button Content="Cancel" MinWidth="76" Margin="6,0,0,0" IsCancel="True" />
                </StackPanel>
                <TextBlock x:Name="TestResult" Foreground="{StaticResource Presence}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <DockPanel Background="{StaticResource Panel}">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="6">
                    <Button Content="Add" Click="OnAdd" />
                    <Button x:Name="RemoveButton" Content="Remove" Margin="6,0,0,0" Click="OnRemove" />
                </StackPanel>
                <!-- RemoteMan account: its workspaces are listed with the other data sources -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="8,8,8,2">
                    <StackPanel>
                        <TextBlock x:Name="AccountText" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
                        <Button x:Name="AccountButton" Margin="0,6,0,0" HorizontalAlignment="Left" Click="OnAccount" />
                    </StackPanel>
                </Border>
                <ListBox x:Name="List" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}" SelectionChanged="OnSelect">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="{Binding Hosted.AccessLabel, StringFormat=RemoteMan · {0}}" FontSize="10.5" Foreground="{StaticResource Faint}"
                                           Visibility="{Binding Hosted, Converter={StaticResource NullVis}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <DockPanel Grid.Column="1">
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="10,6,10,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ConnectionTab" GroupName="dsTab" Style="{StaticResource PanelTab}" IsChecked="True" Height="26" Checked="OnTabChanged">
                            <TextBlock Text="Connection" Margin="12,0" />
                        </RadioButton>
                        <RadioButton x:Name="UsersTab" GroupName="dsTab" Style="{StaticResource PanelTab}" Height="26" Checked="OnTabChanged"
                                     ToolTip="Database logins for your team (PostgreSQL, admins only)">
                            <TextBlock x:Name="UsersTabLabel" Text="Users" Margin="12,0" />
                        </RadioButton>
                    </StackPanel>
                </Border>

                <Grid>
                    <!-- Connection -->
                    <StackPanel x:Name="ConnectionPanel" Margin="12,10">
                        <!-- A workspace from the RemoteMan account: the server manages its connection -->
                        <Border x:Name="HostedPanel" Visibility="Collapsed" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4"
                                Background="{StaticResource Panel}" Padding="12,10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="HostedTitle" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                                <TextBlock x:Name="HostedText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Grid x:Name="ConnectionGrid">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <TextBlock Text="Name" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <TextBox x:Name="NameBox" Grid.Column="1" Margin="0,2" />
                            <TextBlock Grid.Row="1" Text="Type" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <ComboBox x:Name="KindBox" Grid.Row="1" Grid.Column="1" Margin="0,2" Width="200" HorizontalAlignment="Left" SelectionChanged="OnKindChanged" />
                            <TextBlock Grid.Row="2" Text="Servers" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                            <TextBox x:Name="ConnBox" Grid.Row="2" Grid.Column="1" Margin="0,2" Height="110" AcceptsReturn="True" TextWrapping="NoWrap"
                                     VerticalContentAlignment="Top" FontFamily="{StaticResource MonoFont}" FontSize="11" />
                            <TextBlock Grid.Row="3" Text="Vault passphrase" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <PasswordBox x:Name="VaultBox" Grid.Row="3" Grid.Column="1" Margin="0,2" ToolTip="Shared by everyone on this data source; encrypts passwords and keys" />
                            <CheckBox x:Name="SsoBox" Grid.Row="4" Grid.Column="1" Margin="0,6,0,2" Content="Use my Windows login (SSO)"
                                      ToolTip="Sign in to the database as the current Windows user (Kerberos/NTLM). User and password in the server lines are ignored." />
                            <TextBlock Grid.Row="5" Text="Gateway site" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,2">
                                <TextBox x:Name="GatewayBox" Width="140" ToolTip="A site on your RemoteMan gateway relay (More > Gateway settings). Empty = the relay's only site when it has just one. The database is tried directly first either way." />
                                <CheckBox x:Name="GatewayAlwaysBox" Content="Always (skip the direct try)" Margin="10,0,0,0" VerticalAlignment="Center"
                                          ToolTip="Off: each connection tries the servers directly first and uses the gateway only when they don't answer (off-site)." />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="Hint" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="120,8,0,0" FontSize="11" />
                    </StackPanel>

                    <!-- Users -->
                    <DockPanel x:Name="UsersPanel" Margin="12,10" Visibility="Collapsed">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="SignedInText" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                <Border x:Name="SignedInPill" Margin="8,0,0,0" BorderThickness="1" CornerRadius="3" Padding="6,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock x:Name="SignedInPillText" FontSize="11" />
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="ServerDots" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" />
                        </DockPanel>

                        <Grid>
                            <!-- Admin: the list of logins -->
                            <DockPanel x:Name="AdminView" Visibility="Collapsed">
                                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="Logins live in the database, so the standby gets every change by itself. Removing a login closes their open connections; their name stays on what they changed." />
                                <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                    <Button Content="Add login…" MinWidth="90" Style="{StaticResource PrimaryButton}" Click="OnAddLogin" />
                                    <Button x:Name="ResetButton" Content="Reset password…" Margin="6,0,0,0" Click="OnResetPassword" />
                                    <Button x:Name="AccessButton" Content="Change access ▾" Margin="6,0,0,0" Click="OnChangeAccess">
                                        <Button.ContextMenu>
                                            <ContextMenu x:Name="AccessMenu">
                                                <MenuItem Header="Read only" Tag="ReadOnly" Click="OnAccessPicked" ToolTip="Sees everything and connects, can't change entries" />
                                                <MenuItem Header="Can edit" Tag="Edit" Click="OnAccessPicked" ToolTip="Adds and changes entries, folders and credentials" />
                                                <MenuItem Header="Admin" Tag="Admin" Click="OnAccessPicked" ToolTip="Can edit, and manages logins" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                    <Button x:Name="EnableButton" Content="Disable" Margin="6,0,0,0" Click="OnToggleEnabled" />
                                    <Button x:Name="RemoveLoginButton" Content="Remove" Margin="6,0,0,0" Foreground="{StaticResource Bad}" Click="OnRemoveLogin" />
                                    <Button Content="Refresh" Margin="18,0,0,0" Click="OnRefreshUsers" />
                                </WrapPanel>
                                <Border BorderBrush="{StaticResource Border}" BorderThickness="1" Background="{StaticResource Work}" Grid.IsSharedSizeScope="True">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1" Padding="8,4">
                                            <Grid TextElement.Foreground="{StaticResource Faint}" TextElement.FontSize="11">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="90" /><ColumnDefinition Width="120" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1" Text="LOGIN" />
                                                <TextBlock Grid.Column="2" Text="ACCESS" />
                                                <TextBlock Grid.Column="3" Text="ONLINE" />
                                                <TextBlock Grid.Column="4" Text="LAST CHANGE" />
                                            </Grid>
                                        </Border>
                                        <ListBox x:Name="LoginList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                                                 HorizontalContentAlignment="Stretch" SelectionChanged="OnLoginSelected" MouseDoubleClick="OnLoginDoubleClick">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Height="26">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="90" /><ColumnDefinition Width="120" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="20" Height="20" CornerRadius="10" Background="{Binding AvatarBrush}" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding Initials}" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource Bg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" Foreground="{Binding NameBrush}" />
                                                            <TextBlock Text="{Binding Note}" Margin="6,0,0,0" FontSize="11" Foreground="{StaticResource Faint}" />
                                                        </StackPanel>
                                                        <Border Grid.Column="2" BorderThickness="1" CornerRadius="3" Padding="6,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                BorderBrush="{Binding AccessBrush}">
                                                            <TextBlock Text="{Binding AccessLabel}" FontSize="11" Foreground="{Binding AccessBrush}" />
                                                        </Border>
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Ellipse Width="7" Height="7" Fill="{Binding OnlineBrush}" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding OnlineText}" Foreground="{StaticResource Muted}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="4" Text="{Binding LastChangeText}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Border>
                            </DockPanel>

                            <!-- Everything else: not PostgreSQL, not an admin, server needs the update, can't connect -->
                            <StackPanel x:Name="MessageView" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                                <TextBlock x:Name="MessageTitle" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" TextAlignment="Center" TextWrapping="Wrap" />
                                <TextBlock x:Name="MessageText" Style="{StaticResource MutedText}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <TextBox x:Name="MessageCode" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="0,10,0,0" Visibility="Collapsed" />
                                <Button x:Name="MessageButton" HorizontalAlignment="Center" Margin="0,12,0,0" MinWidth="120" Visibility="Collapsed" Click="OnMessageButton" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
