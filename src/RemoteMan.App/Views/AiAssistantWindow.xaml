<Window x:Class="RemoteMan.App.Views.AiAssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ai="clr-namespace:RemoteMan.Core.Ai;assembly=RemoteMan.Core"
        xmlns:vm="clr-namespace:RemoteMan.App.ViewModels"
        Title="AI assistant" Width="420" Height="600"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="True"
        Background="{Binding Theme.Background}" Foreground="{Binding Theme.Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!-- Borderless, but keeps the system drop shadow (no layered window, so WebView2 can render inside). -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <!-- A button whose look comes entirely from its properties; corner radius via Tag. -->
        <Style x:Key="AiButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{Binding DataContext.Theme.Text, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.82" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SetupInput" TargetType="Control">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource Bg}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="SetupPassword" TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Background" Value="{StaticResource Bg}" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!-- Read-only, selectable text that looks like a TextBlock. -->
        <Style x:Key="SelectableText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Focusable="False" /></ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One piece of a reply: prose, or a code block with Copy / Paste to terminal -->
        <DataTemplate x:Key="SegmentTemplate" DataType="{x:Type ai:ReplySegment}">
            <ContentControl Focusable="False" Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <TextBox Style="{StaticResource SelectableText}" Text="{Binding Text, Mode=OneWay}" Margin="0,0,0,6"
                                             Foreground="{Binding DataContext.Theme.Text, RelativeSource={RelativeSource AncestorType=Window}}"
                                             FontFamily="{Binding DataContext.Theme.ReplyFont, RelativeSource={RelativeSource AncestorType=Window}}"
                                             FontSize="{Binding DataContext.Theme.ReplySize, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCode}" Value="True">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <Border Margin="0,2,0,8" BorderThickness="1" ClipToBounds="True"
                                                    BorderBrush="{Binding DataContext.Theme.Line, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Background="{Binding DataContext.Theme.Code, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CornerRadius="{Binding DataContext.Theme.SmallRadius, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Top" Height="26" Padding="10,0,4,0"
                                                            Background="{Binding DataContext.Theme.Header, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CornerRadius="{Binding DataContext.Theme.SmallRadius, RelativeSource={RelativeSource AncestorType=Window}}">
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right" Style="{StaticResource AiButton}" Height="20" Margin="4,0,0,0" FontSize="11"
                                                                    Content="{Binding DataContext.PasteLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    IsEnabled="{Binding DataContext.CanPaste, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    ToolTip="Types the command into the terminal without pressing Enter"
                                                                    BorderBrush="{Binding DataContext.Theme.Line, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    Tag="{Binding DataContext.Theme.SmallRadius, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    Command="{Binding DataContext.PasteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Text}" />
                                                            <Button DockPanel.Dock="Right" Style="{StaticResource AiButton}" Height="20" FontSize="11" Content="Copy"
                                                                    BorderBrush="{Binding DataContext.Theme.Line, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    Tag="{Binding DataContext.Theme.SmallRadius, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Text}" />
                                                            <TextBlock Text="{Binding Language, TargetNullValue=code}" FontSize="11" VerticalAlignment="Center"
                                                                       Foreground="{Binding DataContext.Theme.Muted, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        </DockPanel>
                                                    </Border>
                                                    <TextBox Style="{StaticResource SelectableText}" Text="{Binding Text, Mode=OneWay}" Margin="10,8" TextWrapping="Wrap"
                                                             FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="#D6D6D6" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </DataTemplate>

        <DataTemplate x:Key="MessageTemplate" DataType="{x:Type vm:AiChatMessage}">
            <ContentControl Focusable="False" Content="{Binding}" Margin="0,0,0,12">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <!-- Assistant: optional avatar + segments -->
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Top"
                                                Visibility="{Binding DataContext.Theme.ShowAvatar, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}"
                                                Background="{Binding DataContext.Theme.Accent, RelativeSource={RelativeSource AncestorType=Window}}" CornerRadius="11">
                                            <TextBlock Text="{Binding DataContext.ActiveMonogram, RelativeSource={RelativeSource AncestorType=Window}}" FontFamily="{StaticResource MonoFont}" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="{Binding DataContext.Theme.AccentText, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Grid>
                                            <ItemsControl ItemsSource="{Binding Segments}" ItemTemplate="{StaticResource SegmentTemplate}" Focusable="False" />
                                            <TextBlock Text="…" Foreground="{Binding DataContext.Theme.Muted, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers><DataTrigger Binding="{Binding Text}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DockPanel>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <Border HorizontalAlignment="Right" MaxWidth="320" Padding="12,8"
                                                    Background="{Binding DataContext.Theme.UserBubble, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CornerRadius="{Binding DataContext.Theme.Radius, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <TextBox Style="{StaticResource SelectableText}" Text="{Binding Text, Mode=OneWay}"
                                                         Foreground="{Binding DataContext.Theme.UserText, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12.5" />
                                            </Border>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <TextBox Style="{StaticResource SelectableText}" Text="{Binding Text, Mode=OneWay}" Foreground="{StaticResource Warn}" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </DataTemplate>
    </Window.Resources>

    <Border BorderThickness="1" BorderBrush="{Binding Theme.Line}">
        <Grid>
            <!-- ============ Pick a provider ============ -->
            <DockPanel Background="{StaticResource Panel}" Visibility="{Binding IsPickPage, Converter={StaticResource BoolVis}}">
                <Border DockPanel.Dock="Top" Height="30" Background="{StaticResource Header}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                    <DockPanel Margin="10,0,4,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="×" ToolTip="Close (Esc)" AutomationProperties.Name="Close" Click="OnHide" />
                        <Button DockPanel.Dock="Left" Style="{StaticResource FlatButton}" Content="‹" Margin="-6,0,4,0" ToolTip="Back" AutomationProperties.Name="Back"
                                Command="{Binding BackCommand}" Visibility="{Binding IsConnected, Converter={StaticResource BoolVis}}" />
                        <TextBlock Text="Set up AI assistant" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <TextBlock DockPanel.Dock="Top" Margin="10,10,10,6" TextWrapping="Wrap" Style="{StaticResource MutedText}"
                           Text="Pick a provider. You can add more later and switch between them from the chat header." />
                <ItemsControl ItemsSource="{Binding Catalog}" Margin="0,2,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type ai:AiProviderInfo}">
                            <Button Style="{StaticResource FlatButton}" Height="44" Padding="10,0" HorizontalContentAlignment="Stretch"
                                    Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Name}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="22" Height="22" BorderThickness="1" BorderBrush="{StaticResource ButtonBorder}" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Monogram}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock DockPanel.Dock="Right" Text="›" Foreground="{StaticResource Faint}" VerticalAlignment="Center" FontSize="14" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextStrong}" />
                                        <TextBlock Text="{Binding Vendor}" Style="{StaticResource MutedText}" FontSize="11" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <!-- ============ Sign in ============ -->
            <DockPanel Background="{StaticResource Panel}" Visibility="{Binding IsAuthPage, Converter={StaticResource BoolVis}}">
                <Border DockPanel.Dock="Top" Height="30" Background="{StaticResource Header}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                    <DockPanel Margin="4,0">
                        <Button DockPanel.Dock="Left" Style="{StaticResource FlatButton}" Content="‹" ToolTip="Back" AutomationProperties.Name="Back" Command="{Binding BackCommand}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="×" ToolTip="Close (Esc)" AutomationProperties.Name="Close" Click="OnHide" />
                        <TextBlock Text="{Binding SetupProvider.Name}" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" VerticalAlignment="Center" Margin="4,0" />
                    </DockPanel>
                </Border>
                <StackPanel Margin="12,10,12,12">
                    <!-- API key / account sign-in -->
                    <Border BorderBrush="{StaticResource Border}" BorderThickness="1" Margin="0,0,0,12" Visibility="{Binding SetupHasModes, Converter={StaticResource BoolVis}}">
                        <UniformGrid Columns="2">
                            <ToggleButton Content="API key" Height="24" IsChecked="{Binding IsKeyMode, Mode=OneWay}" Command="{Binding UseKeyModeCommand}" />
                            <ToggleButton Content="Account sign-in" Height="24" IsChecked="{Binding IsAccountModeSelected, Mode=OneWay}" Command="{Binding UseAccountModeCommand}" />
                        </UniformGrid>
                    </Border>

                    <StackPanel Visibility="{Binding SetupShowKeyForm, Converter={StaticResource BoolVis}}">
                        <StackPanel Visibility="{Binding SetupShowEndpoint, Converter={StaticResource BoolVis}}" Margin="0,0,0,8">
                            <TextBlock Text="Server address" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource SetupInput}" Text="{Binding SetupEndpoint, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Server address" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding SetupShowKey, Converter={StaticResource BoolVis}}" Margin="0,0,0,8">
                            <TextBlock Text="{Binding SetupFieldLabel}" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                            <PasswordBox x:Name="KeyBox" Style="{StaticResource SetupPassword}" AutomationProperties.Name="API key" KeyDown="OnKeyBoxKeyDown" />
                        </StackPanel>
                        <TextBlock Text="Model" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                        <ComboBox IsEditable="True" Height="24" Text="{Binding SetupModel, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding SetupModels}"
                                  AutomationProperties.Name="Model" FontFamily="{StaticResource MonoFont}" FontSize="11" />
                        <TextBlock Text="{Binding SetupKeyNote}" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding SetupShowAccountForm, Converter={StaticResource BoolVis}}">
                        <TextBlock TextWrapping="Wrap" LineHeight="17">
                            Opens the provider's own chat page in this box. You sign in with your normal account and subscription, and stay signed in until you sign out here.
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Warn}" FontSize="11" Margin="0,8,0,0" LineHeight="16">
                            Limited: the assistant cannot see your sessions, and Paste to terminal is off. For that, use an API key.
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Text="{Binding SetupError}" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,10,0,0" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <TextBlock Text="Checking…" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Visibility="{Binding IsConnecting, Converter={StaticResource BoolVis}}" />
                        <Button Content="Cancel" Margin="0,0,6,0" Click="OnHide" />
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ConnectCommand}" IsDefault="True">
                            <Button.Content>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Connect" />
                                            <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
                                            <Style.Triggers><DataTrigger Binding="{Binding IsAccountModeSelected}" Value="True"><Setter Property="Text" Value="Sign in" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- ============ Chat ============ -->
            <DockPanel Visibility="{Binding IsChatPage, Converter={StaticResource BoolVis}}" Background="{Binding Theme.Background}">
                <!-- header -->
                <Border DockPanel.Dock="Top" Height="40" Padding="8,0,6,0" Background="{Binding Theme.Header}" BorderBrush="{Binding Theme.Line}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button x:Name="ProviderButton" DockPanel.Dock="Left" Style="{StaticResource AiButton}" Height="28" Tag="{Binding Theme.SmallRadius}"
                                Command="{Binding ToggleProviderMenuCommand}" AutomationProperties.Name="Switch provider">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="18" Height="18" Background="{Binding Theme.Accent}" CornerRadius="{Binding Theme.MarkRadius}" Margin="0,0,7,0">
                                    <TextBlock Text="{Binding ActiveMonogram}" FontFamily="{StaticResource MonoFont}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding Theme.AccentText}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding ActiveName}" FontWeight="SemiBold" FontSize="13" FontFamily="{Binding Theme.TitleFont}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ActiveModel}" Foreground="{Binding Theme.Muted}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                <Path Data="M0,0 L4,4 L8,0" Stroke="{Binding Theme.Muted}" StrokeThickness="1.5" Margin="7,2,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource AiButton}" Width="28" Height="28" Padding="0" Tag="{Binding Theme.SmallRadius}"
                                Foreground="{Binding Theme.Muted}" ToolTip="Back to standby (Esc)" AutomationProperties.Name="Back to standby" Click="OnHide">
                            <Path Data="M0,0 H10" Stroke="{Binding Theme.Muted}" StrokeThickness="1.6" />
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource AiButton}" Width="28" Height="28" Padding="0" Tag="{Binding Theme.SmallRadius}"
                                ToolTip="New chat" AutomationProperties.Name="New chat" Command="{Binding NewChatCommand}"
                                Visibility="{Binding ShowConversation, Converter={StaticResource BoolVis}}">
                            <Path Data="M5,0 V10 M0,5 H10" Stroke="{Binding Theme.Muted}" StrokeThickness="1.6" />
                        </Button>
                        <Rectangle />
                    </DockPanel>
                </Border>

                <Popup IsOpen="{Binding ProviderMenuOpen}" StaysOpen="False" PlacementTarget="{Binding ElementName=ProviderButton}" Placement="Bottom" VerticalOffset="4"
                       AllowsTransparency="True" Closed="OnProviderMenuClosed">
                    <Border Width="250" Padding="4" Background="{Binding Theme.Header}" BorderBrush="{Binding Theme.Line}" BorderThickness="1" CornerRadius="{Binding Theme.SmallRadius}" Margin="0,0,8,8">
                        <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.5" /></Border.Effect>
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Connected}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ai:AiProviderConfig}">
                                        <Button Style="{StaticResource AiButton}" Height="30" HorizontalContentAlignment="Stretch"
                                                Tag="{Binding DataContext.Theme.SmallRadius, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Command="{Binding DataContext.UseProviderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                Foreground="{Binding DataContext.Theme.Text, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Info.Monogram}" Width="22" FontFamily="{StaticResource MonoFont}" FontSize="10" VerticalAlignment="Center" Opacity="0.7" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding EffectiveModel}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Info.Name}" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Rectangle Height="1" Fill="{Binding Theme.Line}" Margin="0,4" />
                            <Button Style="{StaticResource AiButton}" Height="28" HorizontalContentAlignment="Left" Content="Add provider…" Tag="{Binding Theme.SmallRadius}" Command="{Binding AddProviderCommand}" Foreground="{Binding Theme.Text}" />
                            <Button Style="{StaticResource AiButton}" Height="28" HorizontalContentAlignment="Left" Tag="{Binding Theme.SmallRadius}" Command="{Binding SignOutCommand}" Foreground="{Binding Theme.Text}">
                                <TextBlock><Run Text="Sign out of " /><Run Text="{Binding ActiveName, Mode=OneWay}" /></TextBlock>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- session context -->
                <Border DockPanel.Dock="Top" MinHeight="32" Padding="10,0" BorderBrush="{Binding Theme.Line}" BorderThickness="0,0,0,1"
                        Visibility="{Binding ShowConversation, Converter={StaticResource BoolVis}}">
                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Left" IsChecked="{Binding IncludeContext}" IsEnabled="{Binding HasSession}" Height="22" Padding="8,0" Cursor="Hand"
                                      ToolTip="Send this session's recent output with your message" AutomationProperties.Name="Include session context">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="b" BorderThickness="1" Padding="{TemplateBinding Padding}" BorderBrush="{Binding Theme.Line}"
                                            CornerRadius="{Binding Theme.InputRadius}">
                                        <TextBlock x:Name="t" Text="{Binding ContextLabel}" FontSize="11" VerticalAlignment="Center" Foreground="{Binding Theme.Muted}" TextDecorations="Strikethrough" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="b" Property="BorderBrush" Value="{Binding Theme.Accent}" />
                                            <Setter TargetName="t" Property="Foreground" Value="{Binding Theme.Text}" />
                                            <Setter TargetName="t" Property="TextDecorations" Value="{x:Null}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="t" Property="TextDecorations" Value="{x:Null}" />
                                            <Setter TargetName="b" Property="Opacity" Value="0.6" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <TextBlock Text="{Binding ContextNote}" Foreground="{Binding Theme.Muted}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>

                <!-- composer -->
                <StackPanel DockPanel.Dock="Bottom" Margin="10,8,10,6" Visibility="{Binding ShowConversation, Converter={StaticResource BoolVis}}">
                    <Border Background="{Binding Theme.ComposerBackground}" BorderBrush="{Binding Theme.Line}" BorderThickness="1" CornerRadius="{Binding Theme.InputRadius}" Padding="12,5,5,5">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" VerticalAlignment="Bottom" Style="{StaticResource AiButton}" Width="30" Height="30" Padding="0"
                                    Background="{Binding Theme.Accent}" Foreground="{Binding Theme.AccentText}" Tag="{Binding Theme.SendRadius}"
                                    Command="{Binding SendCommand}" AutomationProperties.Name="Send" ToolTip="Send (Enter)">
                                <Path Data="M5,10 V0 M0,5 L5,0 L10,5" Stroke="{Binding Theme.AccentText}" StrokeThickness="1.8" />
                            </Button>
                            <Button DockPanel.Dock="Right" VerticalAlignment="Bottom" Style="{StaticResource AiButton}" Height="30" Margin="0,0,6,0" Content="Stop"
                                    Tag="{Binding Theme.SmallRadius}" BorderBrush="{Binding Theme.Line}" Command="{Binding StopCommand}"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" />
                            <Grid>
                                <TextBox x:Name="Composer" Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120"
                                         VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Foreground="{Binding Theme.Text}" CaretBrush="{Binding Theme.Text}"
                                         FontSize="12.5" VerticalContentAlignment="Center" MinHeight="30" PreviewKeyDown="OnComposerKeyDown" AutomationProperties.Name="Message" />
                                <TextBlock Text="{Binding Placeholder}" Foreground="{Binding Theme.Muted}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="2,0" FontSize="12.5">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Composer}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <TextBlock Text="{Binding Theme.Footnote}" Foreground="{Binding Theme.Muted}" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0" />
                </StackPanel>

                <Grid>
                    <!-- conversation -->
                    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="12,12,12,0" ScrollChanged="OnScrollChanged"
                                  Visibility="{Binding ShowConversation, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}" Margin="0,40,0,0">
                                <TextBlock Text="{Binding Theme.Greeting}" FontFamily="{Binding Theme.TitleFont}" FontSize="20" Foreground="{Binding Theme.GreetingForeground}" Margin="0,0,0,12" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Suggestions}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource AiButton}" MinHeight="30" Margin="0,0,0,6" Padding="12,6" HorizontalContentAlignment="Left" Content="{Binding}"
                                                    BorderBrush="{Binding DataContext.Theme.Line, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Tag="{Binding DataContext.Theme.SmallRadius, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Command="{Binding DataContext.AskCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Messages}" ItemTemplate="{StaticResource MessageTemplate}" Focusable="False" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- account sign-in: the provider's own page -->
                    <ContentControl x:Name="AccountHost" Focusable="False" Visibility="{Binding ShowAccountView, Converter={StaticResource BoolVis}}" />
                </Grid>
            </DockPanel>
        </Grid>
    </Border>
</Window>
