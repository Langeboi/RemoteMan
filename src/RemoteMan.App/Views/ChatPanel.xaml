<!-- Team chat drawer on the right of the main window: a contact list (groups, then people), and one conversation at a time.
     A plain column next to the sessions (no overlay), so it can stay open beside an RDP tab. No effects or transparency here (airspace). -->
<UserControl x:Class="RemoteMan.App.Views.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RemoteMan.App.ViewModels"
             xmlns:views="clr-namespace:RemoteMan.App.Views"
             xmlns:local="clr-namespace:RemoteMan.App"
             Background="{StaticResource Panel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <local:EmptyToCollapsedConverter x:Key="NonEmptyVis" />

        <!-- Icons for links: the protocol icons, plus folders, snippets and config backups -->
        <Style x:Key="ChatKindIcon" TargetType="Path" BasedOn="{StaticResource KindIcon}">
            <Style.Triggers>
                <Trigger Property="Tag" Value="SNIP"><Setter Property="Data" Value="M2,4 L6,8 L2,12 M8,12.5 H14" /><Setter Property="Stroke" Value="{StaticResource Muted}" /></Trigger>
                <Trigger Property="Tag" Value="OX"><Setter Property="Data" Value="M2.5,3.5 h11 v9 h-11 z M5,6.5 h6 M5,9.5 h4" /><Setter Property="Stroke" Value="{StaticResource Warn}" /></Trigger>
                <Trigger Property="Tag" Value=""><Setter Property="Data" Value="M8,2 A6,6 0 1 1 7.99,2 M8,5 V8.5 M8,11 V11.2" /><Setter Property="Stroke" Value="{StaticResource Faint}" /></Trigger>
            </Style.Triggers>
        </Style>

        <!-- An inline link: icon + current name, like a small tag. Grey and struck through when the entry is gone. -->
        <Style x:Key="ChatChip" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Link}" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{StaticResource SelectRow}" BorderBrush="{StaticResource Depth.ButtonBorder}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius}" Padding="3,0,6,0" Height="20">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource ChatKindIcon}" Tag="{Binding Tag}" Margin="0,0,3,0">
                                    <Path.LayoutTransform><ScaleTransform ScaleX="0.8" ScaleY="0.8" /></Path.LayoutTransform>
                                </Path>
                                <TextBlock x:Name="t" Text="{Binding Label}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" FontSize="12" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
                            <DataTrigger Binding="{Binding Exists}" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Faint}" />
                                <Setter TargetName="t" Property="TextDecorations" Value="Strikethrough" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A row in the contact list -->
        <Style x:Key="ContactRow" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" Padding="12,7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Select}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Faint}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
            <Setter Property="Margin" Value="12,10,12,4" />
        </Style>

        <Style x:Key="UnreadBadge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="MinWidth" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Padding" Value="4,0" />
        </Style>

        <DataTemplate x:Key="ContactTemplate" DataType="{x:Type vm:ChatContact}">
            <Button Style="{StaticResource ContactRow}" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                    AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Title}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="32" Height="32" VerticalAlignment="Center">
                        <Border x:Name="av" CornerRadius="16" Background="{Binding Color}">
                            <TextBlock Text="{Binding Initials}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Bg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="grp" CornerRadius="16" Background="{StaticResource SelectRow}" BorderBrush="{StaticResource Depth.ButtonBorder}" BorderThickness="1" Visibility="Collapsed">
                            <TextBlock Text="{Binding Initials}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="dot" Width="10" Height="10" CornerRadius="5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1"
                                Background="{StaticResource Faint}" BorderBrush="{StaticResource Panel}" BorderThickness="2" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                        <TextBlock x:Name="name" Text="{Binding ShortTitle}" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="pv" Text="{Binding Preview}" Foreground="{StaticResource Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource Faint}" FontSize="11" HorizontalAlignment="Right" />
                        <Border Style="{StaticResource UnreadBadge}" HorizontalAlignment="Right" Margin="0,3,0,0" Visibility="{Binding HasUnread, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding Unread}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                    <Setter TargetName="av" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="grp" Property="Visibility" Value="Visible" />
                    <Setter TargetName="dot" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOnline}" Value="True"><Setter TargetName="dot" Property="Background" Value="{StaticResource Ok}" /></DataTrigger>
                <DataTrigger Binding="{Binding HasUnread}" Value="True"><Setter TargetName="pv" Property="Foreground" Value="{StaticResource Text}" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Message blocks: text with inline chips, or a card for a link on its own line -->
        <DataTemplate DataType="{x:Type vm:ChatTextBlock}">
            <TextBlock views:ChatInlines.Parts="{Binding Parts}" TextWrapping="Wrap" LineHeight="20" Foreground="{StaticResource Text}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChatCardBlock}">
            <Border Margin="0,4,0,2" Background="{StaticResource Depth.Card}" BorderBrush="{StaticResource Depth.CardBorder}" BorderThickness="{StaticResource Depth.CardBorderThickness}"
                    CornerRadius="4" DataContext="{Binding Link}">
                <Grid>
                    <Border Background="{StaticResource Depth.Sheen}" BorderBrush="{StaticResource Depth.HiLine}" BorderThickness="0,1,0,0" CornerRadius="4" IsHitTestVisible="False" />
                    <StackPanel>
                        <DockPanel Margin="10,8">
                            <Path DockPanel.Dock="Left" Style="{StaticResource ChatKindIcon}" Tag="{Binding Tag}" Margin="0,0,9,0" />
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <Border BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0" Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Connect" Style="{StaticResource PrimaryButton}" MinHeight="22" Margin="0,0,6,0" Command="{Binding ConnectCommand}"
                                        Visibility="{Binding CanConnect, Converter={StaticResource BoolVis}}" />
                                <Button Content="Show in tree" MinHeight="22" Command="{Binding OpenCommand}" ToolTip="{Binding ToolTip}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- ================= contact list ================= -->
        <DockPanel Visibility="{Binding IsListShown, Converter={StaticResource BoolVis}}">
            <Border DockPanel.Dock="Top" Height="36" Background="{StaticResource Depth.Header}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                <DockPanel Margin="12,0,4,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Width="26" Height="24" Padding="0" ToolTip="Close chat (Ctrl+Shift+M)"
                            AutomationProperties.Name="Close chat" Command="{Binding CloseCommand}">
                        <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" />
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Height="24" Padding="6,0" Margin="0,0,2,0" ToolTip="Make a group chat"
                            AutomationProperties.Name="New group" Command="{Binding NewGroupCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M5,0 V10 M0,5 H10" Stroke="{StaticResource Link}" StrokeThickness="1.4" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="New group" Foreground="{StaticResource Link}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Path Data="M1.5,2.5 H14.5 V10.5 H6 L3,13.5 V10.5 H1.5 Z" Stroke="{StaticResource Accent}" StrokeThickness="1.4" StrokeLineJoin="Round" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Chat" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding HeaderText}" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Top" Background="{StaticResource AccentDim}" Padding="12,6"
                    Visibility="{Binding PendingShareText, Converter={StaticResource NonEmptyVis}}">
                <TextBlock Text="{Binding PendingShareText}" Foreground="{StaticResource TextStrong}" TextWrapping="Wrap" />
            </Border>

            <Grid DockPanel.Dock="Top" Margin="10,8,10,4">
                <TextBox x:Name="FilterBox" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search people and groups" />
                <TextBlock Text="Search people and groups" Foreground="{StaticResource Faint}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Groups" Style="{StaticResource SectionLabel}" />
                    <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource ContactTemplate}" Focusable="False" />
                    <TextBlock Text="People" Style="{StaticResource SectionLabel}" />
                    <ItemsControl ItemsSource="{Binding People}" ItemTemplate="{StaticResource ContactTemplate}" Focusable="False" />
                    <TextBlock x:Name="NoPeople" Text="Nobody else here yet. People show up once they open RemoteMan on this database."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="12,4,12,0" FontSize="11.5" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- ================= one conversation ================= -->
        <DockPanel Visibility="{Binding IsRoomShown, Converter={StaticResource BoolVis}}">
            <Border DockPanel.Dock="Top" Height="44" Background="{StaticResource Depth.Header}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                <DockPanel Margin="2,0,4,0" DataContext="{Binding Current}">
                    <Button DockPanel.Dock="Left" Style="{StaticResource FlatButton}" Width="26" Height="28" Padding="0" ToolTip="Back to the list (Esc)"
                            AutomationProperties.Name="Back to contacts" Command="{Binding DataContext.BackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Path Data="M5,0 L0,5 L5,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" />
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Width="26" Height="24" Padding="0" ToolTip="Close chat (Ctrl+Shift+M)"
                            AutomationProperties.Name="Close chat" Command="{Binding DataContext.CloseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" />
                    </Button>
                    <Button x:Name="LeaveButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Height="24" Padding="6,0" Content="Leave" ToolTip="Leave this group"
                            Command="{Binding DataContext.LeaveGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Visibility="Collapsed" />
                    <Grid Width="28" Height="28" Margin="4,0,8,0" VerticalAlignment="Center">
                        <Border x:Name="hav" CornerRadius="14" Background="{Binding Color}">
                            <TextBlock Text="{Binding Initials}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Bg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="hgrp" CornerRadius="14" Background="{StaticResource SelectRow}" BorderBrush="{StaticResource Depth.ButtonBorder}" BorderThickness="1" Visibility="Collapsed">
                            <TextBlock Text="{Binding Initials}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding ShortTitle}" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                        <TextBlock Text="{Binding SubTitle}" Style="{StaticResource MutedText}" FontSize="11" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Composer: # opens the link picker; Enter sends, Shift+Enter is a new line; entries can be dropped here from the tree -->
            <Border x:Name="Composer" DockPanel.Dock="Bottom" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="10,8,10,10">
                <StackPanel>
                    <Grid>
                        <TextBox x:Name="Input" Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="40" MaxHeight="140" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="4,5"
                                 AutomationProperties.Name="Message" AllowDrop="True"
                                 PreviewKeyDown="OnInputKeyDown" TextChanged="OnInputTextChanged" SelectionChanged="OnInputSelectionChanged"
                                 PreviewDragOver="OnInputDragOver" PreviewDragEnter="OnInputDragOver" PreviewDrop="OnInputDrop" />
                        <TextBlock Text="Write a message. Type # to link an entry." Foreground="{StaticResource Faint}" IsHitTestVisible="False" Margin="9,7,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=Input}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="Send" Style="{StaticResource PrimaryButton}" MinHeight="22" Command="{Binding SendCommand}" />
                        <TextBlock Text="#  link     Enter  send     Shift+Enter  new line" Foreground="{StaticResource Faint}" FontSize="11" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <Popup x:Name="Picker" IsOpen="{Binding IsPickerOpen}" PlacementTarget="{Binding ElementName=Composer}" Placement="Top" StaysOpen="True"
                   AllowsTransparency="False" Focusable="False" Width="{Binding ActualWidth, ElementName=Composer}">
                <Border Background="{StaticResource ButtonBg}" BorderBrush="{StaticResource ButtonBorder}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Link an entry, folder, credential or snippet" Foreground="{StaticResource Faint}" FontSize="11" Margin="10,6,10,4" />
                        <ListBox x:Name="PickList" ItemsSource="{Binding PickItems}" SelectedItem="{Binding PickSelected}" Background="Transparent" BorderThickness="0"
                                 Focusable="False" MaxHeight="260" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonUp="OnPickClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="b" Background="Transparent" Padding="10,4">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" /></Trigger>
                                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource SelectRow}" /></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ChatPickItem}">
                                    <DockPanel>
                                        <Path DockPanel.Dock="Left" Style="{StaticResource ChatKindIcon}" Tag="{Binding Tag}" Margin="0,0,8,0" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Path}" Foreground="{StaticResource Faint}" FontSize="11" VerticalAlignment="Center"
                                                   MaxWidth="130" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" />
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="↑↓ pick    Enter or Tab  link    Esc  close" Foreground="{StaticResource Faint}" FontSize="11" Margin="10,4,10,6" />
                    </StackPanel>
                </Border>
            </Popup>

            <Grid>
                <ScrollViewer x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Messages}" Margin="10,6,10,10" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChatMessageItem}">
                                <StackPanel x:Name="row" Margin="0,10,0,0">
                                    <!-- Day separator -->
                                    <Grid Margin="0,4,0,10" Visibility="{Binding HasDay, Converter={StaticResource BoolVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Height="1" Background="{StaticResource BorderSoft}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding DayText}" Foreground="{StaticResource Faint}" FontSize="11" Margin="8,0" />
                                        <Border Grid.Column="2" Height="1" Background="{StaticResource BorderSoft}" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="av" Width="28" Height="28" CornerRadius="14" Background="{Binding Color}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Initials}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Bg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <StackPanel x:Name="meta" Orientation="Horizontal" Margin="0,0,0,1">
                                                <TextBlock Text="{Binding Sender}" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                                                <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource Faint}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Bottom" ToolTip="{Binding FullTime}" />
                                            </StackPanel>
                                            <ItemsControl x:Name="body" ItemsSource="{Binding Blocks}" Focusable="False" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsContinuation}" Value="True">
                                        <Setter TargetName="av" Property="Visibility" Value="Hidden" />
                                        <Setter TargetName="meta" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="row" Property="Margin" Value="0,3,0,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPending}" Value="True"><Setter TargetName="body" Property="Opacity" Value="0.6" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsUnreadable}" Value="True"><Setter TargetName="body" Property="Opacity" Value="0.6" /></DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="EmptyRoom" Text="No messages yet. Say hi, or type # to link an entry." Style="{StaticResource MutedText}"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="24" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
