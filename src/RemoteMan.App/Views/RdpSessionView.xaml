<UserControl x:Class="RemoteMan.App.Views.RdpSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
             Background="#000000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="22" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="State" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <wfi:WindowsFormsHost x:Name="Host" />

        <!-- Shown while the session connects. The RDP control is hidden meanwhile (WPF can't draw over it),
             then revealed once the remote desktop is ready to show. -->
        <!-- Shown while the session connects: orbiting dots (a take on the Windows loader) and the address.
             The RDP control is hidden meanwhile (WPF can't draw over it), then revealed once the desktop is ready. -->
        <Grid x:Name="Connecting" Background="{StaticResource Work}" Visibility="Collapsed">
            <Grid.Resources>
                <Storyboard x:Key="Spin" RepeatBehavior="Forever" Duration="0:0:2.9">
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="R0" Storyboard.TargetProperty="Angle" BeginTime="0:0:0.00">
                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                        <SplineDoubleKeyFrame KeyTime="0:0:0.55" Value="180" KeySpline="0.55,0 0.45,1" />
                        <SplineDoubleKeyFrame KeyTime="0:0:1.10" Value="360" KeySpline="0.55,0 0.45,1" />
                        <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="540" KeySpline="0.55,0 0.45,1" />
                        <SplineDoubleKeyFrame KeyTime="0:0:2.20" Value="720" KeySpline="0.55,0 0.45,1" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="P0" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.00">
                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                        <DiscreteDoubleKeyFrame KeyTime="0:0:2.10" Value="1" />
                        <LinearDoubleKeyFrame KeyTime="0:0:2.20" Value="0" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="R1" Storyboard.TargetProperty="Angle" BeginTime="0:0:0.12">
                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                        <SplineDoubleKeyFrame KeyTime="0:0:0.55" Value="180" KeySpline="0.55,0 0.45,1" />
                        <SplineDoubleKeyFrame KeyTime="0:0:1.10" Value="360" KeySpline="0.55,0 0.45,1" />
                        <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="540" KeySpline="0.55,0 0.45,1" />
                        <SplineDoubleKeyFrame KeyTime="0:0:2.20" Value="720" KeySpline="0.55,0 0.45,1" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="P1" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.12">
                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                        <DiscreteDoubleKeyFrame KeyTime="0:0:2.10" Value="1" />
                        <LinearDoubleKeyFrame KeyTime="0:0:2.20" Value="0" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="R2" Storyboard.TargetProperty="Angle" BeginTime="0:0:0.24">
                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                        <SplineDoubleKeyFrame KeyTime="0:0:0.55" Value="180" KeySpline="0.55,0 0.45,1" />
                        <SplineDoubleKeyFrame KeyTime="0:0:1.10" Value="360" KeySpline="0.55,0 0.45,1" />
                        <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="540" KeySpline="0.55,0 0.45,1" />
                        <SplineDoubleKeyFrame KeyTime="0:0:2.20" Value="720" KeySpline="0.55,0 0.45,1" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="P2" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.24">
                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                        <DiscreteDoubleKeyFrame KeyTime="0:0:2.10" Value="1" />
                        <LinearDoubleKeyFrame KeyTime="0:0:2.20" Value="0" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="R3" Storyboard.TargetProperty="Angle" BeginTime="0:0:0.36">
                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                        <SplineDoubleKeyFrame KeyTime="0:0:0.55" Value="180" KeySpline="0.55,0 0.45,1" />
                        <SplineDoubleKeyFrame KeyTime="0:0:1.10" Value="360" KeySpline="0.55,0 0.45,1" />
                        <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="540" KeySpline="0.55,0 0.45,1" />
                        <SplineDoubleKeyFrame KeyTime="0:0:2.20" Value="720" KeySpline="0.55,0 0.45,1" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="P3" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.36">
                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                        <DiscreteDoubleKeyFrame KeyTime="0:0:2.10" Value="1" />
                        <LinearDoubleKeyFrame KeyTime="0:0:2.20" Value="0" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="R4" Storyboard.TargetProperty="Angle" BeginTime="0:0:0.48">
                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                        <SplineDoubleKeyFrame KeyTime="0:0:0.55" Value="180" KeySpline="0.55,0 0.45,1" />
                        <SplineDoubleKeyFrame KeyTime="0:0:1.10" Value="360" KeySpline="0.55,0 0.45,1" />
                        <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="540" KeySpline="0.55,0 0.45,1" />
                        <SplineDoubleKeyFrame KeyTime="0:0:2.20" Value="720" KeySpline="0.55,0 0.45,1" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="P4" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.48">
                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                        <DiscreteDoubleKeyFrame KeyTime="0:0:2.10" Value="1" />
                        <LinearDoubleKeyFrame KeyTime="0:0:2.20" Value="0" />
                    </DoubleAnimationUsingKeyFrames>
                </Storyboard>
                <Style TargetType="Ellipse" x:Key="Dot">
                    <Setter Property="Width" Value="6" /><Setter Property="Height" Value="6" />
                    <Setter Property="Fill" Value="{StaticResource Accent}" />
                    <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Top" />
                </Style>
            </Grid.Resources>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="24">
                <Grid Width="44" Height="44" HorizontalAlignment="Center" Margin="0,0,0,26">
                    <Grid x:Name="P0" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><RotateTransform x:Name="R0" /></Grid.RenderTransform>
                        <Ellipse Style="{StaticResource Dot}" />
                    </Grid>
                    <Grid x:Name="P1" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><RotateTransform x:Name="R1" /></Grid.RenderTransform>
                        <Ellipse Style="{StaticResource Dot}" />
                    </Grid>
                    <Grid x:Name="P2" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><RotateTransform x:Name="R2" /></Grid.RenderTransform>
                        <Ellipse Style="{StaticResource Dot}" />
                    </Grid>
                    <Grid x:Name="P3" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><RotateTransform x:Name="R3" /></Grid.RenderTransform>
                        <Ellipse Style="{StaticResource Dot}" />
                    </Grid>
                    <Grid x:Name="P4" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><RotateTransform x:Name="R4" /></Grid.RenderTransform>
                        <Ellipse Style="{StaticResource Dot}" />
                    </Grid>
                </Grid>
                <TextBlock x:Name="ConnHost" Foreground="{StaticResource TextStrong}" FontFamily="{StaticResource MonoFont}" FontSize="15"
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ConnStage" Foreground="{StaticResource Faint}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"
                           TextWrapping="Wrap" TextAlignment="Center" />
                <TextBlock x:Name="ConnFallback" Visibility="Collapsed" Foreground="{StaticResource Warn}" FontSize="11" HorizontalAlignment="Center"
                           Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                <Button Style="{StaticResource FlatButton}" Content="Cancel" HorizontalAlignment="Center" Margin="0,22,0,0" Padding="12,3"
                        FontSize="11" Click="OnCancelConnect" AutomationProperties.Name="Cancel connecting" />
            </StackPanel>
        </Grid>

        <!-- Side strip: drop files here (or click) to send them to the remote session -->
        <Border x:Name="Strip" Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0"
                AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" DragLeave="OnDragLeave">
            <StackPanel>
                <Button Style="{StaticResource FlatButton}" Height="96" Padding="0" Click="OnSendFiles"
                        ToolTip="Send files: drop files here or click to pick, then press Ctrl+V in the remote folder"
                        AutomationProperties.Name="Send files to remote">
                    <TextBlock Text="Send files" FontSize="11">
                        <TextBlock.LayoutTransform><RotateTransform Angle="90" /></TextBlock.LayoutTransform>
                    </TextBlock>
                </Button>
            </StackPanel>
        </Border>

        <!-- A Popup is its own window, so it shows on top of the RDP control (WPF can't draw over it otherwise). -->
        <Popup x:Name="Notice" PlacementTarget="{Binding ElementName=Host}" Placement="Relative" AllowsTransparency="False"
               StaysOpen="True" PopupAnimation="None">
            <Border CornerRadius="{StaticResource Radius}" Background="{StaticResource Panel}" BorderBrush="{StaticResource Accent}" BorderThickness="1" Padding="12,8" MaxWidth="460">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="✕" Width="22" Height="22" Padding="0"
                            VerticalAlignment="Top" Margin="10,0,0,0" Click="OnCloseNotice" AutomationProperties.Name="Close" />
                    <StackPanel>
                        <TextBlock x:Name="NoticeTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="NoticeText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
