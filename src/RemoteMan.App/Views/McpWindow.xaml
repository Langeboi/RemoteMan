<Window x:Class="RemoteMan.App.Views.McpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:RemoteMan.App.ViewModels"
        Title="AI apps" Width="400" SizeToContent="Height" MaxHeight="640"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="True"
        Background="{StaticResource Panel}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!-- Borderless, but keeps the system drop shadow. An owned window (not a popup) so it sits on top of RDP and web tabs. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Faint}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
        <!-- A two-line button: title and a muted line under it. -->
        <Style x:Key="AppButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </Window.Resources>

    <Border BorderThickness="1" BorderBrush="{StaticResource Border}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="34" Background="{StaticResource Header}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                <DockPanel Margin="12,0,4,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="×" ToolTip="Close (Esc)" AutomationProperties.Name="Close" Click="OnHide" />
                    <TextBlock Text="AI apps" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextStrong}" VerticalAlignment="Center" />
                    <Border Margin="8,0,0,0" Padding="5,1" BorderThickness="1" BorderBrush="{StaticResource ButtonBorder}" CornerRadius="{StaticResource Radius}" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="MCP" FontFamily="{StaticResource MonoFont}" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource Link}" />
                    </Border>
                </DockPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="12,12,12,12">
                    <!-- The switch -->
                    <Border Padding="10" Background="{StaticResource Bg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="{StaticResource Radius}">
                        <CheckBox IsChecked="{Binding Enabled}" VerticalContentAlignment="Top" AutomationProperties.Name="Let AI apps use RemoteMan">
                            <StackPanel Margin="2,-1,0,0">
                                <TextBlock Text="Let AI apps use RemoteMan" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedText}" FontSize="11.5"
                                           Text="Claude, VS Code and other MCP apps on this PC can look things up and work in your sessions. Only your Windows user can connect." />
                            </StackPanel>
                        </CheckBox>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="2,9,0,0">
                        <Rectangle Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,7,0">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Fill" Value="{StaticResource Faint}" />
                                    <Style.Triggers><DataTrigger Binding="{Binding IsLive}" Value="True"><Setter Property="Fill" Value="{StaticResource Ok}" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                    <Style.Triggers><DataTrigger Binding="{Binding IsLive}" Value="True"><Setter Property="Foreground" Value="{StaticResource Ok}" /></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- Connect an AI app -->
                    <TextBlock Text="CONNECT AN AI APP" Style="{StaticResource Section}" />
                    <UniformGrid Columns="2">
                        <Button Style="{StaticResource AppButton}" Margin="0,0,3,6" Command="{Binding AddToClaudeDesktopCommand}" BorderBrush="{StaticResource Accent}"
                                ToolTip="Adds RemoteMan to Claude Desktop's config file (a backup of it is kept)">
                            <StackPanel>
                                <TextBlock Text="Add to Claude Desktop" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                                <TextBlock Text="Writes its config for you" Style="{StaticResource MutedText}" FontSize="11" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource AppButton}" Margin="3,0,0,6" Command="{Binding CopyClaudeCodeCommand}" ToolTip="Copies a claude mcp add command">
                            <StackPanel>
                                <TextBlock Text="Copy for Claude Code" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                                <TextBlock Text="claude mcp add … command" Style="{StaticResource MutedText}" FontSize="11" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource AppButton}" Margin="0,0,3,0" Command="{Binding CopyVsCodeCommand}">
                            <StackPanel>
                                <TextBlock Text="Copy for VS Code" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                                <TextBlock Text="For .vscode/mcp.json" Style="{StaticResource MutedText}" FontSize="11" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource AppButton}" Margin="3,0,0,0" Command="{Binding CopyJsonCommand}">
                            <StackPanel>
                                <TextBlock Text="Copy JSON" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                                <TextBlock Text="Cursor, LM Studio, others" Style="{StaticResource MutedText}" FontSize="11" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                    <TextBlock Text="{Binding SetupResult}" TextWrapping="Wrap" FontSize="11.5" Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Ok}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SetupOk}" Value="False"><Setter Property="Foreground" Value="{StaticResource Bad}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding SetupResult}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Permissions -->
                    <TextBlock Text="WHAT AI APPS MAY DO" Style="{StaticResource Section}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="Terminals" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Height="24" ItemsSource="{Binding TerminalOptions}" SelectedItem="{Binding Terminal}" DisplayMemberPath="Label"
                                  AutomationProperties.Name="Terminals" ToolTip="SSH, Telnet and serial sessions" />
                        <TextBlock Grid.Row="1" Text="Connections" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <CheckBox Grid.Row="1" Grid.Column="1" Content="Open entries" IsChecked="{Binding OpenConnections}" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="2" Text="Device configs" Style="{StaticResource MutedText}" VerticalAlignment="Top" Margin="0,8,0,0" />
                        <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding DeviceConfigs}" Margin="0,8,0,0" VerticalContentAlignment="Top" AutomationProperties.Name="Read Oxidized backups">
                            <StackPanel>
                                <TextBlock Text="Read Oxidized backups" />
                                <TextBlock Text="Configs can hold password hashes and keys" Foreground="{StaticResource Faint}" FontSize="11" />
                            </StackPanel>
                        </CheckBox>
                    </Grid>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Faint}" FontSize="11.5" Margin="0,10,0,0"
                               Text="Passwords, keys, stored usernames and secret fields are never shared. Credential entries aren't listed at all." />

                    <!-- Activity -->
                    <DockPanel Margin="0,16,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Clear" Foreground="{StaticResource Link}" FontSize="11" MinHeight="16" Padding="4,0"
                                Command="{Binding ClearActivityCommand}" Visibility="{Binding HasActivity, Converter={StaticResource BoolVis}}" />
                        <TextBlock Text="RECENT ACTIVITY" Style="{StaticResource Section}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="{StaticResource Radius}">
                        <Grid>
                            <TextBlock Text="Nothing yet. Every tool call an AI app makes shows up here." Foreground="{StaticResource Faint}" FontSize="11.5" Margin="8"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers><DataTrigger Binding="{Binding HasActivity}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Activity}" Focusable="False" MaxHeight="190">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"><ItemsPresenter /></ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:McpActivity}">
                                        <Border BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1" Padding="8,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="56" /><ColumnDefinition Width="94" /><ColumnDefinition /><ColumnDefinition Width="14" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Time}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Faint}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Client}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" FontSize="11.5" />
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="11.5" />
                                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Bad}" FontSize="10.5" TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers><DataTrigger Binding="{Binding Detail}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" HorizontalAlignment="Right">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="✓" />
                                                            <Setter Property="Foreground" Value="{StaticResource Ok}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Ok}" Value="False">
                                                                    <Setter Property="Text" Value="✕" />
                                                                    <Setter Property="Foreground" Value="{StaticResource Bad}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
