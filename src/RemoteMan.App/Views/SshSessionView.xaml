<UserControl x:Class="RemoteMan.App.Views.SshSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RemoteMan.App.Views"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="{StaticResource Work}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="SplitCol" Width="0" />
            <ColumnDefinition x:Name="FilesCol" Width="0" MinWidth="0" />
            <ColumnDefinition Width="22" />
        </Grid.ColumnDefinitions>

        <DockPanel>
            <!-- Broadcast: shown in every tab whose typing goes to the group -->
            <Border x:Name="BroadcastBar" DockPanel.Dock="Top" Background="#2A2214" BorderBrush="#5A4522" BorderThickness="0,0,0,1" Padding="8,4" Visibility="Collapsed">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="All SSH tabs" Margin="6,0,0,0" Click="OnBroadcastAll" ToolTip="Add every open SSH tab" />
                        <Button Content="Stop" Margin="6,0,0,0" Click="OnBroadcastStop" ToolTip="Stop broadcasting (Ctrl+Shift+M, or Esc twice in the terminal)" Foreground="{StaticResource Warn}" />
                    </StackPanel>
                    <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{StaticResource Warn}" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock x:Name="BroadcastLabel" DockPanel.Dock="Left" Foreground="{StaticResource Warn}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ItemsControl x:Name="BroadcastList" Focusable="False" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="{StaticResource Radius}" BorderThickness="1" Padding="5,0" Margin="0,1,4,1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#5A4522" />
                                                    <Setter Property="Background" Value="#3A2D17" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <CheckBox Content="{Binding Title}" IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsConnected}" Margin="0,2" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
            <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="#141517" />
        </DockPanel>
        <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch" />

        <!-- SFTP panel: same login as the terminal -->
        <DockPanel x:Name="FilesPanel" Grid.Column="2" Background="{StaticResource Panel}" Visibility="Collapsed"
                   AllowDrop="True" Drop="OnFilesDrop" DragOver="OnFilesDragOver">
            <Border DockPanel.Dock="Top" Height="24" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                <DockPanel Margin="2,0">
                    <Button DockPanel.Dock="Left" Style="{StaticResource FlatButton}" Content="↑" ToolTip="Parent folder" AutomationProperties.Name="Parent folder" Click="OnUp" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="⟳" ToolTip="Refresh" AutomationProperties.Name="Refresh" Click="OnRefresh" />
                    <TextBox x:Name="RemotePath" FontFamily="{StaticResource MonoFont}" FontSize="11" BorderThickness="0" Background="Transparent" KeyDown="OnPathKey"
                             AutomationProperties.Name="Remote folder" />
                </DockPanel>
            </Border>
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="4">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Content="Upload…" Click="OnUpload" />
                        <Button DockPanel.Dock="Left" Content="Download" Margin="4,0,0,0" Click="OnDownload" ToolTip="Save the selection to your download folder" />
                        <Button DockPanel.Dock="Right" Content="Delete" Click="OnDelete" />
                        <Rectangle />
                    </DockPanel>
                    <TextBlock x:Name="TransferText" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="TransferBar" Height="2" Margin="0,2,0,0" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Accent}" />
                </StackPanel>
            </Border>
            <ListView x:Name="RemoteList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}" SelectionMode="Extended"
                      MouseDoubleClick="OnItemDoubleClick" KeyDown="OnListKey">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Height" Value="20" />
                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="b" Background="Transparent" Padding="6,0">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" />
                                            <TextBlock x:Name="icon" Text="·" Width="14" Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsDirectory}" Value="True"><Setter TargetName="icon" Property="Text" Value="▸" /></DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" /></Trigger>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Select}" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </DockPanel>

        <!-- Snippets panel: saved commands, sent to this and other SSH tabs -->
        <DockPanel x:Name="SnippetsPanel" Grid.Column="2" Background="{StaticResource Panel}" Visibility="Collapsed">
            <Border DockPanel.Dock="Top" Height="24" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                <DockPanel Margin="6,0,2,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="⋯" ToolTip="More" AutomationProperties.Name="More snippet actions" Click="OnSnippetMore" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" ToolTip="New snippet" AutomationProperties.Name="New snippet" Click="OnNewSnippet">
                        <Path Data="M5,0 V10 M0,5 H10" Stroke="#B8BCC3" StrokeThickness="1.5" />
                    </Button>
                    <Grid>
                        <TextBox x:Name="SnippetFilter" BorderThickness="0" Background="Transparent" TextChanged="OnSnippetFilterChanged"
                                 AutomationProperties.Name="Filter snippets" KeyDown="OnSnippetFilterKey" />
                        <TextBlock Text="Filter snippets" Foreground="{StaticResource Faint}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="5,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SnippetFilter}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </Border>
            <Border DockPanel.Dock="Top" Height="26" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="6,2">
                <ComboBox x:Name="CategoryBox" SelectionChanged="OnCategoryChanged" AutomationProperties.Name="Snippet category"
                          ToolTip="Snippet category. Name a snippet's group &quot;Category/Group&quot; to file it, e.g. Debian/Network." />
            </Border>
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Background="{StaticResource Panel2}" Padding="8,6">
                <StackPanel>
                    <TextBlock Text="Send to" Style="{StaticResource MutedText}" FontSize="11" />
                    <ItemsControl x:Name="TargetList" Margin="0,4,0,0" Focusable="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="{StaticResource Radius}" BorderThickness="1" Padding="5,0" Margin="0,0,4,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#50667D" />
                                                    <Setter Property="Background" Value="#26313C" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <CheckBox Content="{Binding Title}" IsChecked="{Binding IsChecked}" Margin="0,2" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <CheckBox x:Name="PressEnterBox" Content="Also press Enter (run it now)" IsChecked="False" Foreground="{StaticResource Muted}"
                              ToolTip="Off: the snippet is only typed, so you can check it and fill in an IP or interface before pressing Enter" />
                    <DockPanel Margin="0,4,0,0">
                        <Button DockPanel.Dock="Right" Content="Edit" Margin="6,0,0,0" Click="OnEditSnippet" />
                        <Button x:Name="SendButton" Content="Send" Style="{StaticResource PrimaryButton}" Click="OnSendSnippet" />
                    </DockPanel>
                    <TextBlock x:Name="SnippetStatus" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Snippets are typed, not run: check them, fill in what's missing, press Enter. Double-click sends to this tab only." />
                </StackPanel>
            </Border>
            <ListBox x:Name="SnippetList" views:SmoothScroll.IsEnabled="True" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                     MouseDoubleClick="OnSnippetDoubleClick" KeyDown="OnSnippetKey" SelectionChanged="OnSnippetSelected">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <!-- Collapsible group: click the header to fold it away -->
                                        <ControlTemplate TargetType="GroupItem">
                                            <Expander IsExpanded="True" Foreground="{StaticResource Muted}" Loaded="OnGroupLoaded"
                                                      Expanded="OnGroupToggled" Collapsed="OnGroupToggled">
                                                <Expander.Header>
                                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}">
                                                        <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding ItemCount, Mode=OneWay}" Foreground="{StaticResource Faint}" />
                                                    </TextBlock>
                                                </Expander.Header>
                                                <ItemsPresenter />
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Send to this tab" Click="OnSendHere" />
                        <MenuItem Header="Edit…" Click="OnEditSnippet" />
                        <MenuItem Header="Duplicate…" Click="OnDuplicateSnippet" />
                        <Separator />
                        <MenuItem Header="Delete" Click="OnDeleteSnippet" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="b" Background="Transparent" Padding="16,3,8,3" ToolTip="{Binding Snippet.Command}">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock x:Name="fill" DockPanel.Dock="Right" Text="fill in" FontSize="10" Foreground="{StaticResource Presence}" Margin="6,0,0,0"
                                                           Visibility="Collapsed" ToolTip="Add the value it asks for (IP, interface, name) after it, then press Enter" />
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Snippet.Command}" FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                                       Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" MaxHeight="15" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" /></Trigger>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Select}" /></Trigger>
                                        <DataTrigger Binding="{Binding Snippet.NeedsValue}" Value="True"><Setter TargetName="fill" Property="Visibility" Value="Visible" /></DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>

        <!-- Side strip: toggles the Files and Snippets panels; also a drop target -->
        <Border Grid.Column="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0"
                AllowDrop="True" Drop="OnFilesDrop" DragOver="OnFilesDragOver">
            <StackPanel VerticalAlignment="Top">
            <ToggleButton x:Name="FilesToggle" Height="64" Background="Transparent" BorderThickness="0"
                          Foreground="{StaticResource Muted}" ToolTip="Files (SFTP, Ctrl+Shift+E)" AutomationProperties.Name="Toggle files panel"
                          Checked="OnFilesToggled" Unchecked="OnFilesToggled">
                <TextBlock Text="Files" FontSize="11">
                    <TextBlock.LayoutTransform><RotateTransform Angle="90" /></TextBlock.LayoutTransform>
                </TextBlock>
            </ToggleButton>
            <ToggleButton x:Name="SnippetsToggle" Height="74" Background="Transparent" BorderThickness="0"
                          Foreground="{StaticResource Muted}" ToolTip="Snippets (Ctrl+Shift+S)" AutomationProperties.Name="Toggle snippets panel"
                          Checked="OnSnippetsToggled" Unchecked="OnSnippetsToggled">
                <TextBlock Text="Snippets" FontSize="11">
                    <TextBlock.LayoutTransform><RotateTransform Angle="90" /></TextBlock.LayoutTransform>
                </TextBlock>
            </ToggleButton>
            <ToggleButton x:Name="BroadcastToggle" Height="84" Background="Transparent" BorderThickness="0"
                          Foreground="{StaticResource Muted}" ToolTip="Broadcast: type once into several SSH tabs (Ctrl+Shift+M)" AutomationProperties.Name="Toggle broadcast typing"
                          Checked="OnBroadcastToggled" Unchecked="OnBroadcastToggled">
                <TextBlock Text="Broadcast" FontSize="11">
                    <TextBlock.LayoutTransform><RotateTransform Angle="90" /></TextBlock.LayoutTransform>
                </TextBlock>
            </ToggleButton>
            <Button x:Name="LookButton" Height="22" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,6,0,0"
                    Foreground="{StaticResource Muted}" ToolTip="Terminal look: theme, font, size, scrollback. Find: Ctrl+Shift+F. Zoom: Ctrl+wheel."
                    AutomationProperties.Name="Terminal look" Click="OnLook">
                <TextBlock Text="Aa" FontSize="11" />
            </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
