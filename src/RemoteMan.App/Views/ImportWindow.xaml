<Window x:Class="RemoteMan.App.Views.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import connections" Width="680" Height="580" MinWidth="560" MinHeight="440"
        Style="{StaticResource RemoteManWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="RadioButton" x:Key="SourceCard">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="{StaticResource Bg}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="8" Margin="0,0,6,0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#26313C" />
                                <Setter TargetName="b" Property="BorderBrush" Value="#50667D" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Height="28" Background="{StaticResource Header}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <TextBlock Text="Import connections" Margin="10,0" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Header}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="10,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ImportButton" Content="Import" MinWidth="76" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="OnImport" IsEnabled="False" />
                    <Button x:Name="CloseButton" Content="Cancel" MinWidth="76" Margin="6,0,0,0" IsCancel="True" />
                </StackPanel>
                <TextBlock x:Name="Summary" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <DockPanel Margin="12,10" Background="{StaticResource Panel}">
            <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,-6,10">
                <RadioButton x:Name="SrcRdm" GroupName="src" Style="{StaticResource SourceCard}" Checked="OnSourceChanged" IsChecked="True">
                    <StackPanel>
                        <TextBlock Text="Devolutions RDM" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                        <TextBlock Text=".rdm or .json export" Style="{StaticResource MutedText}" FontSize="11" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="SrcRdp" GroupName="src" Style="{StaticResource SourceCard}" Checked="OnSourceChanged">
                    <StackPanel>
                        <TextBlock Text=".rdp files" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                        <TextBlock Text="one or many" Style="{StaticResource MutedText}" FontSize="11" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="SrcPutty" GroupName="src" Style="{StaticResource SourceCard}" Checked="OnSourceChanged">
                    <StackPanel>
                        <TextBlock Text="PuTTY" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                        <TextBlock Text="saved sessions on this PC, or a .reg file" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </RadioButton>
            </UniformGrid>

            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock x:Name="FileLabel" Text="File" Width="56" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" Click="OnBrowse" />
                <TextBox x:Name="FileBox" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="11" />
            </DockPanel>

            <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="Into folder" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                <ComboBox x:Name="TargetBox" Grid.Column="1" DisplayMemberPath="Name" Margin="0,2" />
                <CheckBox x:Name="SkipDupes" Grid.Row="1" Grid.Column="1" IsChecked="True" Content="Skip entries that already exist (same name and host in the same folder)" />
                <TextBlock x:Name="Notes" Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" MaxHeight="64" />
            </Grid>

            <Border BorderBrush="{StaticResource Border}" BorderThickness="1" Background="{StaticResource Bg}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Height="22" Margin="6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" /><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /><ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="AllBox" IsChecked="True" Click="OnToggleAll" VerticalAlignment="Center" Margin="0" AutomationProperties.Name="Include all" />
                        <TextBlock Grid.Column="1" Text="Type" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="Name" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="Host" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="Login" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" />
                    </Grid>
                    <ListBox x:Name="Preview" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" BorderBrush="{StaticResource Border}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="b" Background="Transparent" Height="21" Padding="6,0">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" /><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /><ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Include}" VerticalAlignment="Center" Margin="0" AutomationProperties.Name="Include" />
                                    <Border Grid.Column="1" BorderBrush="{StaticResource ButtonBorder}" BorderThickness="1" HorizontalAlignment="Left" Width="28" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Kind}" FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" Margin="{Binding Indent}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding Host}" FontFamily="{StaticResource MonoFont}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="4" Text="{Binding Login}" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </DockPanel>
    </DockPanel>
</Window>
