<Window x:Class="RemoteMan.App.Views.SnippetEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snippet" Width="520" Height="380" MinWidth="420" MinHeight="300"
        Style="{StaticResource RemoteManWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Top" Height="28" Background="{StaticResource Header}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <TextBlock x:Name="Heading" Margin="10,0" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Header}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="10,8">
            <DockPanel>
                <Button x:Name="DeleteButton" DockPanel.Dock="Left" Content="Delete" MinWidth="76" Click="OnDelete" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="OK" MinWidth="76" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="OnOk" />
                    <Button Content="Cancel" MinWidth="76" Margin="6,0,0,0" IsCancel="True" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Margin="12,10" Background="{StaticResource Panel}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="Name" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            <TextBox x:Name="NameBox" Grid.Column="1" Margin="0,2" />
            <TextBlock Grid.Row="1" Text="Group" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            <ComboBox x:Name="GroupBox" Grid.Row="1" Grid.Column="1" Margin="0,2" IsEditable="True" />
            <TextBlock Grid.Row="2" Text="Command" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
            <TextBox x:Name="CommandBox" Grid.Row="2" Grid.Column="1" Margin="0,2" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                     VerticalContentAlignment="Top" FontFamily="{StaticResource MonoFont}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
            <CheckBox x:Name="EnterBox" Grid.Row="3" Grid.Column="1" Content="Press Enter after the text" />
            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                       Text="Several lines are typed one after another. {host}, {user} and {name} are replaced with each session's host, login and entry name." />
        </Grid>
    </DockPanel>
</Window>
