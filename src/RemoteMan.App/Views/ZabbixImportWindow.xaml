<Window x:Class="RemoteMan.App.Views.ZabbixImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import from Zabbix" Width="760" Height="620" MinWidth="560" MinHeight="420"
        Style="{StaticResource RemoteManWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisZ" />
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Height="28" Background="{StaticResource Header}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <DockPanel Margin="10,0">
                <TextBlock x:Name="Source" DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
                <TextBlock Text="Import from Zabbix" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Header}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="10,8">
            <DockPanel>
                <TextBlock x:Name="Summary" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ImportButton" Content="Import" MinWidth="96" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="OnImport" />
                    <Button Content="Cancel" MinWidth="76" Margin="6,0,0,0" IsCancel="True" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel2}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                <TextBlock Text="Address to use" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                <ComboBox x:Name="AddressBox" Grid.Column="1" Margin="0,2" Width="260" HorizontalAlignment="Left" SelectionChanged="OnOptionChanged" AutomationProperties.Name="Address to use">
                    <ComboBoxItem Content="Zabbix interface IP or DNS" IsSelected="True" />
                    <ComboBoxItem Content="Zabbix host name" />
                </ComboBox>
                <TextBlock Grid.Row="1" Text="Put them in" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                <ComboBox x:Name="FolderBox" Grid.Row="1" Grid.Column="1" Margin="0,2" Width="260" HorizontalAlignment="Left" SelectionChanged="OnOptionChanged" AutomationProperties.Name="Put them in">
                    <ComboBoxItem Content="A folder per Zabbix host group" IsSelected="True" />
                    <ComboBoxItem Content="One folder: &quot;Imported from Zabbix&quot;" />
                </ComboBox>
                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="Protocol is guessed from the host's templates (Windows gets RDP, Linux and network gear get SSH). Every imported entry keeps its Zabbix link, so its health shows right away." />
            </Grid>
        </Border>
        <Grid Background="{StaticResource Panel}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <WrapPanel Margin="12,10,12,8">
                <TextBlock Text="Host group" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="GroupBox" Width="220" SelectionChanged="OnFilterChanged" AutomationProperties.Name="Host group" />
                <CheckBox x:Name="HideExisting" Content="Hide hosts that already have an entry" Margin="16,0,0,0" VerticalAlignment="Center" Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
                <Button Content="Select all" Margin="16,0,0,0" Click="OnSelectAll" />
                <Button Content="Select none" Margin="6,0,0,0" Click="OnSelectNone" />
            </WrapPanel>
            <Grid Grid.Row="1" Margin="20,0,20,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /><ColumnDefinition Width="90" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="ZABBIX HOST" FontSize="10" FontWeight="SemiBold" Style="{StaticResource Muted}" />
                <TextBlock Grid.Column="2" Text="ADDRESS" FontSize="10" FontWeight="SemiBold" Style="{StaticResource Muted}" />
                <TextBlock Grid.Column="3" Text="CREATE AS" FontSize="10" FontWeight="SemiBold" Style="{StaticResource Muted}" />
                <TextBlock Grid.Column="4" Text="FOLDER" FontSize="10" FontWeight="SemiBold" Style="{StaticResource Muted}" />
            </Grid>
            <ListBox x:Name="Rows" Grid.Row="2" Margin="12,0,12,12" Background="{StaticResource Panel2}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                     Foreground="{StaticResource Text}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single"
                     VirtualizingPanel.IsVirtualizing="True" AutomationProperties.Name="Zabbix hosts to import">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /><ColumnDefinition Width="90" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" />
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Hint}" FontSize="10" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Hint}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Address}" FontFamily="{StaticResource MonoFont}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <ComboBox Grid.Column="3" Width="76" HorizontalAlignment="Left" VerticalAlignment="Center" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}"
                                      IsEnabled="{Binding CanSelect}" AutomationProperties.Name="Create as" />
                            <TextBlock Grid.Column="4" Text="{Binding Folder}" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</Window>
