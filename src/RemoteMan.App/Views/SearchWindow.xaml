<Window x:Class="RemoteMan.App.Views.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Search everything" Width="860" Height="540" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Panel}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" FontSize="12"
        PreviewKeyDown="OnQueryKey" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" BorderBrush="{StaticResource MenuBorder}" BorderThickness="1">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
    </Window.Resources>
    <DockPanel>
        <!-- Search box -->
        <Border DockPanel.Dock="Top" Height="44" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <DockPanel Margin="12,0">
                <Path DockPanel.Dock="Left" Data="M10.5,10.5 L14,14 M11.5,6.5 A5,5 0 1 1 1.5,6.5 A5,5 0 1 1 11.5,6.5 Z" Stroke="{StaticResource Muted}" StrokeThickness="1.5"
                      VerticalAlignment="Center" Margin="0,0,10,0" />
                <Border DockPanel.Dock="Right" BorderBrush="{StaticResource InputBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="5,1" VerticalAlignment="Center">
                    <TextBlock Text="Esc" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource Faint}" />
                </Border>
                <Grid>
                    <TextBox x:Name="Query" BorderThickness="0" Background="Transparent" FontSize="15" Foreground="{StaticResource TextStrong}" VerticalAlignment="Center"
                             TextChanged="OnQueryChanged" AutomationProperties.Name="Search everything" />
                    <TextBlock Text="Search names, hosts, tags, custom fields, descriptions and folders" FontSize="15" Foreground="{StaticResource Faint}"
                               IsHitTestVisible="False" VerticalAlignment="Center" Margin="3,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=Query}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Filters and prefixes -->
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1" Padding="10,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center"
                           Text="Narrow with tag:  host:  field:  desc:  in:  kind:" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="FilterAll" GroupName="f" Style="{StaticResource PanelTab}" IsChecked="True" Height="24" Padding="10,0" Checked="OnFilter">
                        <TextBlock x:Name="AllLabel" Text="All" Margin="10,0" />
                    </RadioButton>
                    <RadioButton x:Name="FilterEntries" GroupName="f" Style="{StaticResource PanelTab}" Height="24" Checked="OnFilter">
                        <TextBlock x:Name="EntriesLabel" Text="Entries" Margin="10,0" />
                    </RadioButton>
                    <RadioButton x:Name="FilterCreds" GroupName="f" Style="{StaticResource PanelTab}" Height="24" Checked="OnFilter">
                        <TextBlock x:Name="CredsLabel" Text="Credentials" Margin="10,0" />
                    </RadioButton>
                    <RadioButton x:Name="FilterFolders" GroupName="f" Style="{StaticResource PanelTab}" Height="24" Checked="OnFilter">
                        <TextBlock x:Name="FoldersLabel" Text="Folders" Margin="10,0" />
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Keys -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock Style="{StaticResource MutedText}" FontSize="11" x:Name="Keys"
                       Text="↑↓ move    Enter connect    Shift+Enter show in tree    Ctrl+E edit    Ctrl+Shift+C copy host    Esc close" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ListBox x:Name="Results" Background="Transparent" BorderThickness="0,0,1,0" BorderBrush="{StaticResource BorderSoft}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnResultSelected" MouseDoubleClick="OnResultDoubleClick"
                     VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="b" Background="Transparent" Padding="12,5">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" /></Trigger>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Select}" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <!-- Group heading above the first hit of each kind of match -->
                            <TextBlock Text="{Binding GroupHeading}" Visibility="{Binding ShowHeading, Converter={StaticResource BoolVis}}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource Faint}" Margin="0,6,0,4" />
                            <DockPanel>
                                <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Top" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding KindName}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource Faint}" Margin="8,1,0,0" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextStrong}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{StaticResource Faint}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="11.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0">
                                        <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="2" Padding="4,0" Margin="0,0,6,-3">
                                            <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{StaticResource Faint}" />
                                        </Border><Run Text="{Binding Before, Mode=OneWay}" /><Run Text="{Binding Match, Mode=OneWay}" Background="#3B3320" Foreground="#F3E3B0" /><Run Text="{Binding After, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="Empty" Style="{StaticResource MutedText}" Margin="14" TextWrapping="Wrap" VerticalAlignment="Top" Visibility="Collapsed" />

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Preview" Margin="16,14" />
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
