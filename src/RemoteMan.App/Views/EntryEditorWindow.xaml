<Window x:Class="RemoteMan.App.Views.EntryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit entry" Width="640" Height="600" MinWidth="520" MinHeight="420"
        Style="{StaticResource RemoteManWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label" BasedOn="{StaticResource MutedText}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3,8,3" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Height="28" Background="{StaticResource Header}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <DockPanel Margin="10,0">
                <TextBlock x:Name="OthersEditing" DockPanel.Dock="Right" Foreground="{StaticResource Presence}" FontSize="11" VerticalAlignment="Center" />
                <TextBlock x:Name="Heading" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Header}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="10,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" MinWidth="76" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="OnOk" />
                <Button Content="Cancel" MinWidth="76" Margin="6,0,0,0" IsCancel="True" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource Panel}">
            <StackPanel Margin="12,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <TextBlock Text="Name" Style="{StaticResource Label}" />
                    <TextBox x:Name="NameBox" Grid.Column="1" Margin="0,2" />
                    <TextBlock Grid.Row="1" Text="Tags" Style="{StaticResource Label}" />
                    <TextBox x:Name="TagsBox" Grid.Row="1" Grid.Column="1" Margin="0,2" />
                    <TextBlock x:Name="UrlLabel" Grid.Row="2" Text="URL" Style="{StaticResource Label}" />
                    <TextBox x:Name="UrlBox" Grid.Row="2" Grid.Column="1" Margin="0,2" FontFamily="{StaticResource MonoFont}" />
                    <TextBlock x:Name="CredLabel" Grid.Row="3" Text="Credential" Style="{StaticResource Label}" />
                    <ComboBox x:Name="CredBox" Grid.Row="3" Grid.Column="1" Margin="0,2" DisplayMemberPath="Name" />
                </Grid>

                <!-- Hosts with fallback order -->
                <GroupBox x:Name="HostsGroup" Header="Hosts (tried in order)">
                    <StackPanel>
                        <ItemsControl x:Name="HostsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <TextBlock DockPanel.Dock="Left" Width="66" Text="{Binding Role}" Style="{StaticResource Label}" />
                                        <Button DockPanel.Dock="Right" Content="×" Width="24" Margin="4,0,0,0" ToolTip="Remove" AutomationProperties.Name="Remove host" Click="OnRemoveHost" />
                                        <Button DockPanel.Dock="Right" Content="↑" Width="24" Margin="4,0,0,0" ToolTip="Move up" AutomationProperties.Name="Move host up" Click="OnMoveUp" />
                                        <TextBox DockPanel.Dock="Right" Width="60" Margin="6,0,0,0" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Port" />
                                        <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Host" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Add fallback" HorizontalAlignment="Left" Margin="0,6,0,0" Click="OnAddHost" />
                    </StackPanel>
                </GroupBox>

                <!-- Credential entry fields -->
                <GroupBox x:Name="CredGroup" Header="Login">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                        <TextBlock Text="User name" Style="{StaticResource Label}" />
                        <TextBox x:Name="UserBox" Grid.Column="1" Margin="0,2" />
                        <TextBlock Grid.Row="1" Text="Domain" Style="{StaticResource Label}" />
                        <TextBox x:Name="DomainBox" Grid.Row="1" Grid.Column="1" Margin="0,2" />
                        <TextBlock Grid.Row="2" Text="Password" Style="{StaticResource Label}" />
                        <PasswordBox x:Name="PasswordBox" Grid.Row="2" Grid.Column="1" Margin="0,2" ToolTip="Leave empty to keep the stored password" />
                        <TextBlock Grid.Row="3" Text="Private key" Style="{StaticResource Label}" VerticalAlignment="Top" />
                        <TextBox x:Name="KeyBox" Grid.Row="3" Grid.Column="1" Margin="0,2" Height="80" AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalContentAlignment="Top" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                 ToolTip="Paste an OpenSSH, PEM or PuTTY (.ppk) key. Leave empty to keep the stored key." />
                        <TextBlock Grid.Row="4" Text="Passphrase" Style="{StaticResource Label}" />
                        <PasswordBox x:Name="PassphraseBox" Grid.Row="4" Grid.Column="1" Margin="0,2" />
                    </Grid>
                </GroupBox>

                <GroupBox x:Name="RdpGroup" Header="RDP options">
                    <StackPanel>
                        <CheckBox x:Name="RdpIgnoreCert" Content="Skip certificate warnings" />
                        <CheckBox x:Name="RdpSmart" Content="Fit desktop to tab (smart sizing)" />
                        <CheckBox x:Name="RdpClipboard" Content="Redirect clipboard (text and files, both ways)" />
                        <CheckBox x:Name="RdpCopySelect" Content="Copy text as soon as it is selected" />
                        <CheckBox x:Name="RdpDrives" Content="Redirect local drives" />
                        <CheckBox x:Name="RdpAdmin" Content="Admin (console) session" />
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock Text="RD Gateway" Width="90" Style="{StaticResource Label}" />
                            <TextBox x:Name="RdpGateway" ToolTip="Leave empty for a direct connection" />
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox x:Name="SshGroup" Header="SSH options">
                    <StackPanel>
                        <CheckBox x:Name="SshAutoAccept" Content="Accept host keys automatically (logged)" />
                        <CheckBox x:Name="SshLegacy" Content="Allow legacy algorithms (ssh-rsa, DH group1/14-sha1, CBC, 3DES)" />
                        <CheckBox x:Name="SshCopySelect" Content="Copy text as soon as it is selected" />
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock Text="Downloads to" Width="90" Style="{StaticResource Label}" />
                            <TextBox x:Name="SshDownloads" ToolTip="Leave empty for your Downloads folder" />
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock Text="Run on login" Width="90" Style="{StaticResource Label}" />
                            <TextBox x:Name="SshStartup" FontFamily="{StaticResource MonoFont}" />
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox x:Name="WebGroup" Header="Web options">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Browser" Width="90" Style="{StaticResource Label}" />
                            <ComboBox x:Name="WebBrowser" Width="160" HorizontalAlignment="Left" />
                        </DockPanel>
                        <CheckBox x:Name="WebIgnoreCert" Content="Ignore certificate errors" />
                        <CheckBox x:Name="WebAutoFill" Content="Fill in the login form automatically" />
                        <CheckBox x:Name="WebCopySelect" Content="Copy text as soon as it is selected" />
                    </StackPanel>
                </GroupBox>

                <GroupBox x:Name="VncGroup" Header="VNC options">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Viewer" Width="90" Style="{StaticResource Label}" />
                            <ComboBox x:Name="VncViewerBox" Width="160" HorizontalAlignment="Left" />
                        </DockPanel>
                        <CheckBox x:Name="VncViewOnly" Content="View only" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
