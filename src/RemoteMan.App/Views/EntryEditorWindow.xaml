<Window x:Class="RemoteMan.App.Views.EntryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit entry" Width="640" Height="600" MinWidth="520" MinHeight="420"
        Style="{StaticResource RemoteManWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label" BasedOn="{StaticResource MutedText}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3,8,3" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <!-- Segmented choice: radio buttons drawn as joined square buttons -->
        <Style TargetType="RadioButton" x:Key="Segment">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,0,-1,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="10,4">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Select}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Height="28" Background="{StaticResource Header}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <DockPanel Margin="10,0">
                <TextBlock x:Name="OthersEditing" DockPanel.Dock="Right" Foreground="{StaticResource Presence}" FontSize="11" VerticalAlignment="Center" />
                <TextBlock x:Name="Heading" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Header}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="10,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" MinWidth="76" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="OnOk" />
                <Button Content="Cancel" MinWidth="76" Margin="6,0,0,0" IsCancel="True" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource Panel}">
            <StackPanel Margin="12,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <TextBlock Text="Name" Style="{StaticResource Label}" />
                    <TextBox x:Name="NameBox" Grid.Column="1" Margin="0,2" />
                    <TextBlock Grid.Row="1" Text="Tags" Style="{StaticResource Label}" />
                    <TextBox x:Name="TagsBox" Grid.Row="1" Grid.Column="1" Margin="0,2" />
                    <TextBlock x:Name="UrlLabel" Grid.Row="2" Text="URL" Style="{StaticResource Label}" />
                    <TextBox x:Name="UrlBox" Grid.Row="2" Grid.Column="1" Margin="0,2" FontFamily="{StaticResource MonoFont}" />
                    <TextBlock x:Name="CredLabel" Grid.Row="3" Text="Login" Style="{StaticResource Label}" />
                    <ComboBox x:Name="LoginBox" Grid.Row="3" Grid.Column="1" Margin="0,2" DisplayMemberPath="Name" SelectionChanged="OnLoginChanged" />
                    <ComboBox x:Name="CredBox" Grid.Row="4" Grid.Column="1" Margin="0,2" DisplayMemberPath="Name" />
                    <TextBlock x:Name="LoginHint" Grid.Row="5" Grid.Column="1" Style="{StaticResource MutedText}" FontSize="11" Margin="0,2" TextWrapping="Wrap" />
                </Grid>

                <!-- Hosts with fallback order -->
                <GroupBox x:Name="HostsGroup" Header="Hosts (tried in order)">
                    <StackPanel>
                        <ItemsControl x:Name="HostsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <TextBlock DockPanel.Dock="Left" Width="66" Text="{Binding Role}" Style="{StaticResource Label}" />
                                        <Button DockPanel.Dock="Right" Content="×" Width="24" Margin="4,0,0,0" ToolTip="Remove" AutomationProperties.Name="Remove host" Click="OnRemoveHost" />
                                        <Button DockPanel.Dock="Right" Content="↑" Width="24" Margin="4,0,0,0" ToolTip="Move up" AutomationProperties.Name="Move host up" Click="OnMoveUp" />
                                        <TextBox DockPanel.Dock="Right" Width="60" Margin="6,0,0,0" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Port" />
                                        <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Host" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Add fallback" HorizontalAlignment="Left" Margin="0,6,0,0" Click="OnAddHost" />
                    </StackPanel>
                </GroupBox>

                <!-- Login: a credential entry's own secret, or a login typed into this entry -->
                <GroupBox x:Name="CredGroup" Header="Login">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Type" Width="90" Style="{StaticResource Label}" />
                            <WrapPanel>
                                <RadioButton x:Name="TypePassword" GroupName="ct" Content="Username and password" Style="{StaticResource Segment}" Checked="OnCredTypeChanged" />
                                <RadioButton x:Name="TypeKey" GroupName="ct" Content="SSH key" Style="{StaticResource Segment}" Checked="OnCredTypeChanged" />
                                <RadioButton x:Name="TypeCert" GroupName="ct" Content="Certificate file" Style="{StaticResource Segment}" Checked="OnCredTypeChanged" />
                                <RadioButton x:Name="TypeSecret" GroupName="ct" Content="Secret or API key" Style="{StaticResource Segment}" Checked="OnCredTypeChanged" />
                            </WrapPanel>
                        </DockPanel>
                        <DockPanel x:Name="UserRow" Margin="0,2">
                            <TextBlock Text="User name" Width="90" Style="{StaticResource Label}" />
                            <TextBox x:Name="UserBox" />
                        </DockPanel>
                        <DockPanel x:Name="DomainRow" Margin="0,2">
                            <TextBlock Text="Domain" Width="90" Style="{StaticResource Label}" />
                            <TextBox x:Name="DomainBox" ToolTip="Used for RDP. Leave empty for local accounts, SSH and web." />
                        </DockPanel>
                        <DockPanel x:Name="KeyRow" Margin="0,2">
                            <TextBlock Text="Private key" Width="90" Style="{StaticResource Label}" VerticalAlignment="Top" />
                            <StackPanel>
                                <TextBox x:Name="KeyBox" Height="80" AcceptsReturn="True" TextWrapping="NoWrap" VerticalContentAlignment="Top"
                                         FontFamily="{StaticResource MonoFont}" FontSize="10"
                                         ToolTip="Paste an OpenSSH, PEM or PuTTY (.ppk) key. Leave empty to keep the stored key." />
                                <WrapPanel Margin="0,4,0,0">
                                    <Button Content="Import key file…" Click="OnImportKey" Margin="0,0,6,0" />
                                    <Button Content="Generate new key…" Click="OnGenerateKey" Margin="0,0,6,0" />
                                    <Button Content="Copy public key" Click="OnCopyPublicKey" />
                                </WrapPanel>
                                <CheckBox x:Name="KeyFromDisk" Content="Use a key file on this PC instead (only the path is stored)" Margin="0,6,0,0" Checked="OnKeyFromDisk" Unchecked="OnKeyFromDisk" />
                                <DockPanel x:Name="KeyPathRow" Margin="0,2">
                                    <Button DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" Click="OnBrowseKeyPath" />
                                    <TextBox x:Name="KeyPathBox" FontFamily="{StaticResource MonoFont}" FontSize="11" />
                                </DockPanel>
                            </StackPanel>
                        </DockPanel>
                        <DockPanel x:Name="CertRow" Margin="0,2">
                            <TextBlock Text="Certificate" Width="90" Style="{StaticResource Label}" />
                            <Button DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" Click="OnBrowseCert" />
                            <TextBox x:Name="CertBox" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                     ToolTip=".pfx or .p12, stored encrypted. For web portals and gateways that ask for a client certificate." />
                        </DockPanel>
                        <DockPanel x:Name="PasswordRow" Margin="0,2">
                            <TextBlock x:Name="PasswordLabel" Text="Password" Width="90" Style="{StaticResource Label}" />
                            <PasswordBox x:Name="PasswordBox" ToolTip="Leave empty to keep the stored one" />
                        </DockPanel>
                        <DockPanel x:Name="PassphraseRow" Margin="0,2">
                            <TextBlock Text="Passphrase" Width="90" Style="{StaticResource Label}" />
                            <PasswordBox x:Name="PassphraseBox" />
                        </DockPanel>
                        <TextBlock x:Name="CertInfo" Style="{StaticResource MutedText}" FontSize="11" Margin="90,2,0,2" TextWrapping="Wrap" />
                        <CheckBox x:Name="AskPasswordBox" Content="Ask for the password when connecting instead of storing it" Margin="90,4,0,0" />
                        <DockPanel x:Name="NotesRow" Margin="0,2">
                            <TextBlock Text="Notes" Width="90" Style="{StaticResource Label}" VerticalAlignment="Top" />
                            <TextBox x:Name="NotesBox" Height="50" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" />
                        </DockPanel>
                        <CheckBox x:Name="SaveAsCredential" Content="Save as a reusable credential too" Margin="90,6,0,0" />
                    </StackPanel>
                </GroupBox>

                <GroupBox x:Name="RdpGroup" Header="RDP options">
                    <StackPanel>
                        <CheckBox x:Name="RdpIgnoreCert" Content="Skip certificate warnings" />
                        <CheckBox x:Name="RdpSmart" Content="Fit desktop to tab (smart sizing)" />
                        <CheckBox x:Name="RdpClipboard" Content="Redirect clipboard (text and files, both ways)" />
                        <CheckBox x:Name="RdpCopySelect" Content="Copy text as soon as it is selected" />
                        <CheckBox x:Name="RdpDrives" Content="Redirect local drives" />
                        <CheckBox x:Name="RdpAdmin" Content="Admin (console) session" />
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock Text="RD Gateway" Width="90" Style="{StaticResource Label}" />
                            <TextBox x:Name="RdpGateway" ToolTip="Leave empty for a direct connection" />
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox x:Name="SshGroup" Header="SSH options">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Jump host" Width="90" Style="{StaticResource Label}" />
                            <ComboBox x:Name="JumpBox" DisplayMemberPath="Name" SelectionChanged="OnJumpChanged"
                                      ToolTip="Connect through another SSH entry (ProxyJump). It logs in with its own credential and fallback hosts." />
                        </DockPanel>
                        <TextBlock x:Name="JumpPath" Style="{StaticResource MutedText}" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="90,0,0,4" TextWrapping="Wrap" />
                        <CheckBox x:Name="SshAutoAccept" Content="Accept host keys automatically (logged)" />
                        <CheckBox x:Name="SshLegacy" Content="Allow legacy algorithms (ssh-rsa, DH group1/14-sha1, CBC, 3DES)" />
                        <CheckBox x:Name="SshCopySelect" Content="Copy text as soon as it is selected" />
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock Text="Downloads to" Width="90" Style="{StaticResource Label}" />
                            <TextBox x:Name="SshDownloads" ToolTip="Leave empty for your Downloads folder" />
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock Text="Run on login" Width="90" Style="{StaticResource Label}" />
                            <TextBox x:Name="SshStartup" FontFamily="{StaticResource MonoFont}" />
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox x:Name="WebGroup" Header="Web options">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Browser" Width="90" Style="{StaticResource Label}" />
                            <ComboBox x:Name="WebBrowser" Width="230" HorizontalAlignment="Left" />
                        </DockPanel>
                        <CheckBox x:Name="WebIgnoreCert" Content="Ignore certificate errors" />
                        <CheckBox x:Name="WebAutoFill" Content="Fill in the login form automatically" />
                        <CheckBox x:Name="WebAutoSubmit" Content="Then press the login button" Margin="18,3,0,3" />
                        <TextBlock Text="Form fields (optional CSS selectors, leave empty to detect automatically)" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,2" />
                        <DockPanel Margin="0,2">
                            <TextBlock Text="User field" Width="90" Style="{StaticResource Label}" />
                            <TextBox x:Name="WebUserSel" FontFamily="{StaticResource MonoFont}" FontSize="11" ToolTip="e.g. #username or input[name=login]" />
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="Password field" Width="90" Style="{StaticResource Label}" />
                            <TextBox x:Name="WebPassSel" FontFamily="{StaticResource MonoFont}" FontSize="11" ToolTip="e.g. #password" />
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="Login button" Width="90" Style="{StaticResource Label}" />
                            <TextBox x:Name="WebSubmitSel" FontFamily="{StaticResource MonoFont}" FontSize="11" ToolTip="e.g. button#login" />
                        </DockPanel>
                        <CheckBox x:Name="WebCopySelect" Content="Copy text as soon as it is selected" />
                    </StackPanel>
                </GroupBox>

                <!-- Zabbix: which host's health shows on this entry -->
                <GroupBox x:Name="ZabbixGroup" Header="Zabbix" Visibility="Collapsed">
                    <DockPanel>
                        <Button x:Name="ZabbixUnlink" DockPanel.Dock="Right" Content="Unlink" MinWidth="70" Margin="6,0,0,0" Click="OnZabbixUnlink" />
                        <Button DockPanel.Dock="Right" Content="Link to Zabbix host…" Margin="6,0,0,0" Click="OnZabbixLink" />
                        <TextBlock x:Name="ZabbixCurrent" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Text}" />
                    </DockPanel>
                </GroupBox>

                <GroupBox x:Name="VncGroup" Header="VNC options">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Viewer" Width="90" Style="{StaticResource Label}" />
                            <ComboBox x:Name="VncViewerBox" Width="160" HorizontalAlignment="Left" />
                        </DockPanel>
                        <CheckBox x:Name="VncViewOnly" Content="View only" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
