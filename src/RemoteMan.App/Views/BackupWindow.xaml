<Window x:Class="RemoteMan.App.Views.BackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export and backup" Width="660" Height="560" MinWidth="560" MinHeight="460"
        Style="{StaticResource RemoteManWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Label" BasedOn="{StaticResource Muted}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3,8,3" />
        </Style>
        <Style TargetType="ListBoxItem" x:Key="SectionTab">
            <Setter Property="Foreground" Value="#B8BCC3" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Height="24" Padding="10,0" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Select}" />
                                <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Height="28" Background="{StaticResource Header}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <TextBlock Text="Export and backup" Margin="10,0" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Header}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="10,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ActionButton" Content="Export" MinWidth="76" Style="{StaticResource PrimaryButton}" Click="OnAction" />
                    <Button Content="Close" MinWidth="76" Margin="6,0,0,0" IsCancel="True" />
                </StackPanel>
                <TextBlock x:Name="Status" Foreground="{StaticResource Presence}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Left" Width="130" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0" Background="{StaticResource Panel}">
            <ListBox x:Name="Sections" Background="Transparent" BorderThickness="0" Padding="0,4" ItemContainerStyle="{StaticResource SectionTab}"
                     SelectionChanged="OnSectionChanged">
                <ListBoxItem Content="Export" IsSelected="True" />
                <ListBoxItem Content="Automatic backup" />
                <ListBoxItem Content="Restore" />
            </ListBox>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource Panel}">
            <Grid Margin="12,10">
                <!-- Export -->
                <StackPanel x:Name="ExportPage">
                    <GroupBox Header="What">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <TextBlock Text="Entries" Style="{StaticResource Label}" />
                            <ComboBox x:Name="ScopeBox" Grid.Column="1" DisplayMemberPath="Name" Margin="0,2" />
                            <CheckBox x:Name="ExportSecrets" Grid.Row="1" Grid.Column="1" IsChecked="True" Content="Include passwords and keys" />
                            <CheckBox x:Name="ExportSnippets" Grid.Row="2" Grid.Column="1" IsChecked="True" Content="Include snippets" />
                        </Grid>
                    </GroupBox>
                    <GroupBox Header="Protect with a password">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <TextBlock Text="Password" Style="{StaticResource Label}" />
                            <PasswordBox x:Name="ExportPw1" Grid.Column="1" Margin="0,2" />
                            <TextBlock Grid.Row="1" Text="Repeat" Style="{StaticResource Label}" />
                            <PasswordBox x:Name="ExportPw2" Grid.Row="1" Grid.Column="1" Margin="0,2" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="AES-256-GCM with a key from the password (PBKDF2-SHA256, 600,000 rounds). Opens on any PC with the password, into any data source. A lost password means a lost file." />
                        </Grid>
                    </GroupBox>
                    <DockPanel>
                        <TextBlock Text="Save as" Width="90" Style="{StaticResource Label}" />
                        <Button DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" Click="OnBrowseExport" />
                        <TextBox x:Name="ExportPath" FontFamily="{StaticResource MonoFont}" FontSize="11" />
                    </DockPanel>
                </StackPanel>

                <!-- Automatic backup -->
                <StackPanel x:Name="AutoPage" Visibility="Collapsed">
                    <CheckBox x:Name="AutoEnabled" Content="Back up automatically once a day (checked at start and every hour)" Margin="0,0,0,8" />
                    <GroupBox Header="Settings">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <TextBlock Text="Folder" Style="{StaticResource Label}" />
                            <DockPanel Grid.Column="1" Margin="0,2">
                                <Button DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" Click="OnBrowseFolder" />
                                <TextBox x:Name="AutoFolder" FontFamily="{StaticResource MonoFont}" FontSize="11" />
                            </DockPanel>
                            <TextBlock Grid.Row="1" Text="Keep" Style="{StaticResource Label}" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                <TextBox x:Name="AutoKeep" Width="44" />
                                <TextBlock Text="newest backups" Style="{StaticResource Label}" Margin="6,0,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Row="2" Text="Password" Style="{StaticResource Label}" />
                            <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,2">
                                <TextBlock x:Name="AutoPwState" DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" />
                                <PasswordBox x:Name="AutoPw" ToolTip="Leave empty to keep the saved password" />
                            </DockPanel>
                            <CheckBox x:Name="AutoSecrets" Grid.Row="3" Grid.Column="1" Content="Include passwords and keys" />
                            <TextBlock x:Name="AutoLast" Grid.Row="4" Grid.Column="1" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" />
                        </Grid>
                    </GroupBox>
                    <Border BorderBrush="{StaticResource Border}" BorderThickness="1" Background="{StaticResource Bg}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Height="22" Margin="6,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /><ColumnDefinition Width="76" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Backup" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Size" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
                            </Grid>
                            <ItemsControl x:Name="BackupList" MaxHeight="150">
                                <ItemsControl.Template>
                                    <ControlTemplate><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer></ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="24" Margin="6,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /><ColumnDefinition Width="76" /></Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="11" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding WhenText, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Source, Mode=OneWay}" Foreground="{StaticResource Muted}" />
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                            <Button Grid.Column="2" Content="Restore…" FontSize="11" MinHeight="20" Click="OnRestoreBackup" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- Restore -->
                <StackPanel x:Name="RestorePage" Visibility="Collapsed">
                    <TextBlock Text="Open an .rmx export or backup." Margin="0,0,0,6" />
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" Click="OnBrowseRestore" />
                        <TextBox x:Name="RestorePath" FontFamily="{StaticResource MonoFont}" FontSize="11" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Password" Width="90" Style="{StaticResource Label}" />
                        <Button DockPanel.Dock="Right" Content="Open" Margin="6,0,0,0" Click="OnOpenRestore" />
                        <PasswordBox x:Name="RestorePw" KeyDown="OnRestorePwKey" />
                    </DockPanel>
                    <GroupBox Header="How">
                        <StackPanel>
                            <RadioButton x:Name="RestoreAsCopy" GroupName="how" IsChecked="True" Foreground="{StaticResource Text}" Margin="0,3"
                                         Content="Add into a new folder (safe: nothing existing is changed)" />
                            <RadioButton x:Name="RestoreMerge" GroupName="how" Foreground="{StaticResource Text}" Margin="0,3"
                                         Content="Merge: overwrite entries that still exist, bring deleted ones back" />
                        </StackPanel>
                    </GroupBox>
                    <TextBlock x:Name="RestoreInfo" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
