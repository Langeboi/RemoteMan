<Window x:Class="RemoteMan.App.Views.OxidizedFeedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Oxidized device list" Width="900" Height="720" MinWidth="700" MinHeight="500"
        Style="{StaticResource RemoteManWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisF" />
        <Style TargetType="TextBlock" x:Key="Label" BasedOn="{StaticResource MutedText}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4,10,4" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Hint" BasedOn="{StaticResource MutedText}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="TextBlock" x:Key="ColHead">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Cell">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style TargetType="Border" x:Key="RowBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="8,5" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Hover}" /></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Header}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="14,10">
            <StackPanel>
                <TextBlock x:Name="Heading" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" TextWrapping="Wrap" />
                <TextBlock x:Name="SubHeading" Style="{StaticResource Hint}" Margin="0,3,0,0" />
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Header}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="10,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="ReloadButton" Content="Ask Oxidized to reload now" Margin="0,0,6,0" Click="OnReload" />
                    <Button x:Name="SaveButton" Content="Save" MinWidth="76" Style="{StaticResource PrimaryButton}" Click="OnSave" />
                    <Button Content="Close" MinWidth="76" Margin="6,0,0,0" IsCancel="True" />
                </StackPanel>
                <TextBlock x:Name="Status" Style="{StaticResource Hint}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </DockPanel>
        </Border>
        <Grid Background="{StaticResource Panel}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

            <!-- Options -->
            <Border Margin="14,12,14,0" Padding="12,8" Background="{StaticResource Panel2}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="{StaticResource Radius}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="160" /><ColumnDefinition Width="24" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <TextBlock Text="Group for new devices" Style="{StaticResource Label}" />
                    <ComboBox x:Name="GroupBox" Grid.Column="1" Margin="0,2" DisplayMemberPath="Name" AutomationProperties.Name="Group for new devices" SelectionChanged="OnOptionChanged" />
                    <TextBlock Grid.Column="3" Text="Model when unknown" Style="{StaticResource Label}" />
                    <TextBox x:Name="ModelBox" Grid.Column="4" Margin="0,2" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Model when unknown" TextChanged="OnOptionChanged"
                             ToolTip="Oxidized model for entries without one: ios, aoscx, procurve, fortios, routeros, dnos, linuxgeneric… Empty: Oxidized's own default.&#10;The model comes from an &quot;Oxidized model&quot; custom field, else a tag naming a model, else the vendor icon (Aruba aoscx, FortiGate fortios, MikroTik routeros, Cisco ios)." />
                    <TextBlock Grid.Row="1" Text="Leave out tag" Style="{StaticResource Label}" />
                    <TextBox x:Name="TagBox" Grid.Row="1" Grid.Column="1" Margin="0,2" AutomationProperties.Name="Leave out tag" TextChanged="OnOptionChanged"
                             ToolTip="SSH entries with this tag are never sent to Oxidized." />
                    <CheckBox x:Name="LoginsBox" Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" VerticalAlignment="Center" Margin="0,4" Click="OnOptionChanged"
                              Content="Send each entry's login (sealed so only the RemoteMan server can open it)"
                              ToolTip="An &quot;Enable&quot; secret field is sent as the enable password. Entries without a login use the one in Oxidized's config." />
                    <CheckBox x:Name="AutoAddBox" Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" VerticalAlignment="Center" Margin="0,4" Click="OnOptionChanged"
                              Content="Add new SSH entries to Oxidized automatically"
                              ToolTip="Off: only the entries ticked below go to Oxidized, and new entries wait until you tick them." />
                </Grid>
            </Border>

            <!-- Filter and bulk ticks -->
            <DockPanel Grid.Row="1" Margin="14,12,14,8">
                <ComboBox x:Name="ShowBox" DockPanel.Dock="Left" Width="190" DisplayMemberPath="Name" AutomationProperties.Name="Show" SelectionChanged="OnFilter" />
                <Grid DockPanel.Dock="Left" Width="220" Margin="8,0,0,0">
                    <TextBox x:Name="SearchBox" Height="26" Padding="22,0,6,0" VerticalContentAlignment="Center" TextChanged="OnFilter" AutomationProperties.Name="Find an entry" />
                    <Path Data="M9,5 A4,4 0 1 1 1,5 A4,4 0 1 1 9,5 Z M8,8 L11,11" Stroke="{StaticResource Faint}" StrokeThickness="1.4"
                          Margin="7,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" />
                    <TextBlock x:Name="SearchHint" Text="Find by name or address" Foreground="{StaticResource Faint}" Margin="24,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="TickAllButton" Content="Tick all" MinWidth="70" Click="OnTickAll" />
                    <Button x:Name="TickNoneButton" Content="Untick all" MinWidth="70" Margin="6,0,0,0" Click="OnTickNone" />
                </StackPanel>
                <TextBlock x:Name="Counts" Margin="12,0" Style="{StaticResource Hint}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </DockPanel>

            <!-- The list: no horizontal scrolling, readable rows, the themed scrollbar -->
            <Border Grid.Row="2" Margin="14,0,14,0" Background="{StaticResource Work}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="{StaticResource Radius}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource Header}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" />
                                <ColumnDefinition Width="100" /><ColumnDefinition Width="70" /><ColumnDefinition Width="190" /><ColumnDefinition Width="8" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="HeaderTick" VerticalAlignment="Center" Click="OnHeaderTick" ToolTip="Tick or untick everything shown" AutomationProperties.Name="Tick everything shown" />
                            <TextBlock Grid.Column="2" Text="Entry" Style="{StaticResource ColHead}" />
                            <TextBlock Grid.Column="3" Text="Address" Style="{StaticResource ColHead}" />
                            <TextBlock Grid.Column="4" Text="Model" Style="{StaticResource ColHead}" />
                            <TextBlock Grid.Column="5" Text="Login" Style="{StaticResource ColHead}" />
                            <TextBlock Grid.Column="6" Text="Status" Style="{StaticResource ColHead}" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="Empty" DockPanel.Dock="Top" Margin="12,14" Style="{StaticResource Hint}" Visibility="Collapsed" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="Rows" AutomationProperties.Name="SSH entries for Oxidized">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource RowBox}" ToolTip="{Binding Tip}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="100" /><ColumnDefinition Width="70" /><ColumnDefinition Width="190" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanCheck}"
                                                      VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" />
                                            <Ellipse Grid.Column="1" Width="8" Height="8" Fill="{Binding Dot}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextStrong}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding HasSub, Converter={StaticResource BoolVisF}}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="{Binding Address}" FontFamily="{StaticResource MonoFont}" FontSize="12" Style="{StaticResource Cell}" />
                                            <TextBlock Grid.Column="4" Text="{Binding Model}" Style="{StaticResource Cell}" />
                                            <TextBlock Grid.Column="5" Text="{Binding Login}" Style="{StaticResource Cell}" />
                                            <TextBlock Grid.Column="6" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" Style="{StaticResource Cell}" Margin="0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Expander Grid.Row="3" Margin="14,10,14,12" Header="How to point Oxidized at this list" Foreground="{StaticResource Muted}">
                <StackPanel Margin="0,6,0,0">
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                               Text="Oxidized reads its whole device list from one source. Replace the source: section of Oxidized's config (~/.config/oxidized/config) with this, then restart Oxidized. The token is on the RemoteMan server's admin page under Servers &gt; Set up Oxidized (or: docker exec remoteman remoteman-db oxidized)." />
                    <TextBox x:Name="ConfigBox" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto" Height="150" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Oxidized config" />
                    <Button Content="Copy" HorizontalAlignment="Left" MinWidth="70" Margin="0,6,0,0" Click="OnCopy" />
                </StackPanel>
            </Expander>
        </Grid>
    </DockPanel>
</Window>
