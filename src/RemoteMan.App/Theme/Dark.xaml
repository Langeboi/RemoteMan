<!-- Onyx-style dark: near-black graphite, one accent, blue entry icons, yellow keys. These are the classic teal values; the chosen theme (Services/Themes.cs) is written over them at startup. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:RemoteMan.App.Views">

    <Color x:Key="C.Bg">#0F1113</Color>
    <Color x:Key="C.Panel">#16191C</Color>
    <Color x:Key="C.Panel2">#131619</Color>
    <Color x:Key="C.Header">#16191C</Color>
    <Color x:Key="C.Border">#2A2F35</Color>
    <Color x:Key="C.BorderSoft">#22272C</Color>
    <Color x:Key="C.Work">#0B0D0F</Color>
    <Color x:Key="C.Text">#E3E6EA</Color>
    <Color x:Key="C.TextStrong">#F4F6F8</Color>
    <Color x:Key="C.Muted">#9AA3AD</Color>
    <Color x:Key="C.Faint">#7D8690</Color>
    <Color x:Key="C.Select">#22282D</Color>
    <Color x:Key="C.Hover">#1C2024</Color>
    <Color x:Key="C.Accent">#3FB8A4</Color>
    <Color x:Key="C.InputBorder">#2E343A</Color>
    <Color x:Key="C.Button">#1D2125</Color>
    <Color x:Key="C.ButtonBorder">#353B42</Color>
    <Color x:Key="C.Presence">#E3D7A8</Color>
    <Color x:Key="C.Ok">#54C08A</Color>
    <Color x:Key="C.Warn">#E0A84A</Color>
    <Color x:Key="C.Bad">#E5534B</Color>
    <Color x:Key="C.Rail">#121417</Color>
    <Color x:Key="C.EntryIcon">#5B9BEA</Color>
    <Color x:Key="C.KeyIcon">#D6C25E</Color>
    <Color x:Key="C.FolderIcon">#7D8A99</Color>
    <!-- Shades used by the controls below. Services/Themes.cs writes a theme's colours over all of these at startup. -->
    <Color x:Key="C.ButtonHover">#262B30</Color>
    <Color x:Key="C.AccentDim">#1F5E55</Color>
    <Color x:Key="C.OnAccent">#0F1113</Color>
    <Color x:Key="C.SelectRow">#262D33</Color>
    <Color x:Key="C.RailChecked">#1F2327</Color>
    <Color x:Key="C.MenuHover">#2A3036</Color>
    <Color x:Key="C.TabLine">#4A525B</Color>
    <Color x:Key="C.Thumb">#3A4048</Color>
    <Color x:Key="C.ThumbHover">#4A525B</Color>
    <Color x:Key="C.Link">#7FD3C4</Color>
    <Color x:Key="C.Inset">#1A1E22</Color>
    <Color x:Key="C.Soft">#B7BEC6</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource C.Bg}" />
    <SolidColorBrush x:Key="Panel" Color="{StaticResource C.Panel}" />
    <SolidColorBrush x:Key="Panel2" Color="{StaticResource C.Panel2}" />
    <SolidColorBrush x:Key="Header" Color="{StaticResource C.Header}" />
    <SolidColorBrush x:Key="Border" Color="{StaticResource C.Border}" />
    <SolidColorBrush x:Key="BorderSoft" Color="{StaticResource C.BorderSoft}" />
    <SolidColorBrush x:Key="Work" Color="{StaticResource C.Work}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource C.Text}" />
    <SolidColorBrush x:Key="TextStrong" Color="{StaticResource C.TextStrong}" />
    <SolidColorBrush x:Key="Muted" Color="{StaticResource C.Muted}" />
    <SolidColorBrush x:Key="Faint" Color="{StaticResource C.Faint}" />
    <SolidColorBrush x:Key="Select" Color="{StaticResource C.Select}" />
    <SolidColorBrush x:Key="Hover" Color="{StaticResource C.Hover}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource C.Accent}" />
    <SolidColorBrush x:Key="InputBorder" Color="{StaticResource C.InputBorder}" />
    <SolidColorBrush x:Key="ButtonBg" Color="{StaticResource C.Button}" />
    <SolidColorBrush x:Key="ButtonBorder" Color="{StaticResource C.ButtonBorder}" />
    <SolidColorBrush x:Key="Presence" Color="{StaticResource C.Presence}" />
    <SolidColorBrush x:Key="Ok" Color="{StaticResource C.Ok}" />
    <SolidColorBrush x:Key="Warn" Color="{StaticResource C.Warn}" />
    <SolidColorBrush x:Key="Bad" Color="{StaticResource C.Bad}" />
    <SolidColorBrush x:Key="Rail" Color="{StaticResource C.Rail}" />
    <SolidColorBrush x:Key="EntryIcon" Color="{StaticResource C.EntryIcon}" />
    <SolidColorBrush x:Key="KeyIcon" Color="{StaticResource C.KeyIcon}" />
    <SolidColorBrush x:Key="FolderIcon" Color="{StaticResource C.FolderIcon}" />
    <SolidColorBrush x:Key="ButtonHover" Color="{StaticResource C.ButtonHover}" />
    <SolidColorBrush x:Key="AccentDim" Color="{StaticResource C.AccentDim}" />
    <SolidColorBrush x:Key="OnAccent" Color="{StaticResource C.OnAccent}" />
    <SolidColorBrush x:Key="SelectRow" Color="{StaticResource C.SelectRow}" />
    <SolidColorBrush x:Key="RailChecked" Color="{StaticResource C.RailChecked}" />
    <SolidColorBrush x:Key="TabLine" Color="{StaticResource C.TabLine}" />
    <SolidColorBrush x:Key="Thumb" Color="{StaticResource C.Thumb}" />
    <SolidColorBrush x:Key="ThumbHover" Color="{StaticResource C.ThumbHover}" />
    <SolidColorBrush x:Key="Link" Color="{StaticResource C.Link}" />
    <SolidColorBrush x:Key="Inset" Color="{StaticResource C.Inset}" />
    <!-- Between Muted and Text: quiet labels on flat buttons, menus and section lists -->
    <SolidColorBrush x:Key="Soft" Color="{StaticResource C.Soft}" />

    <!-- Shading (More > Theme). These are the Flat values; Services/Themes.cs writes Subtle or Raised over them at startup.
         All of it is brushes (gradients and highlight lines), no Effects, so sessions keep hardware rendering. -->
    <SolidColorBrush x:Key="Depth.Sheen" Color="Transparent" />
    <SolidColorBrush x:Key="Depth.HiLine" Color="Transparent" />
    <SolidColorBrush x:Key="Depth.Inset" Color="Transparent" />
    <SolidColorBrush x:Key="Depth.ShadowDown" Color="Transparent" />
    <SolidColorBrush x:Key="Depth.ShadowRight" Color="Transparent" />
    <SolidColorBrush x:Key="Depth.Header" Color="{StaticResource C.Header}" />
    <SolidColorBrush x:Key="Depth.Card" Color="{StaticResource C.Panel}" />
    <SolidColorBrush x:Key="Depth.CardBorder" Color="{StaticResource C.Border}" />
    <Thickness x:Key="Depth.CardBorderThickness">1</Thickness>
    <SolidColorBrush x:Key="Depth.ButtonBorder" Color="{StaticResource C.ButtonBorder}" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <!-- Keep this window opaque: AllowsTransparency, Effects or Opacity on anything above a session
         would push the RDP/WebView2 hosts into software rendering (WPF airspace rules). -->
    <Style TargetType="Window" x:Key="RemoteManWindow">
        <Setter Property="Background" Value="{StaticResource Bg}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style TargetType="TextBlock" x:Key="MutedText">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style TargetType="TextBlock" x:Key="PaneTitle">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Protocol icons: 16px line glyphs, all one blue; credentials (keys) stay yellow. Set Tag to RDP / SSH / WEB / VNC / KEY. -->
    <Geometry x:Key="Icon.RDP">M1.5,2.5 H14.5 V11.5 H1.5 Z M5,14.5 H11 M8,11.5 V14.5</Geometry>
    <Geometry x:Key="Icon.SSH">M1.5,2.5 H14.5 V13.5 H1.5 Z M4,6 L6.5,8 L4,10 M8,10.5 H11.5</Geometry>
    <Geometry x:Key="Icon.WEB">M14.5,8 A6.5,6.5 0 1 1 1.5,8 A6.5,6.5 0 1 1 14.5,8 Z M1.5,8 H14.5 M8,1.5 C5,4.5 5,11.5 8,14.5 M8,1.5 C11,4.5 11,11.5 8,14.5</Geometry>
    <Geometry x:Key="Icon.VNC">M1.5,9.5 V1.5 H10.5 V4.5 M4.5,4.5 H14.5 V12.5 H4.5 Z M7,14.5 H12</Geometry>
    <Geometry x:Key="Icon.KEY">M8,10.5 A3,3 0 1 1 2,10.5 A3,3 0 1 1 8,10.5 Z M7.2,8.3 L14,1.5 M11.5,4 L13.5,6 M9.8,5.7 L11.3,7.2</Geometry>
    <Geometry x:Key="Icon.TEL">M1.5,2.5 h13 v11 h-13 z M4,6.5 h4 M6,6.5 V11 M9.5,10.5 h2.5</Geometry>
    <Geometry x:Key="Icon.SER">M2,5 h12 l-1.5,6 h-9 z M5,7.5 h0.01 M8,7.5 h0.01 M11,7.5 h0.01 M6,9.5 h0.01 M10,9.5 h0.01</Geometry>
    <Geometry x:Key="Icon.SFTP">M1.5,4 h4.5 l1.5,1.5 h7 v8 h-13 z M6,10.5 h4 M8.5,9 l1.5,1.5 L8.5,12</Geometry>
    <Geometry x:Key="Icon.FTP">M1.5,4 h4.5 l1.5,1.5 h7 v8 h-13 z M8,8 v4 M6,10 l2,2 l2,-2</Geometry>
    <Geometry x:Key="Icon.PVE">M1.5,3.5 h13 v8 h-13 z M4,7.5 h2 M10,6 l2,1.5 l-2,1.5 M5,14.5 h6</Geometry>
    <Geometry x:Key="Icon.PS">M1.5,2.5 h13 v11 h-13 z M1.5,4.5 h13 M4,7 l3,2 l-3,2 M8,11.5 h4</Geometry>
    <Geometry x:Key="Icon.WBX">M2,3.5 h12 v9 h-12 z M2,6 h12 M4.5,9 h2 M9.5,9 h2 M4.5,10.8 h7</Geometry>
    <Geometry x:Key="Icon.DASH">M1.5,1.5 h5.5 v6 h-5.5 z M9,1.5 h5.5 v3.5 h-5.5 z M9,7 h5.5 v7.5 h-5.5 z M1.5,9.5 h5.5 v5 h-5.5 z</Geometry>
    <Geometry x:Key="Icon.DIR">M1.5,3.5 h4.5 l1.5,1.5 h7 v8 h-13 z</Geometry>

    <Style TargetType="Path" x:Key="KindIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="StrokeThickness" Value="1.3" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="Stroke" Value="{StaticResource EntryIcon}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="RDP"><Setter Property="Data" Value="{StaticResource Icon.RDP}" /><Setter Property="ToolTip" Value="RDP" /></Trigger>
            <Trigger Property="Tag" Value="SSH"><Setter Property="Data" Value="{StaticResource Icon.SSH}" /><Setter Property="ToolTip" Value="SSH" /></Trigger>
            <Trigger Property="Tag" Value="WEB"><Setter Property="Data" Value="{StaticResource Icon.WEB}" /><Setter Property="ToolTip" Value="Web" /></Trigger>
            <Trigger Property="Tag" Value="VNC"><Setter Property="Data" Value="{StaticResource Icon.VNC}" /><Setter Property="ToolTip" Value="VNC" /></Trigger>
            <Trigger Property="Tag" Value="TEL"><Setter Property="Data" Value="{StaticResource Icon.TEL}" /><Setter Property="ToolTip" Value="Telnet" /></Trigger>
            <Trigger Property="Tag" Value="SER"><Setter Property="Data" Value="{StaticResource Icon.SER}" /><Setter Property="ToolTip" Value="Serial console" /></Trigger>
            <Trigger Property="Tag" Value="SFTP"><Setter Property="Data" Value="{StaticResource Icon.SFTP}" /><Setter Property="ToolTip" Value="SFTP" /></Trigger>
            <Trigger Property="Tag" Value="FTP"><Setter Property="Data" Value="{StaticResource Icon.FTP}" /><Setter Property="ToolTip" Value="FTP" /></Trigger>
            <Trigger Property="Tag" Value="PVE"><Setter Property="Data" Value="{StaticResource Icon.PVE}" /><Setter Property="ToolTip" Value="Proxmox console" /></Trigger>
            <Trigger Property="Tag" Value="PS"><Setter Property="Data" Value="{StaticResource Icon.PS}" /><Setter Property="ToolTip" Value="PowerShell remoting" /></Trigger>
            <Trigger Property="Tag" Value="WBX"><Setter Property="Data" Value="{StaticResource Icon.WBX}" /><Setter Property="ToolTip" Value="WinBox" /></Trigger>
            <Trigger Property="Tag" Value="DASH"><Setter Property="Data" Value="{StaticResource Icon.DASH}" /><Setter Property="ToolTip" Value="Dashboard" /><Setter Property="Stroke" Value="{StaticResource Accent}" /></Trigger>
            <Trigger Property="Tag" Value="DIR"><Setter Property="Data" Value="{StaticResource Icon.DIR}" /><Setter Property="ToolTip" Value="Folder" /><Setter Property="Stroke" Value="{StaticResource FolderIcon}" /></Trigger>
            <Trigger Property="Tag" Value="KEY"><Setter Property="Data" Value="{StaticResource Icon.KEY}" /><Setter Property="ToolTip" Value="Credential" /><Setter Property="Stroke" Value="{StaticResource KeyIcon}" /></Trigger>
        </Style.Triggers>
    </Style>

    <!-- Zabbix health glyphs (16x16, stroke only): triangle, octagon, crossed-out signal, info circle -->
    <Color x:Key="C.Maint">#7FA7D9</Color>
    <SolidColorBrush x:Key="Maint" Color="{StaticResource C.Maint}" />
    <Geometry x:Key="Icon.Z.warn">M8,2 L14.5,13.5 H1.5 Z M8,6.5 V9.5 M8,11.6 V11.8</Geometry>
    <Geometry x:Key="Icon.Z.high">M5.5,1.5 H10.5 L14.5,5.5 V10.5 L10.5,14.5 H5.5 L1.5,10.5 V5.5 Z M8,4.8 V8.8 M8,11 V11.2</Geometry>
    <Geometry x:Key="Icon.Z.unreach">M3,6 A7,7 0 0 1 13,6 M5,8.8 A4,4 0 0 1 11,8.8 M2,2 L14,14 M8,12 V12.2</Geometry>
    <Geometry x:Key="Icon.Z.info">M14.5,8 A6.5,6.5 0 1 1 1.5,8 A6.5,6.5 0 1 1 14.5,8 Z M8,7.5 V11.5 M8,4.6 V4.8</Geometry>

    <!-- Tag = warn | high | unreach | info. Healthy and maintenance hosts get no glyph. -->
    <Style TargetType="Path" x:Key="HealthGlyph">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="warn"><Setter Property="Visibility" Value="Visible" /><Setter Property="Data" Value="{StaticResource Icon.Z.warn}" /><Setter Property="Stroke" Value="{StaticResource Warn}" /></Trigger>
            <Trigger Property="Tag" Value="high"><Setter Property="Visibility" Value="Visible" /><Setter Property="Data" Value="{StaticResource Icon.Z.high}" /><Setter Property="Stroke" Value="{StaticResource Bad}" /></Trigger>
            <Trigger Property="Tag" Value="unreach"><Setter Property="Visibility" Value="Visible" /><Setter Property="Data" Value="{StaticResource Icon.Z.unreach}" /><Setter Property="Stroke" Value="{StaticResource Muted}" /></Trigger>
            <Trigger Property="Tag" Value="info"><Setter Property="Visibility" Value="Visible" /><Setter Property="Data" Value="{StaticResource Icon.Z.info}" /><Setter Property="Stroke" Value="{StaticResource Maint}" /></Trigger>
        </Style.Triggers>
    </Style>

    <!-- Oxidized backup glyph (16x16, stroke only, drawn a little smaller than the Zabbix glyphs so it stays quiet):
         an archive box. Only shows when something is wrong with the backups; colour says what. -->
    <Geometry x:Key="Icon.Ox.backup">M2.5,3.5 H13.5 V6.5 H2.5 Z M3.5,6.5 V12.5 H12.5 V6.5 M6.5,9 H9.5</Geometry>
    <!-- The same box with a small cross in place of the handle: the last run failed -->
    <Geometry x:Key="Icon.Ox.fail">M2.5,3.5 H13.5 V6.5 H2.5 Z M3.5,6.5 V12.5 H12.5 V6.5 M6.6,8.3 L9.4,11.1 M9.4,8.3 L6.6,11.1</Geometry>

    <!-- Tag = fail | stale (on entries); ok | never are added for the dashboard and overview, where every device is listed -->
    <Style TargetType="Path" x:Key="BackupGlyph">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="StrokeThickness" Value="1.3" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Data" Value="{StaticResource Icon.Ox.backup}" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="fail"><Setter Property="Visibility" Value="Visible" /><Setter Property="Data" Value="{StaticResource Icon.Ox.fail}" /><Setter Property="Stroke" Value="{StaticResource Warn}" /></Trigger>
            <Trigger Property="Tag" Value="stale"><Setter Property="Visibility" Value="Visible" /><Setter Property="Stroke" Value="{StaticResource Muted}" /></Trigger>
            <Trigger Property="Tag" Value="ok"><Setter Property="Visibility" Value="Visible" /><Setter Property="Stroke" Value="{StaticResource Ok}" /></Trigger>
            <Trigger Property="Tag" Value="never"><Setter Property="Visibility" Value="Visible" /><Setter Property="Stroke" Value="{StaticResource Faint}" /><Setter Property="Opacity" Value="0.6" /></Trigger>
            <Trigger Property="Tag" Value="changed"><Setter Property="Visibility" Value="Visible" /><Setter Property="Stroke" Value="{StaticResource Accent}" /></Trigger>
        </Style.Triggers>
    </Style>

    <!-- One corner radius for the whole app: just enough that nothing has a hard corner -->
    <CornerRadius x:Key="Radius">3</CornerRadius>
    <CornerRadius x:Key="TopRadius">3,3,0,0</CornerRadius>

    <!-- Buttons -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource ButtonBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Depth.ButtonBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius}">
                        <Grid>
                            <!-- Shading: a light wash from the top and a 1px highlight line (transparent when Flat) -->
                            <Border x:Name="sheen" Background="{StaticResource Depth.Sheen}" BorderBrush="{StaticResource Depth.HiLine}" BorderThickness="0,1,0,0"
                                    CornerRadius="2" IsHitTestVisible="False" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Borderless (flat) buttons get no shading -->
                        <Trigger Property="BorderThickness" Value="0"><Setter TargetName="sheen" Property="Visibility" Value="Collapsed" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource ButtonHover}" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Select}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentDim}" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
    </Style>
    <Style TargetType="Button" x:Key="FlatButton" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Soft}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinHeight" Value="22" />
    </Style>

    <Style TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="b" Background="Transparent" Padding="2,6" CornerRadius="{StaticResource Radius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Select}" />
                            <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inputs -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Work}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource Text}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius}" SnapsToDevicePixels="True">
                        <Grid>
                            <!-- Shading: a soft inner shadow along the top, so the field looks sunk in -->
                            <Border x:Name="inset" Background="{StaticResource Depth.Inset}" CornerRadius="2" IsHitTestVisible="False" />
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                          Padding="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="BorderThickness" Value="0"><Setter TargetName="inset" Property="Visibility" Value="Collapsed" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource Work}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
        <Setter Property="CaretBrush" Value="{StaticResource Text}" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="v:PasswordReveal.IsEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius}" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="2" Background="{StaticResource Depth.Inset}" CornerRadius="2" IsHitTestVisible="False" />
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                          Padding="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <!-- Shown instead of the dots while the eye is pressed (see PasswordReveal) -->
                            <TextBox x:Name="PART_Reveal" Visibility="Collapsed" Padding="{TemplateBinding Padding}" FontFamily="{TemplateBinding FontFamily}"
                                     FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="CaretBrush" Value="{StaticResource Text}" />
                                        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                                                  Padding="{TemplateBinding Padding}" />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <ToggleButton x:Name="PART_Eye" Grid.Column="1" Width="24" Focusable="False" Cursor="Hand" ToolTip="Show password" Visibility="Collapsed">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="eb" Background="Transparent" CornerRadius="{StaticResource Radius}" Margin="1">
                                            <Grid Width="16" Height="16">
                                                <Path x:Name="eye" Stroke="{StaticResource Muted}" StrokeThickness="1.2" StrokeLineJoin="Round"
                                                      Data="M1.5,8 C3.5,4.2 12.5,4.2 14.5,8 C12.5,11.8 3.5,11.8 1.5,8 z M8,6.1 A1.9,1.9 0 1 1 7.99,6.1 z" />
                                                <Path x:Name="slash" Stroke="{StaticResource Muted}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Data="M3,13 L13,3" Visibility="Collapsed" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="eb" Property="Background" Value="{StaticResource Hover}" />
                                                <Setter TargetName="eye" Property="Stroke" Value="{StaticResource Text}" />
                                                <Setter TargetName="slash" Property="Stroke" Value="{StaticResource Text}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="slash" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
        </Style.Triggers>
    </Style>
    <!-- Tick boxes: a small rounded square, filled with the accent and a tick when on, a dash when partly on -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource Work}" />
        <Setter Property="BorderBrush" Value="{StaticResource ButtonBorder}" />
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="box" Width="15" Height="15" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <Grid>
                                <Path x:Name="tick" Data="M3,7 L5.8,9.8 L11,4.2" Stroke="{StaticResource OnAccent}" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
                                <Border x:Name="dash" Width="7" Height="2" CornerRadius="1" Background="{StaticResource OnAccent}" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ContentPresenter x:Name="content" Grid.Column="1" Margin="7,0,0,0" RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False"><Setter TargetName="content" Property="Visibility" Value="Collapsed" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Muted}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource Accent}" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource Accent}" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="dash" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Plain option buttons: a ring with an accent dot when picked (the rail, tab and card radios have their own keyed styles) -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource Work}" />
        <Setter Property="BorderBrush" Value="{StaticResource ButtonBorder}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="15" Height="15" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <Ellipse x:Name="ring" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
                            <Ellipse x:Name="dot" Width="7" Height="7" Fill="{StaticResource Accent}" Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter x:Name="content" Grid.Column="1" Margin="7,0,0,0" RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False"><Setter TargetName="content" Property="Visibility" Value="Collapsed" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ring" Property="Stroke" Value="{StaticResource Muted}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ring" Property="Stroke" Value="{StaticResource Accent}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ring" Property="Stroke" Value="{StaticResource Accent}" />
                            <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menu strip -->
    <Style TargetType="Menu">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Soft}" />
    </Style>

    <!-- Tree: full-row selection, 24px rows, a 2px accent bar on the selected row; indentation comes from the node's Depth -->
    <Style TargetType="TreeViewItem" x:Key="EntryItem">
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <!-- Tight 22px rows, edge to edge: a flat band on hover, a lighter band with an accent edge when selected -->
                        <Border x:Name="row" Height="22" Background="Transparent" BorderBrush="Transparent" BorderThickness="2,0,0,0">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" Margin="{Binding Indent}" />
                        </Border>
                        <ItemsPresenter x:Name="kids" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False"><Setter TargetName="kids" Property="Visibility" Value="Collapsed" /></Trigger>
                        <Trigger SourceName="row" Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="{StaticResource Hover}" /></Trigger>
                        <DataTrigger Binding="{Binding IsLinkTarget}" Value="True">
                            <Setter TargetName="row" Property="Background" Value="#1F1E17" />
                            <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource KeyIcon}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                            <Setter TargetName="row" Property="Background" Value="{StaticResource SelectRow}" />
                            <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                            <Setter TargetName="row" Property="Background" Value="{StaticResource Select}" />
                            <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="row" Property="BorderThickness" Value="1" />
                        </DataTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="row" Property="Background" Value="{StaticResource SelectRow}" />
                            <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Session tabs: 32px, a 2px line on the active tab (accent in the focused pane, grey in the other) -->
    <Style TargetType="ListBoxItem" x:Key="SessionTab">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="tab" Height="32" Padding="12,0,6,0" Background="Transparent" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0" CornerRadius="{StaticResource TopRadius}">
                        <Grid>
                            <Border x:Name="line" Height="2" VerticalAlignment="Top" Background="Transparent" Margin="-12,0,-6,0" CornerRadius="{StaticResource TopRadius}" />
                            <!-- The entry's tab colour (Misc tab), a stripe along the bottom -->
                            <Border Height="3" VerticalAlignment="Bottom" Background="{Binding TabBrush}" Margin="-12,0,-6,0" IsHitTestVisible="False" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Text}" /></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="tab" Property="Background" Value="{StaticResource Bg}" />
                            <Setter TargetName="line" Property="Background" Value="{StaticResource TabLine}" />
                            <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="focused" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="line" Property="Background" Value="{StaticResource Accent}" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon rail buttons: 34px squares, accent glyph and a 2px bar when checked -->
    <Style TargetType="RadioButton" x:Key="RailButton">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" Background="Transparent" CornerRadius="{StaticResource Radius}" BorderBrush="Transparent" BorderThickness="2,0,0,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource RailChecked}" />
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon tabs in the navigation panel's bottom bar: grey glyph, the active one on a band with an accent underline -->
    <Style TargetType="RadioButton" x:Key="PanelTab">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" Background="Transparent" CornerRadius="{StaticResource Radius}" BorderBrush="Transparent" BorderThickness="0,0,0,2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Select}" />
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Title bar icon buttons (also clickable inside the custom window chrome) -->
    <Style TargetType="Button" x:Key="BarButton" BasedOn="{StaticResource FlatButton}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    </Style>
    <Style TargetType="ToggleButton" x:Key="BarToggle">
        <Setter Property="Foreground" Value="{StaticResource Soft}" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="28" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="b" Background="Transparent" CornerRadius="{StaticResource Radius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource RailChecked}" />
                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" x:Key="CaptionButton">
        <Setter Property="Width" Value="46" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource ButtonHover}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" x:Key="CloseCaptionButton" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#C42B1C" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="{StaticResource Border}" />
    </Style>


    <!-- ================= Menus, tooltips, dropdowns: dark everywhere, white text, clear separators ================= -->
    <SolidColorBrush x:Key="MenuBg" Color="{StaticResource C.Button}" />
    <SolidColorBrush x:Key="MenuBorder" Color="{StaticResource C.ButtonBorder}" />
    <SolidColorBrush x:Key="MenuHover" Color="{StaticResource C.MenuHover}" />

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource MenuBg}" />
        <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
        <Setter Property="BorderBrush" Value="{StaticResource MenuBorder}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HasDropShadow" Value="True" /><!-- the popup only allows transparency (round corners) when this is on; the templates draw no shadow -->
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="4" MinWidth="200">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator" x:Key="{x:Static MenuItem.SeparatorStyleKey}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="6,4" Background="{StaticResource MenuBorder}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="bd" Background="Transparent" CornerRadius="{StaticResource Radius}" MinHeight="28" Padding="10,0,10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuIcon" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGesture" />
                                    <ColumnDefinition Width="14" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="icon" ContentSource="Icon" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <Path x:Name="check" Data="M0,4 L3.5,7.5 L10,0" Stroke="{StaticResource Accent}" StrokeThickness="1.6" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                                <TextBlock x:Name="gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="24,0,0,0" FontSize="11"
                                           Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                <Path x:Name="arrow" Grid.Column="3" Data="M0,0 L4,4 L0,8" Stroke="{StaticResource Muted}" StrokeThickness="1.4"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <Popup x:Name="sub" Placement="Right" HorizontalOffset="2" VerticalOffset="-5" AllowsTransparency="True" Focusable="False"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" PopupAnimation="None">
                            <Border Background="{StaticResource MenuBg}" BorderBrush="{StaticResource MenuBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="4" MinWidth="180">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" Grid.IsSharedSizeScope="True" />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="SubmenuHeader"><Setter TargetName="arrow" Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="sub" Property="Placement" Value="Bottom" />
                            <Setter TargetName="sub" Property="HorizontalOffset" Value="0" />
                            <Setter TargetName="sub" Property="VerticalOffset" Value="2" />
                            <Setter TargetName="gesture" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="bd" Property="Padding" Value="8,0" />
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelItem"><Setter TargetName="gesture" Property="Visibility" Value="Collapsed" /></Trigger>
                        <Trigger Property="Icon" Value="{x:Null}"><Setter TargetName="icon" Property="Visibility" Value="Collapsed" /></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="check" Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource MenuHover}" /></Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource MenuHover}" /></Trigger>
                        <!-- Disabled stays readable: dimmer grey, never washed out -->
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource Faint}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="HasDropShadow" Value="True" /><!-- the popup only allows transparency (round corners) when this is on; the templates draw no shadow -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource MenuBg}" BorderBrush="{StaticResource MenuBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="8,5">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dropdowns -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="{StaticResource Radius}" Padding="8,5">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource MenuHover}" /></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource Select}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource Faint}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource Work}" />
        <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="b" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1" CornerRadius="{StaticResource Radius}">
                                        <Path Data="M0,0 L4,4 L8,0" Stroke="{StaticResource Muted}" StrokeThickness="1.4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Muted}" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="content" IsHitTestVisible="False" Margin="7,0,24,0" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                        <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Margin="1,1,22,1" BorderThickness="0" Background="Transparent"
                                 IsReadOnly="{TemplateBinding IsReadOnly}" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="2" AllowsTransparency="True" Focusable="False" PopupAnimation="None"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Background="{StaticResource MenuBg}" BorderBrush="{StaticResource MenuBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="content" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource Faint}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slim dark scrollbars -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border x:Name="t" Background="{StaticResource Thumb}" CornerRadius="3" Margin="2" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Background" Value="{StaticResource ThumbHover}" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="t" Background="{StaticResource Thumb}" CornerRadius="3" Margin="2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Background" Value="{StaticResource ThumbHover}" /></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ScrollViewer without the default corner square. Windows fills the corner where the two scrollbars meet
         with the system control colour (a bright white/grey square on a dark window); this keeps it transparent. -->
    <Style TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Rectangle x:Name="Corner" Grid.Column="1" Grid.Row="1" Fill="Transparent" />
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Column="0" Grid.Row="0" Margin="{TemplateBinding Padding}"
                                                Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}" CanHorizontallyScroll="False" CanVerticallyScroll="False" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Grid.Row="0" Cursor="Arrow" Minimum="0" AutomationProperties.AutomationId="VerticalScrollBar"
                                   Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Column="0" Grid.Row="1" Cursor="Arrow" Minimum="0" Orientation="Horizontal" AutomationProperties.AutomationId="HorizontalScrollBar"
                                   Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                   Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Stock controls: every default control follows the theme =================
         Windows' own templates paint white boxes, light-grey selections and black text; these replace them.
         Local styles for these types should be BasedOn the ones here. -->

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Padding" Value="0,3" />
    </Style>

    <Style TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{StaticResource Link}" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource Faint}" /></Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource Border}" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{TemplateBinding Background}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Group boxes: a small muted heading over a rounded frame (Windows draws a white inner line round the frame) -->
    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" Margin="1,0,0,4">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                    <Setter Property="FontSize" Value="11" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <Border Grid.Row="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Expanders: a chevron that turns when open, no white circle -->
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <DockPanel Background="{TemplateBinding Background}">
                        <ToggleButton x:Name="header" DockPanel.Dock="Top" FocusVisualStyle="{x:Null}" Foreground="{TemplateBinding Foreground}"
                                      Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="b" Background="Transparent" Padding="2,4" CornerRadius="{StaticResource Radius}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path x:Name="chevron" Width="8" Height="8" Margin="2,0,8,0" Data="M2,0 L6,4 L2,8" Stroke="{StaticResource Muted}" StrokeThickness="1.4"
                                                  VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
                                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" />
                                            <Setter TargetName="chevron" Property="Stroke" Value="{StaticResource Text}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="chevron" Property="Stroke" Value="{StaticResource Accent}" /></Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="chevron" Property="RenderTransform">
                                                <Setter.Value><RotateTransform Angle="90" /></Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="body" Margin="{TemplateBinding Padding}" Visibility="Collapsed" Focusable="False" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True"><Setter TargetName="body" Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Progress bars: a thin accent fill on a dark track (Windows' is green on light grey) -->
    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
        <Setter Property="Background" Value="{StaticResource Inset}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2" SnapsToDevicePixels="True" ClipToBounds="True">
                        <Grid>
                            <Rectangle x:Name="PART_Track" />
                            <Grid x:Name="PART_Indicator" HorizontalAlignment="Left" ClipToBounds="True">
                                <Border x:Name="fill" Background="{TemplateBinding Foreground}" CornerRadius="2" />
                                <Border x:Name="PART_GlowRect" Width="80" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2" Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="fill" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_GlowRect" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Lists: a dark field with readable rows. Hover is a soft wash; the selected row gets the theme's selection
         colour with bright text, whether or not the list has focus (Windows greys it out to near-white text on grey). -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource Work}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius}" SnapsToDevicePixels="True">
                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </ScrollViewer>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
                        <Trigger Property="IsGrouping" Value="True"><Setter Property="ScrollViewer.CanContentScroll" Value="False" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="b" Background="Transparent" BorderBrush="Transparent" BorderThickness="2,0,0,0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" /></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource SelectRow}" />
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A GridView's scroll area keeps the header row above the rows and, like every other scroll area, no corner square -->
    <Style x:Key="{x:Static GridView.GridViewScrollViewerStyleKey}" TargetType="ScrollViewer">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="{TemplateBinding Padding}">
                            <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Focusable="False">
                                <GridViewHeaderRowPresenter Margin="2,0,2,0" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                            Columns="{Binding TemplatedParent.View.Columns, RelativeSource={RelativeSource TemplatedParent}}"
                                                            ColumnHeaderContainerStyle="{Binding TemplatedParent.View.ColumnHeaderContainerStyle, RelativeSource={RelativeSource TemplatedParent}}"
                                                            ColumnHeaderTemplate="{Binding TemplatedParent.View.ColumnHeaderTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                                            ColumnHeaderTemplateSelector="{Binding TemplatedParent.View.ColumnHeaderTemplateSelector, RelativeSource={RelativeSource TemplatedParent}}"
                                                            ColumnHeaderStringFormat="{Binding TemplatedParent.View.ColumnHeaderStringFormat, RelativeSource={RelativeSource TemplatedParent}}"
                                                            AllowsColumnReorder="{Binding TemplatedParent.View.AllowsColumnReorder, RelativeSource={RelativeSource TemplatedParent}}"
                                                            ColumnHeaderContextMenu="{Binding TemplatedParent.View.ColumnHeaderContextMenu, RelativeSource={RelativeSource TemplatedParent}}"
                                                            ColumnHeaderToolTip="{Binding TemplatedParent.View.ColumnHeaderToolTip, RelativeSource={RelativeSource TemplatedParent}}" />
                            </ScrollViewer>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" KeyboardNavigation.DirectionalNavigation="Local"
                                                    Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </DockPanel>
                        <Rectangle Grid.Column="1" Grid.Row="1" Fill="Transparent" />
                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal" Cursor="Arrow" Minimum="0"
                                   Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                   Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Cursor="Arrow" Minimum="0"
                                   Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ListView without a GridView looks like a ListBox; with one, a themed column header row and the corner-free scroll area -->
    <Style TargetType="ListView" BasedOn="{StaticResource {x:Type ListBox}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListView">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="sv" Focusable="False" Padding="{TemplateBinding Padding}" Style="{StaticResource {x:Static GridView.GridViewScrollViewerStyleKey}}">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </ScrollViewer>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="View" Value="{x:Null}"><Setter TargetName="sv" Property="Style" Value="{StaticResource {x:Type ScrollViewer}}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
                        <Trigger Property="IsGrouping" Value="True"><Setter Property="ScrollViewer.CanContentScroll" Value="False" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="b" Background="Transparent" BorderBrush="Transparent" BorderThickness="2,0,0,0" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <!-- A GridView fills the row presenter; a plain ListView the content presenter -->
                            <GridViewRowPresenter x:Name="row" Columns="{TemplateBinding GridView.ColumnCollection}" Content="{TemplateBinding Content}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <ContentPresenter x:Name="plain" Visibility="Collapsed"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="GridView.ColumnCollection" Value="{x:Null}">
                            <Setter TargetName="row" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="plain" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" /></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource SelectRow}" />
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Background" Value="{StaticResource Header}" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Grid>
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,1,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="6" Margin="0,0,-3,0" Cursor="SizeWE">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="Role" Value="Padding"><Setter TargetName="b" Property="BorderThickness" Value="0,0,0,1" /></Trigger>
                        <Trigger Property="Role" Value="Floating"><Setter TargetName="PART_HeaderGripper" Property="Visibility" Value="Collapsed" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Plain tree views (the entry tree has its own row style); selection comes from the themed system colours -->
    <Style TargetType="TreeView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Tabs, for any TabControl that turns up: header strip on the panel colour, accent line under the open tab -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel KeyboardNavigation.TabNavigation="Local">
                        <Border DockPanel.Dock="Top" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1">
                            <TabPanel x:Name="HeaderPanel" IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                        </Border>
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </Border>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="b" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="12,6" Margin="0,0,2,-1">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
