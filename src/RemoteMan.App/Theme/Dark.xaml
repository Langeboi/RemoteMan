<!-- Onyx-style dark: near-black graphite, one teal accent, blue entry icons, yellow keys. Matches the approved UI refresh mockup. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:RemoteMan.App.Views">

    <Color x:Key="C.Bg">#0F1113</Color>
    <Color x:Key="C.Panel">#16191C</Color>
    <Color x:Key="C.Panel2">#131619</Color>
    <Color x:Key="C.Header">#16191C</Color>
    <Color x:Key="C.Border">#2A2F35</Color>
    <Color x:Key="C.BorderSoft">#22272C</Color>
    <Color x:Key="C.Work">#0B0D0F</Color>
    <Color x:Key="C.Text">#E3E6EA</Color>
    <Color x:Key="C.TextStrong">#F4F6F8</Color>
    <Color x:Key="C.Muted">#9AA3AD</Color>
    <Color x:Key="C.Faint">#7D8690</Color>
    <Color x:Key="C.Select">#22282D</Color>
    <Color x:Key="C.Hover">#1C2024</Color>
    <Color x:Key="C.Accent">#3FB8A4</Color>
    <Color x:Key="C.InputBorder">#2E343A</Color>
    <Color x:Key="C.Button">#1D2125</Color>
    <Color x:Key="C.ButtonBorder">#353B42</Color>
    <Color x:Key="C.Presence">#E3D7A8</Color>
    <Color x:Key="C.Ok">#54C08A</Color>
    <Color x:Key="C.Warn">#E0A84A</Color>
    <Color x:Key="C.Bad">#E5534B</Color>
    <Color x:Key="C.Rail">#121417</Color>
    <Color x:Key="C.EntryIcon">#5B9BEA</Color>
    <Color x:Key="C.KeyIcon">#D6C25E</Color>
    <Color x:Key="C.FolderIcon">#7D8A99</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource C.Bg}" />
    <SolidColorBrush x:Key="Panel" Color="{StaticResource C.Panel}" />
    <SolidColorBrush x:Key="Panel2" Color="{StaticResource C.Panel2}" />
    <SolidColorBrush x:Key="Header" Color="{StaticResource C.Header}" />
    <SolidColorBrush x:Key="Border" Color="{StaticResource C.Border}" />
    <SolidColorBrush x:Key="BorderSoft" Color="{StaticResource C.BorderSoft}" />
    <SolidColorBrush x:Key="Work" Color="{StaticResource C.Work}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource C.Text}" />
    <SolidColorBrush x:Key="TextStrong" Color="{StaticResource C.TextStrong}" />
    <SolidColorBrush x:Key="Muted" Color="{StaticResource C.Muted}" />
    <SolidColorBrush x:Key="Faint" Color="{StaticResource C.Faint}" />
    <SolidColorBrush x:Key="Select" Color="{StaticResource C.Select}" />
    <SolidColorBrush x:Key="Hover" Color="{StaticResource C.Hover}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource C.Accent}" />
    <SolidColorBrush x:Key="InputBorder" Color="{StaticResource C.InputBorder}" />
    <SolidColorBrush x:Key="ButtonBg" Color="{StaticResource C.Button}" />
    <SolidColorBrush x:Key="ButtonBorder" Color="{StaticResource C.ButtonBorder}" />
    <SolidColorBrush x:Key="Presence" Color="{StaticResource C.Presence}" />
    <SolidColorBrush x:Key="Ok" Color="{StaticResource C.Ok}" />
    <SolidColorBrush x:Key="Warn" Color="{StaticResource C.Warn}" />
    <SolidColorBrush x:Key="Bad" Color="{StaticResource C.Bad}" />
    <SolidColorBrush x:Key="Rail" Color="{StaticResource C.Rail}" />
    <SolidColorBrush x:Key="EntryIcon" Color="{StaticResource C.EntryIcon}" />
    <SolidColorBrush x:Key="KeyIcon" Color="{StaticResource C.KeyIcon}" />
    <SolidColorBrush x:Key="FolderIcon" Color="{StaticResource C.FolderIcon}" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <!-- Keep this window opaque: AllowsTransparency, Effects or Opacity on anything above a session
         would push the RDP/WebView2 hosts into software rendering (WPF airspace rules). -->
    <Style TargetType="Window" x:Key="RemoteManWindow">
        <Setter Property="Background" Value="{StaticResource Bg}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style TargetType="TextBlock" x:Key="MutedText">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style TargetType="TextBlock" x:Key="PaneTitle">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Protocol icons: 16px line glyphs, all one blue; credentials (keys) stay yellow. Set Tag to RDP / SSH / WEB / VNC / KEY. -->
    <Geometry x:Key="Icon.RDP">M1.5,2.5 H14.5 V11.5 H1.5 Z M5,14.5 H11 M8,11.5 V14.5</Geometry>
    <Geometry x:Key="Icon.SSH">M1.5,2.5 H14.5 V13.5 H1.5 Z M4,6 L6.5,8 L4,10 M8,10.5 H11.5</Geometry>
    <Geometry x:Key="Icon.WEB">M14.5,8 A6.5,6.5 0 1 1 1.5,8 A6.5,6.5 0 1 1 14.5,8 Z M1.5,8 H14.5 M8,1.5 C5,4.5 5,11.5 8,14.5 M8,1.5 C11,4.5 11,11.5 8,14.5</Geometry>
    <Geometry x:Key="Icon.VNC">M1.5,9.5 V1.5 H10.5 V4.5 M4.5,4.5 H14.5 V12.5 H4.5 Z M7,14.5 H12</Geometry>
    <Geometry x:Key="Icon.KEY">M8,10.5 A3,3 0 1 1 2,10.5 A3,3 0 1 1 8,10.5 Z M7.2,8.3 L14,1.5 M11.5,4 L13.5,6 M9.8,5.7 L11.3,7.2</Geometry>
    <Geometry x:Key="Icon.TEL">M1.5,2.5 h13 v11 h-13 z M4,6.5 h4 M6,6.5 V11 M9.5,10.5 h2.5</Geometry>
    <Geometry x:Key="Icon.SER">M2,5 h12 l-1.5,6 h-9 z M5,7.5 h0.01 M8,7.5 h0.01 M11,7.5 h0.01 M6,9.5 h0.01 M10,9.5 h0.01</Geometry>
    <Geometry x:Key="Icon.SFTP">M1.5,4 h4.5 l1.5,1.5 h7 v8 h-13 z M6,10.5 h4 M8.5,9 l1.5,1.5 L8.5,12</Geometry>
    <Geometry x:Key="Icon.FTP">M1.5,4 h4.5 l1.5,1.5 h7 v8 h-13 z M8,8 v4 M6,10 l2,2 l2,-2</Geometry>
    <Geometry x:Key="Icon.PVE">M1.5,3.5 h13 v8 h-13 z M4,7.5 h2 M10,6 l2,1.5 l-2,1.5 M5,14.5 h6</Geometry>
    <Geometry x:Key="Icon.PS">M1.5,2.5 h13 v11 h-13 z M1.5,4.5 h13 M4,7 l3,2 l-3,2 M8,11.5 h4</Geometry>
    <Geometry x:Key="Icon.WBX">M2,3.5 h12 v9 h-12 z M2,6 h12 M4.5,9 h2 M9.5,9 h2 M4.5,10.8 h7</Geometry>
    <Geometry x:Key="Icon.DASH">M1.5,1.5 h5.5 v6 h-5.5 z M9,1.5 h5.5 v3.5 h-5.5 z M9,7 h5.5 v7.5 h-5.5 z M1.5,9.5 h5.5 v5 h-5.5 z</Geometry>
    <Geometry x:Key="Icon.DIR">M1.5,3.5 h4.5 l1.5,1.5 h7 v8 h-13 z</Geometry>

    <Style TargetType="Path" x:Key="KindIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="StrokeThickness" Value="1.3" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="Stroke" Value="{StaticResource EntryIcon}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="RDP"><Setter Property="Data" Value="{StaticResource Icon.RDP}" /><Setter Property="ToolTip" Value="RDP" /></Trigger>
            <Trigger Property="Tag" Value="SSH"><Setter Property="Data" Value="{StaticResource Icon.SSH}" /><Setter Property="ToolTip" Value="SSH" /></Trigger>
            <Trigger Property="Tag" Value="WEB"><Setter Property="Data" Value="{StaticResource Icon.WEB}" /><Setter Property="ToolTip" Value="Web" /></Trigger>
            <Trigger Property="Tag" Value="VNC"><Setter Property="Data" Value="{StaticResource Icon.VNC}" /><Setter Property="ToolTip" Value="VNC" /></Trigger>
            <Trigger Property="Tag" Value="TEL"><Setter Property="Data" Value="{StaticResource Icon.TEL}" /><Setter Property="ToolTip" Value="Telnet" /></Trigger>
            <Trigger Property="Tag" Value="SER"><Setter Property="Data" Value="{StaticResource Icon.SER}" /><Setter Property="ToolTip" Value="Serial console" /></Trigger>
            <Trigger Property="Tag" Value="SFTP"><Setter Property="Data" Value="{StaticResource Icon.SFTP}" /><Setter Property="ToolTip" Value="SFTP" /></Trigger>
            <Trigger Property="Tag" Value="FTP"><Setter Property="Data" Value="{StaticResource Icon.FTP}" /><Setter Property="ToolTip" Value="FTP" /></Trigger>
            <Trigger Property="Tag" Value="PVE"><Setter Property="Data" Value="{StaticResource Icon.PVE}" /><Setter Property="ToolTip" Value="Proxmox console" /></Trigger>
            <Trigger Property="Tag" Value="PS"><Setter Property="Data" Value="{StaticResource Icon.PS}" /><Setter Property="ToolTip" Value="PowerShell remoting" /></Trigger>
            <Trigger Property="Tag" Value="WBX"><Setter Property="Data" Value="{StaticResource Icon.WBX}" /><Setter Property="ToolTip" Value="WinBox" /></Trigger>
            <Trigger Property="Tag" Value="DASH"><Setter Property="Data" Value="{StaticResource Icon.DASH}" /><Setter Property="ToolTip" Value="Dashboard" /><Setter Property="Stroke" Value="{StaticResource Accent}" /></Trigger>
            <Trigger Property="Tag" Value="DIR"><Setter Property="Data" Value="{StaticResource Icon.DIR}" /><Setter Property="ToolTip" Value="Folder" /><Setter Property="Stroke" Value="{StaticResource FolderIcon}" /></Trigger>
            <Trigger Property="Tag" Value="KEY"><Setter Property="Data" Value="{StaticResource Icon.KEY}" /><Setter Property="ToolTip" Value="Credential" /><Setter Property="Stroke" Value="{StaticResource KeyIcon}" /></Trigger>
        </Style.Triggers>
    </Style>

    <!-- Zabbix health glyphs (16x16, stroke only): triangle, octagon, crossed-out signal, info circle -->
    <Color x:Key="C.Maint">#7FA7D9</Color>
    <SolidColorBrush x:Key="Maint" Color="{StaticResource C.Maint}" />
    <Geometry x:Key="Icon.Z.warn">M8,2 L14.5,13.5 H1.5 Z M8,6.5 V9.5 M8,11.6 V11.8</Geometry>
    <Geometry x:Key="Icon.Z.high">M5.5,1.5 H10.5 L14.5,5.5 V10.5 L10.5,14.5 H5.5 L1.5,10.5 V5.5 Z M8,4.8 V8.8 M8,11 V11.2</Geometry>
    <Geometry x:Key="Icon.Z.unreach">M3,6 A7,7 0 0 1 13,6 M5,8.8 A4,4 0 0 1 11,8.8 M2,2 L14,14 M8,12 V12.2</Geometry>
    <Geometry x:Key="Icon.Z.info">M14.5,8 A6.5,6.5 0 1 1 1.5,8 A6.5,6.5 0 1 1 14.5,8 Z M8,7.5 V11.5 M8,4.6 V4.8</Geometry>

    <!-- Tag = warn | high | unreach | info. Healthy and maintenance hosts get no glyph. -->
    <Style TargetType="Path" x:Key="HealthGlyph">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="warn"><Setter Property="Visibility" Value="Visible" /><Setter Property="Data" Value="{StaticResource Icon.Z.warn}" /><Setter Property="Stroke" Value="{StaticResource Warn}" /></Trigger>
            <Trigger Property="Tag" Value="high"><Setter Property="Visibility" Value="Visible" /><Setter Property="Data" Value="{StaticResource Icon.Z.high}" /><Setter Property="Stroke" Value="{StaticResource Bad}" /></Trigger>
            <Trigger Property="Tag" Value="unreach"><Setter Property="Visibility" Value="Visible" /><Setter Property="Data" Value="{StaticResource Icon.Z.unreach}" /><Setter Property="Stroke" Value="#9AA3AD" /></Trigger>
            <Trigger Property="Tag" Value="info"><Setter Property="Visibility" Value="Visible" /><Setter Property="Data" Value="{StaticResource Icon.Z.info}" /><Setter Property="Stroke" Value="{StaticResource Maint}" /></Trigger>
        </Style.Triggers>
    </Style>

    <!-- One corner radius for the whole app: just enough that nothing has a hard corner -->
    <CornerRadius x:Key="Radius">3</CornerRadius>
    <CornerRadius x:Key="TopRadius">3,3,0,0</CornerRadius>

    <!-- Buttons -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource ButtonBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource ButtonBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="{StaticResource Radius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#262B30" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Select}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#1F5E55" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
    </Style>
    <Style TargetType="Button" x:Key="FlatButton" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#B7BEC6" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinHeight" Value="22" />
    </Style>

    <Style TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="b" Background="Transparent" Padding="2,6" CornerRadius="{StaticResource Radius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Select}" />
                            <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inputs -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Work}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource Text}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                      Padding="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource Work}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
        <Setter Property="CaretBrush" Value="{StaticResource Text}" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="v:PasswordReveal.IsEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius}" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                          Padding="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <!-- Shown instead of the dots while the eye is pressed (see PasswordReveal) -->
                            <TextBox x:Name="PART_Reveal" Visibility="Collapsed" Padding="{TemplateBinding Padding}" FontFamily="{TemplateBinding FontFamily}"
                                     FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="CaretBrush" Value="{StaticResource Text}" />
                                        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                                                  Padding="{TemplateBinding Padding}" />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <ToggleButton x:Name="PART_Eye" Grid.Column="1" Width="24" Focusable="False" Cursor="Hand" ToolTip="Show password" Visibility="Collapsed">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="eb" Background="Transparent" CornerRadius="{StaticResource Radius}" Margin="1">
                                            <Grid Width="16" Height="16">
                                                <Path x:Name="eye" Stroke="{StaticResource Muted}" StrokeThickness="1.2" StrokeLineJoin="Round"
                                                      Data="M1.5,8 C3.5,4.2 12.5,4.2 14.5,8 C12.5,11.8 3.5,11.8 1.5,8 z M8,6.1 A1.9,1.9 0 1 1 7.99,6.1 z" />
                                                <Path x:Name="slash" Stroke="{StaticResource Muted}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Data="M3,13 L13,3" Visibility="Collapsed" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="eb" Property="Background" Value="{StaticResource Hover}" />
                                                <Setter TargetName="eye" Property="Stroke" Value="{StaticResource Text}" />
                                                <Setter TargetName="slash" Property="Stroke" Value="{StaticResource Text}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="slash" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Margin" Value="0,3" />
    </Style>

    <!-- Menu strip -->
    <Style TargetType="Menu">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#B7BEC6" />
    </Style>

    <!-- Tree: full-row selection, 24px rows, a 2px accent bar on the selected row; indentation comes from the node's Depth -->
    <Style TargetType="TreeViewItem" x:Key="EntryItem">
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <Setter Property="Foreground" Value="#D5DADF" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <Border x:Name="row" Height="24" Margin="2,0" Background="Transparent" BorderBrush="Transparent" BorderThickness="2,0,0,0" CornerRadius="{StaticResource Radius}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" Margin="{Binding Indent}" />
                        </Border>
                        <ItemsPresenter x:Name="kids" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False"><Setter TargetName="kids" Property="Visibility" Value="Collapsed" /></Trigger>
                        <Trigger SourceName="row" Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="{StaticResource Hover}" /></Trigger>
                        <DataTrigger Binding="{Binding IsLinkTarget}" Value="True">
                            <Setter TargetName="row" Property="Background" Value="#1F1E17" />
                            <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource KeyIcon}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                            <Setter TargetName="row" Property="Background" Value="{StaticResource Select}" />
                            <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="row" Property="BorderThickness" Value="1" />
                        </DataTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="row" Property="Background" Value="{StaticResource Select}" />
                            <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Session tabs: 32px, a 2px line on the active tab (accent in the focused pane, grey in the other) -->
    <Style TargetType="ListBoxItem" x:Key="SessionTab">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="tab" Height="32" Padding="12,0,6,0" Background="Transparent" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0" CornerRadius="{StaticResource TopRadius}">
                        <Grid>
                            <Border x:Name="line" Height="2" VerticalAlignment="Top" Background="Transparent" Margin="-12,0,-6,0" CornerRadius="{StaticResource TopRadius}" />
                            <!-- The entry's tab colour (Misc tab), a stripe along the bottom -->
                            <Border Height="3" VerticalAlignment="Bottom" Background="{Binding TabBrush}" Margin="-12,0,-6,0" IsHitTestVisible="False" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Text}" /></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="tab" Property="Background" Value="{StaticResource Bg}" />
                            <Setter TargetName="line" Property="Background" Value="#4A525B" />
                            <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="focused" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="line" Property="Background" Value="{StaticResource Accent}" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon rail buttons: 34px squares, accent glyph and a 2px bar when checked -->
    <Style TargetType="RadioButton" x:Key="RailButton">
        <Setter Property="Foreground" Value="#8E98A3" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" Background="Transparent" CornerRadius="{StaticResource Radius}" BorderBrush="Transparent" BorderThickness="2,0,0,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#1F2327" />
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Title bar icon buttons (also clickable inside the custom window chrome) -->
    <Style TargetType="Button" x:Key="BarButton" BasedOn="{StaticResource FlatButton}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    </Style>
    <Style TargetType="ToggleButton" x:Key="BarToggle">
        <Setter Property="Foreground" Value="#B7BEC6" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="28" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="b" Background="Transparent" CornerRadius="{StaticResource Radius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#1F2327" />
                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" x:Key="CaptionButton">
        <Setter Property="Width" Value="46" />
        <Setter Property="Foreground" Value="#9AA3AD" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#262B30" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" x:Key="CloseCaptionButton" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#C42B1C" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="{StaticResource Border}" />
    </Style>


    <!-- ================= Menus, tooltips, dropdowns: dark everywhere, white text, clear separators ================= -->
    <SolidColorBrush x:Key="MenuBg" Color="#1D2125" />
    <SolidColorBrush x:Key="MenuBorder" Color="#353B42" />
    <SolidColorBrush x:Key="MenuHover" Color="#2A3036" />

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource MenuBg}" />
        <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
        <Setter Property="BorderBrush" Value="{StaticResource MenuBorder}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HasDropShadow" Value="True" /><!-- the popup only allows transparency (round corners) when this is on; the templates draw no shadow -->
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="4" MinWidth="200">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator" x:Key="{x:Static MenuItem.SeparatorStyleKey}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="6,4" Background="{StaticResource MenuBorder}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="bd" Background="Transparent" CornerRadius="{StaticResource Radius}" MinHeight="28" Padding="10,0,10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuIcon" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGesture" />
                                    <ColumnDefinition Width="14" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="icon" ContentSource="Icon" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <Path x:Name="check" Data="M0,4 L3.5,7.5 L10,0" Stroke="{StaticResource Accent}" StrokeThickness="1.6" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                                <TextBlock x:Name="gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="24,0,0,0" FontSize="11"
                                           Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                <Path x:Name="arrow" Grid.Column="3" Data="M0,0 L4,4 L0,8" Stroke="{StaticResource Muted}" StrokeThickness="1.4"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <Popup x:Name="sub" Placement="Right" HorizontalOffset="2" VerticalOffset="-5" AllowsTransparency="True" Focusable="False"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" PopupAnimation="None">
                            <Border Background="{StaticResource MenuBg}" BorderBrush="{StaticResource MenuBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="4" MinWidth="180">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" Grid.IsSharedSizeScope="True" />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="SubmenuHeader"><Setter TargetName="arrow" Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="sub" Property="Placement" Value="Bottom" />
                            <Setter TargetName="sub" Property="HorizontalOffset" Value="0" />
                            <Setter TargetName="sub" Property="VerticalOffset" Value="2" />
                            <Setter TargetName="gesture" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="bd" Property="Padding" Value="8,0" />
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelItem"><Setter TargetName="gesture" Property="Visibility" Value="Collapsed" /></Trigger>
                        <Trigger Property="Icon" Value="{x:Null}"><Setter TargetName="icon" Property="Visibility" Value="Collapsed" /></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="check" Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource MenuHover}" /></Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource MenuHover}" /></Trigger>
                        <!-- Disabled stays readable: dimmer grey, never washed out -->
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource Faint}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="HasDropShadow" Value="True" /><!-- the popup only allows transparency (round corners) when this is on; the templates draw no shadow -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource MenuBg}" BorderBrush="{StaticResource MenuBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="8,5">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dropdowns -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="{StaticResource Radius}" Padding="8,5">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource MenuHover}" /></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource Select}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource Faint}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource Work}" />
        <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="b" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1" CornerRadius="{StaticResource Radius}">
                                        <Path Data="M0,0 L4,4 L8,0" Stroke="{StaticResource Muted}" StrokeThickness="1.4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Muted}" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="content" IsHitTestVisible="False" Margin="7,0,24,0" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                        <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Margin="1,1,22,1" BorderThickness="0" Background="Transparent"
                                 IsReadOnly="{TemplateBinding IsReadOnly}" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="2" AllowsTransparency="True" Focusable="False" PopupAnimation="None"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Background="{StaticResource MenuBg}" BorderBrush="{StaticResource MenuBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="content" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource Faint}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slim dark scrollbars -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border x:Name="t" Background="#3A4048" CornerRadius="3" Margin="2" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Background" Value="#4A525B" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="t" Background="#3A4048" CornerRadius="3" Margin="2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Background" Value="#4A525B" /></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
