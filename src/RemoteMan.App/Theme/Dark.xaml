<!-- Flat, square, muted. Matches the approved mockup. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="C.Bg">#1B1D20</Color>
    <Color x:Key="C.Panel">#202226</Color>
    <Color x:Key="C.Panel2">#1E2023</Color>
    <Color x:Key="C.Header">#232529</Color>
    <Color x:Key="C.Border">#34373C</Color>
    <Color x:Key="C.BorderSoft">#2C2F33</Color>
    <Color x:Key="C.Work">#141517</Color>
    <Color x:Key="C.Text">#D4D7DC</Color>
    <Color x:Key="C.TextStrong">#EEF0F2</Color>
    <Color x:Key="C.Muted">#9DA2A9</Color>
    <Color x:Key="C.Faint">#6E737B</Color>
    <Color x:Key="C.Select">#33414F</Color>
    <Color x:Key="C.Hover">#272A2F</Color>
    <Color x:Key="C.Accent">#7C93AD</Color>
    <Color x:Key="C.InputBorder">#3A3D42</Color>
    <Color x:Key="C.Button">#2A2D31</Color>
    <Color x:Key="C.ButtonBorder">#44474D</Color>
    <Color x:Key="C.Presence">#C2B48A</Color>
    <Color x:Key="C.Ok">#7FA37F</Color>
    <Color x:Key="C.Warn">#B08A5A</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource C.Bg}" />
    <SolidColorBrush x:Key="Panel" Color="{StaticResource C.Panel}" />
    <SolidColorBrush x:Key="Panel2" Color="{StaticResource C.Panel2}" />
    <SolidColorBrush x:Key="Header" Color="{StaticResource C.Header}" />
    <SolidColorBrush x:Key="Border" Color="{StaticResource C.Border}" />
    <SolidColorBrush x:Key="BorderSoft" Color="{StaticResource C.BorderSoft}" />
    <SolidColorBrush x:Key="Work" Color="{StaticResource C.Work}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource C.Text}" />
    <SolidColorBrush x:Key="TextStrong" Color="{StaticResource C.TextStrong}" />
    <SolidColorBrush x:Key="Muted" Color="{StaticResource C.Muted}" />
    <SolidColorBrush x:Key="Faint" Color="{StaticResource C.Faint}" />
    <SolidColorBrush x:Key="Select" Color="{StaticResource C.Select}" />
    <SolidColorBrush x:Key="Hover" Color="{StaticResource C.Hover}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource C.Accent}" />
    <SolidColorBrush x:Key="InputBorder" Color="{StaticResource C.InputBorder}" />
    <SolidColorBrush x:Key="ButtonBg" Color="{StaticResource C.Button}" />
    <SolidColorBrush x:Key="ButtonBorder" Color="{StaticResource C.ButtonBorder}" />
    <SolidColorBrush x:Key="Presence" Color="{StaticResource C.Presence}" />
    <SolidColorBrush x:Key="Ok" Color="{StaticResource C.Ok}" />
    <SolidColorBrush x:Key="Warn" Color="{StaticResource C.Warn}" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <Style TargetType="Window" x:Key="RemoteManWindow">
        <Setter Property="Background" Value="{StaticResource Bg}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style TargetType="TextBlock" x:Key="Muted">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style TargetType="TextBlock" x:Key="PaneTitle">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Protocol tag: small outlined mono label -->
    <Style TargetType="Border" x:Key="KindTag">
        <Setter Property="BorderBrush" Value="#44474D" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="TextBlock" x:Key="KindTagText">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Buttons -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource ButtonBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource ButtonBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#33363B" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Select}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#3A4E63" />
        <Setter Property="BorderBrush" Value="#50667D" />
        <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
    </Style>
    <Style TargetType="Button" x:Key="FlatButton" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#B8BCC3" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinHeight" Value="22" />
    </Style>

    <Style TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="b" Background="Transparent" Padding="2,6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Select}" />
                            <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inputs -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Work}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource Text}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource Work}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
        <Setter Property="CaretBrush" Value="{StaticResource Text}" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Margin" Value="0,3" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="22" />
    </Style>

    <!-- Menu strip -->
    <Style TargetType="Menu">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#B8BCC3" />
    </Style>

    <!-- Tree: full-row selection, 22px rows; indentation comes from the node's Depth -->
    <Style TargetType="TreeViewItem" x:Key="EntryItem">
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <Border x:Name="row" Height="22" Background="Transparent" Padding="{Binding Indent}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </Border>
                        <ItemsPresenter x:Name="kids" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False"><Setter TargetName="kids" Property="Visibility" Value="Collapsed" /></Trigger>
                        <Trigger SourceName="row" Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="{StaticResource Hover}" /></Trigger>
                        <DataTrigger Binding="{Binding IsLinkTarget}" Value="True"><Setter TargetName="row" Property="Background" Value="#2D2B25" /></DataTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="row" Property="Background" Value="{StaticResource Select}" />
                            <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Session tabs: square, 26px, thin accent line on the active tab -->
    <Style TargetType="ListBoxItem" x:Key="SessionTab">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="tab" Height="26" Padding="10,0" Background="Transparent" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                        <Grid>
                            <Border x:Name="line" Height="1" VerticalAlignment="Top" Background="Transparent" Margin="-10,0" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="tab" Property="Background" Value="{StaticResource Work}" />
                            <Setter TargetName="line" Property="Background" Value="{StaticResource Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Text}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="{StaticResource Border}" />
    </Style>

</ResourceDictionary>
