<UserControl x:Class="Tether.App.Views.SshSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="{StaticResource Work}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="SplitCol" Width="0" />
            <ColumnDefinition x:Name="FilesCol" Width="0" MinWidth="0" />
            <ColumnDefinition Width="22" />
        </Grid.ColumnDefinitions>

        <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="#141517" />
        <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch" />

        <!-- SFTP panel: same login as the terminal -->
        <DockPanel x:Name="FilesPanel" Grid.Column="2" Background="{StaticResource Panel}" Visibility="Collapsed"
                   AllowDrop="True" Drop="OnFilesDrop" DragOver="OnFilesDragOver">
            <Border DockPanel.Dock="Top" Height="24" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                <DockPanel Margin="2,0">
                    <Button DockPanel.Dock="Left" Style="{StaticResource FlatButton}" Content="↑" ToolTip="Parent folder" AutomationProperties.Name="Parent folder" Click="OnUp" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="⟳" ToolTip="Refresh" AutomationProperties.Name="Refresh" Click="OnRefresh" />
                    <TextBox x:Name="RemotePath" FontFamily="{StaticResource MonoFont}" FontSize="11" BorderThickness="0" Background="Transparent" KeyDown="OnPathKey"
                             AutomationProperties.Name="Remote folder" />
                </DockPanel>
            </Border>
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="4">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Content="Upload…" Click="OnUpload" />
                        <Button DockPanel.Dock="Left" Content="Download" Margin="4,0,0,0" Click="OnDownload" ToolTip="Save the selection to your download folder" />
                        <Button DockPanel.Dock="Right" Content="Delete" Click="OnDelete" />
                        <Rectangle />
                    </DockPanel>
                    <TextBlock x:Name="TransferText" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="TransferBar" Height="2" Margin="0,2,0,0" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Accent}" />
                </StackPanel>
            </Border>
            <ListView x:Name="RemoteList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}" SelectionMode="Extended"
                      MouseDoubleClick="OnItemDoubleClick" KeyDown="OnListKey">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Height" Value="20" />
                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="b" Background="Transparent" Padding="6,0">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
                                            <TextBlock x:Name="icon" Text="·" Width="14" Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsDirectory}" Value="True"><Setter TargetName="icon" Property="Text" Value="▸" /></DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" /></Trigger>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Select}" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </DockPanel>

        <!-- Side strip: toggles the Files panel; also a drop target -->
        <Border Grid.Column="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0"
                AllowDrop="True" Drop="OnFilesDrop" DragOver="OnFilesDragOver">
            <ToggleButton x:Name="FilesToggle" VerticalAlignment="Top" Height="64" Background="Transparent" BorderThickness="0"
                          Foreground="{StaticResource Muted}" ToolTip="Files (SFTP, Ctrl+Shift+F)" AutomationProperties.Name="Toggle files panel"
                          Checked="OnFilesToggled" Unchecked="OnFilesToggled">
                <TextBlock Text="Files" FontSize="11">
                    <TextBlock.LayoutTransform><RotateTransform Angle="90" /></TextBlock.LayoutTransform>
                </TextBlock>
            </ToggleButton>
        </Border>
    </Grid>
</UserControl>
